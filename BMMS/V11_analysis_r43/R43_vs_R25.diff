+#define BMMS_C8P43_KERNEL(NAME,T,TA,TB) \
+__schedmode__(1) __global__ __mix__(1,2) void NAME(GM_ADDR a,GM_ADDR b,GM_ADDR y, \
+    GM_ADDR ap,GM_ADDR bp,GM_ADDR ring,GM_ADDR part,bmms_c8p43::RaggedPlan p){ \
+    bmms_c8p43::Entry<T,TA,TB>(a,b,y,ap,bp,ring,part,p); }
+BMMS_C8P43_KERNEL(bmms_c8p43_f16_nn,half,false,false)
+BMMS_C8P43_KERNEL(bmms_c8p43_f16_nt,half,false,true)
+BMMS_C8P43_KERNEL(bmms_c8p43_f16_tn,half,true,false)
+BMMS_C8P43_KERNEL(bmms_c8p43_f16_tt,half,true,true)
+BMMS_C8P43_KERNEL(bmms_c8p43_b16_nn,bfloat16_t,false,false)
+BMMS_C8P43_KERNEL(bmms_c8p43_b16_nt,bfloat16_t,false,true)
+BMMS_C8P43_KERNEL(bmms_c8p43_b16_tn,bfloat16_t,true,false)
+BMMS_C8P43_KERNEL(bmms_c8p43_b16_tt,bfloat16_t,true,true)
+#undef BMMS_C8P43_KERNEL
+
+namespace bmms_c8p43 {
+static inline bool TryLaunch(GM_ADDR a,GM_ADDR b,GM_ADDR y,int32_t B,int32_t M,
+    int32_t N,int32_t K,int32_t dtype,bool ta,bool tb,int32_t cores,aclrtStream stream){
+    if(!Eligible(B,M,N,K,dtype,cores))return false;
+    const RaggedPlan p=MakePlan(M,N,K,cores,ta,tb);
+    if(!ValidPlan(p,cores))return false;
+    uint8_t* ws=nullptr;
+    if(aclrtMalloc(reinterpret_cast<void**>(&ws),WorkspaceBytes(p),
+        ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)return false;
+    uint8_t* ap=ws;
+    uint8_t* bp=ap+ABytes(p);
+    uint8_t* ring=bp+BBytes(p);
+    uint8_t* part=ring+RingBytes(p);
+#define BMMS_C8P43_LAUNCH(NAME) NAME<<<p.cube.blocks,nullptr,stream>>>(a,b,y,ap,bp,ring,part,p)
+    if(dtype==1){
+        if(!ta&&!tb){BMMS_C8P43_LAUNCH(bmms_c8p43_f16_nn);}
+        else if(!ta&&tb){BMMS_C8P43_LAUNCH(bmms_c8p43_f16_nt);}
+        else if(ta&&!tb){BMMS_C8P43_LAUNCH(bmms_c8p43_f16_tn);}
+        else{BMMS_C8P43_LAUNCH(bmms_c8p43_f16_tt);}
+    }else{
+        if(!ta&&!tb){BMMS_C8P43_LAUNCH(bmms_c8p43_b16_nn);}
+        else if(!ta&&tb){BMMS_C8P43_LAUNCH(bmms_c8p43_b16_nt);}
+        else if(ta&&!tb){BMMS_C8P43_LAUNCH(bmms_c8p43_b16_tn);}
+        else{BMMS_C8P43_LAUNCH(bmms_c8p43_b16_tt);}
+    }
+#undef BMMS_C8P43_LAUNCH
+    // After a device launch we must not free buffers or silently fall back
+    // before completion. This is the same error/lifetime policy as R25.
+    if(aclrtSynchronizeStream(stream)!=ACL_SUCCESS)std::abort();
+    if(aclrtFree(ws)!=ACL_SUCCESS)std::abort();
+    return true;
+}
