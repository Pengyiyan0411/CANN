// INSERT_PREAMBLE_AND_PLANS
bool same(const bmms83::NativePlan&a,const bmms83::NativePlan&b){
    return a.B==b.B&&a.M==b.M&&a.N==b.N&&a.K==b.K&&a.mTiles==b.mTiles&&a.nTiles==b.nTiles&&
        a.pM==b.pM&&a.pN==b.pN&&a.tasks==b.tasks&&a.blocks==b.blocks;
}
bool better(const Work&a,const bmms83::NativePlan&pa,const Work&b,const bmms83::NativePlan&pb){
    return a.tiles<b.tiles||(a.tiles==b.tiles&&(a.cells<b.cells||(a.cells==b.cells&&
        (a.input<b.input||(a.input==b.input&&(pa.pN<pb.pN||(pa.pN==pb.pN&&pa.blocks>pb.blocks)))))));
}
bool margin(const Work&a,const Work&b){return a.tiles*8<=b.tiles*7&&a.cells*8<=b.cells*7&&a.input*8<=b.input*7;}
using Maker=bmms83::NativePlan(*)(int,int,int,int,int);
void row(const std::array<int,5>&d,const bmms83::NativePlan&a,const bmms83::NativePlan&b){
    auto wa=walk(a),wb=walk(b);
    std::cout<<"{\"shape\":["<<d[0]<<","<<d[1]<<","<<d[2]<<","<<d[3]<<"],\"cores\":"<<d[4]
        <<",\"old_grid\":["<<a.pM<<","<<a.pN<<"],\"new_grid\":["<<b.pM<<","<<b.pN
        <<"],\"old_tasks\":"<<a.tasks<<",\"new_tasks\":"<<b.tasks
        <<",\"old_blocks\":"<<a.blocks<<",\"new_blocks\":"<<b.blocks
        <<",\"old_peak_tiles\":"<<wa.tiles<<",\"new_peak_tiles\":"<<wb.tiles
        <<",\"old_peak_cells\":"<<wa.cells<<",\"new_peak_cells\":"<<wb.cells
        <<",\"old_peak_input_units\":"<<wa.input<<",\"new_peak_input_units\":"<<wb.input<<"}";
}
int main(){try{
    int count=0,changed[2]={0,0},oracles=0;
    Maker funcs[2]={r13::MakePlan,r14::MakePlan};
    std::vector<std::array<int,5>> examples[2];
    for(int B:{1,3,8,24,64})for(int mt:{1,2,3,7,9,16,32,63,64})for(int nt:{1,2,3,7,19,32})
    for(int K:{256,4096})for(int cores:{1,2,3,5,6,7,8,20,32,64})for(int tail:{0,16,112}){
        int M=mt*128-tail,N=nt*256-(tail==112?240:tail);
        if(int64_t(B)*M*K>(1LL<<26)||int64_t(B)*N*K>(1LL<<26)||!baseline::Eligible(B,M,N,K,cores))continue;
        auto old=baseline::MakePlan(B,M,N,K,cores);auto a=walk(old);int altered=0;
        for(int v=0;v<2;++v){
            auto p=funcs[v](B,M,N,K,cores);
            const bool gate=cores>=2&&cores<=64&&B<=cores&&old.blocks==cores&&(v==0?old.tasks>cores:old.tasks==cores);
            need(p.tasks==B*p.pM*p.pN&&p.blocks==std::min(cores,p.tasks),"inconsistent launch/tasks");
            need(p.mTiles==old.mTiles&&p.nTiles==old.nTiles,"changed tile domain");
            if(!gate)need(same(p,old),"changed outside experiment regime");
            auto b=walk(p);auto pred=r13::ExistingPeak(p);
            need(pred.tiles==b.tiles&&pred.cells==b.cells&&pred.input==b.input,"cost disagrees with traversal");
            if(p.tasks==p.blocks){auto closed=r13::SingleWavePeak(p);
                need(closed.tiles==b.tiles&&closed.cells==b.cells&&closed.input==b.input,"closed form mismatch");}
            need(a.totalTiles==b.totalTiles&&a.totalCells==b.totalCells&&a.totalInput==b.totalInput,"extra global work");
            if(!same(p,old)){
                need(gate&&p.tasks==p.blocks&&p.blocks<cores&&4*p.blocks>=3*cores,"invalid reduced-core plan");
                need(margin(b,a),"insufficient change margin");++changed[v];++altered;
                if(examples[v].size()<6&&K==256&&tail==0)examples[v].push_back({B,M,N,K,cores});
            }
            if(gate&&count%97==0){
                // Independent bounded brute force: actual per-macro traversal, no cost formula.
                auto best=old;auto bestWork=a;
                for(int pm=1;pm<=old.mTiles;++pm)for(int pn=1;pn<=old.nTiles;++pn){
                    int tasks=B*pm*pn;if(tasks>=cores||4*tasks<3*cores)continue;
                    auto q=old;q.pM=pm;q.pN=pn;q.tasks=tasks;q.blocks=tasks;auto w=walk(q);
                    if(margin(w,a)&&better(w,q,bestWork,best)){best=q;bestWork=w;}
                }
                need(same(best,p),"planner differs from independent exhaustive oracle");++oracles;
            }
        }
        need(altered<=1,"experiments overlap");++count;
    }
    int budget=0,guards=0;
    for(int cores=1;cores<=64;++cores)for(int B=1;B<=64;++B){
        int pairs=0;
        for(int pm=1;pm<=64;++pm)for(int pn=1;pn<=32;++pn){int tasks=B*pm*pn;if(tasks<cores&&4*tasks>=3*cores)++pairs;}
        budget=std::max(budget,pairs);
    }
    for(int c:{0,-1,65,128})for(int B:{1,3,64})for(int v=0;v<2;++v){
        need(same(baseline::MakePlan(B,1024,2048,256,c),funcs[v](B,1024,2048,256,c)),"out-of-scope cores changed");++guards;
    }
    std::cout<<"{\"checked_shapes\":"<<count<<",\"independent_oracles\":"<<oracles
        <<",\"core_guard_checks\":"<<guards<<",\"max_candidate_pairs\":"<<budget
        <<",\"changed\":{\"R13\":"<<changed[0]<<",\"R14\":"<<changed[1]<<"},\"examples\":{";
    for(int v=0;v<2;++v){if(v)std::cout<<",";std::cout<<(v?"\"R14\":[":"\"R13\":[");bool first=true;
        for(auto d:examples[v]){if(!first)std::cout<<",";first=false;
            auto[B,M,N,K,c]=d;row(d,baseline::MakePlan(B,M,N,K,c),funcs[v](B,M,N,K,c));}
        std::cout<<"]";
    }
    std::cout<<"},\"regression_examples\":[";bool first=true;
    for(auto d:std::vector<std::array<int,5>>{{1,512,768,256,6},{1,1024,1024,256,20},
        {1,4096,4096,256,20},{8,4096,4096,256,20},{1,1152,4864,256,20}}){
        if(!first)std::cout<<",";first=false;auto[B,M,N,K,c]=d;
        std::cout<<"{\"R13\":";row(d,baseline::MakePlan(B,M,N,K,c),r13::MakePlan(B,M,N,K,c));
        std::cout<<",\"R14\":";row(d,baseline::MakePlan(B,M,N,K,c),r14::MakePlan(B,M,N,K,c));std::cout<<"}";
    }
    std::cout<<"]}\n";return 0;
}catch(const std::exception&e){std::cerr<<e.what();return 1;}}
