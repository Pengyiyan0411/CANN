+        b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z),int64_t(p.B)*p.K*p.N);
+        ring.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(r),int64_t(p.blocks)*2*TM*TN);
+        pipe->InitBuffer(a1Buf,2*TM*KB*sizeof(T));pipe->InitBuffer(b1Buf,2*KB*TN*sizeof(T));
+        pipe->InitBuffer(a2Buf,2*TM*KB*sizeof(T));pipe->InitBuffer(b2Buf,2*KB*TN*sizeof(T));
+        pipe->InitBuffer(cBuf,TM*TN*sizeof(float));
+    }
+
+    __aicore__ inline void Process(){
+        const int group=AscendC::GetBlockIdx(),perBatch=p.pM*p.pN;
+        for(int task=group;task<p.tasks;task+=p.blocks){
+            const int batch=task/perBatch,slot=task-batch*perBatch;
+            const int ms=slot/p.pN,ns=slot-ms*p.pN;
+            const int mt0=ms*p.mTiles/p.pM,mt1=(ms+1)*p.mTiles/p.pM;
+            const int nt0=ns*p.nTiles/p.pN,nt1=(ns+1)*p.nTiles/p.pN;
+            const int mBegin=mt0*TM,mEnd=bmms83::MinI(mt1*TM,p.M);
