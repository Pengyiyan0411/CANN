+    }else{
+        if(!ta&&!tb){BMMS11D_LAUNCH(bmms11d_b16_nn);}
+        else if(!ta&&tb){BMMS11D_LAUNCH(bmms11d_b16_nt);}
+        else if(ta&&!tb){BMMS11D_LAUNCH(bmms11d_b16_tn);}
+        else{BMMS11D_LAUNCH(bmms11d_b16_tt);}
+    }
+#undef BMMS11D_LAUNCH
+    if(aclrtSynchronizeStream(stream)!=ACL_SUCCESS)std::abort();
+    if(aclrtFree(ws)!=ACL_SUCCESS)std::abort();
+    return true;
+}
