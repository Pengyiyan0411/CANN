+// Host-only grid search. Device arithmetic and tile ownership rules are unchanged.
+struct GridPeak { uint64_t tiles=0,cells=0,input=0; };
+static inline GridPeak PeakForGrid(const Plan& p){
+    uint64_t tiles[64]={},cells[64]={},input[64]={};
+    const int perBatch=p.pM*p.pN;
+    for(int task=0;task<p.tasks;++task){
+        const int slot=task%perBatch,ms=slot/p.pN,ns=slot%p.pN;
+        const int mt0=ms*p.mTiles/p.pM,mt1=(ms+1)*p.mTiles/p.pM;
+        const int nt0=ns*p.nTiles/p.pN,nt1=(ns+1)*p.nTiles/p.pN;
+        const int mr=bmms83::MinH(mt1*AM,p.M)-mt0*AM;
+        const int nr=bmms83::MinH(nt1*BN,p.N)-nt0*BN;
+        const int group=task%p.blocks;
+        tiles[group]+=uint64_t(mt1-mt0)*(nt1-nt0);
+        cells[group]+=uint64_t(mr)*nr;
+        input[group]+=uint64_t(mr)*(nt1-nt0)+uint64_t(nr)*(mt1-mt0);
+    }
+    GridPeak peak{};
+    for(int g=0;g<p.blocks;++g){
+        if(tiles[g]>peak.tiles)peak.tiles=tiles[g];
+        if(cells[g]>peak.cells)peak.cells=cells[g];
+        if(input[g]>peak.input)peak.input=input[g];
+    }
+    return peak;
+}
