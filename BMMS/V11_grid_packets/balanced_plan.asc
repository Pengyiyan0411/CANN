// Host-only grid search. Device arithmetic and tile ownership rules are unchanged.
struct GridPeak { uint64_t tiles=0,cells=0,input=0; };
static inline GridPeak PeakForGrid(const Plan& p){
    uint64_t tiles[64]={},cells[64]={},input[64]={};
    const int perBatch=p.pM*p.pN;
    for(int task=0;task<p.tasks;++task){
        const int slot=task%perBatch,ms=slot/p.pN,ns=slot%p.pN;
        const int mt0=ms*p.mTiles/p.pM,mt1=(ms+1)*p.mTiles/p.pM;
        const int nt0=ns*p.nTiles/p.pN,nt1=(ns+1)*p.nTiles/p.pN;
        const int mr=bmms83::MinH(mt1*AM,p.M)-mt0*AM;
        const int nr=bmms83::MinH(nt1*BN,p.N)-nt0*BN;
        const int group=task%p.blocks;
        tiles[group]+=uint64_t(mt1-mt0)*(nt1-nt0);
        cells[group]+=uint64_t(mr)*nr;
        input[group]+=uint64_t(mr)*(nt1-nt0)+uint64_t(nr)*(mt1-mt0);
    }
    GridPeak peak{};
    for(int g=0;g<p.blocks;++g){
        if(tiles[g]>peak.tiles)peak.tiles=tiles[g];
        if(cells[g]>peak.cells)peak.cells=cells[g];
        if(input[g]>peak.input)peak.input=input[g];
    }
    return peak;
}
static inline Plan MakePlan(int32_t B,int32_t M,int32_t N,int32_t K,int32_t cores){
    Plan initial{};initial.B=B;initial.M=M;initial.N=N;initial.K=K;
    initial.mTiles=bmms83::UpH(M,AM);initial.nTiles=bmms83::UpH(N,BN);
    cores=bmms83::MaxH(1,cores);
    initial.pM=bmms83::MinH(initial.mTiles,bmms83::MaxH(1,bmms83::UpH(cores,B)));
    initial.pN=bmms83::MinH(initial.nTiles,bmms83::MaxH(1,bmms83::UpH(cores,B*initial.pM)));
    initial.tasks=B*initial.pM*initial.pN;initial.blocks=bmms83::MinH(cores,initial.tasks);
    if(cores>64||initial.blocks<cores)return initial;
    const GridPeak baseline=PeakForGrid(initial);
    Plan best=initial;double bestRank=1.0;
    const int cap=bmms83::MaxH(B,4*cores);
    for(int pm=1;pm<=bmms83::MinH(initial.mTiles,cores);++pm){
        for(int pn=1;pn<=bmms83::MinH(initial.nTiles,cores);++pn){
            const int tasks=B*pm*pn;
            if(tasks>cap)break;
            if(tasks<cores)continue;
            Plan candidate=initial;candidate.pM=pm;candidate.pN=pn;
            candidate.tasks=tasks;candidate.blocks=cores;
            const GridPeak peak=PeakForGrid(candidate);
            // Require >=12.5% less peak work in ALL three structural measures.
            // This is an admission margin, not an estimated timing/noise bound.
            if(8*peak.tiles>7*baseline.tiles||8*peak.cells>7*baseline.cells||
               8*peak.input>7*baseline.input)continue;
            double rank=double(peak.tiles)/baseline.tiles;
            const double rCells=double(peak.cells)/baseline.cells,rInput=double(peak.input)/baseline.input;
            if(rCells>rank)rank=rCells;if(rInput>rank)rank=rInput;
            if(rank<bestRank-1e-12||(rank<=bestRank+1e-12&&
                (pn<best.pN||(pn==best.pN&&tasks<best.tasks)))){
                best=candidate;bestRank=rank;
            }
        }
    }
    return best;
}

