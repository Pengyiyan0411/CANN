#include <algorithm>
#include <array>
#include <cstdint>
#include <iostream>
#include <stdexcept>
#include <vector>
namespace bmms83 {
inline int UpH(int a,int b){return (a+b-1)/b;}
inline int MinH(int a,int b){return std::min(a,b);}
inline int MaxH(int a,int b){return std::max(a,b);}
inline int MinI(int a,int b){return std::min(a,b);}
struct NativePlan {int B,M,N,K,mTiles,nTiles,pM,pN,tasks,blocks;};
}
// INSERT_PLANS
void need(bool v,const char* msg){if(!v)throw std::runtime_error(msg);}
struct Work {
    uint64_t tiles=0,cells=0,input=0,totalTiles=0,totalCells=0,totalInput=0;
};
Work walk(const bmms83::NativePlan& p){
    Work result{};std::vector<uint8_t> seen(p.B*p.mTiles*p.nTiles);
    for(int g=0;g<p.blocks;++g){
        uint64_t tiles=0,cells=0,input=0;
        for(int task=g;task<p.tasks;task+=p.blocks){
            int b=task/(p.pM*p.pN),slot=task%(p.pM*p.pN),ms=slot/p.pN,ns=slot%p.pN;
            int ml=ms*p.mTiles/p.pM,mh=(ms+1)*p.mTiles/p.pM;
            int nl=ns*p.nTiles/p.pN,nh=(ns+1)*p.nTiles/p.pN;
            need(ml<mh&&nl<nh&&b<p.B,"empty/invalid shard");
            for(int m=ml;m<mh;++m)for(int n=nl;n<nh;++n){
                auto& v=seen[(b*p.mTiles+m)*p.nTiles+n];need(v++==0,"duplicate macro owner");
                const int ar=std::min(128,p.M-m*128),br=std::min(256,p.N-n*256);
                ++tiles;cells+=uint64_t(ar)*br;input+=ar+br;
            }
        }
        need(tiles>0,"idle launched group");
        result.tiles=std::max(result.tiles,tiles);result.cells=std::max(result.cells,cells);
        result.input=std::max(result.input,input);
        result.totalTiles+=tiles;result.totalCells+=cells;result.totalInput+=input;
    }
    need(std::all_of(seen.begin(),seen.end(),[](auto v){return v==1;}),"unowned macro");
    need(result.totalCells==uint64_t(p.B)*p.M*p.N,"cell coverage");return result;
}
int main(){try{
    int count=0,changed=0;
    for(int B:{1,3,8,24,64})for(int mt:{1,2,3,8,16,32,64})for(int nt:{1,2,3,8,16,32})
    for(int K:{256,4096})for(int cores:{1,2,3,8,20,32,64})for(int tail:{0,16}){
        int M=mt*128-(tail?112:0),N=nt*256-(tail?240:0);
        if(!baseline::Eligible(B,M,N,K,cores))continue;
        auto old=baseline::MakePlan(B,M,N,K,cores),p=candidate::MakePlan(B,M,N,K,cores);
        need(p.blocks==cores&&p.tasks==B*p.pM*p.pN,"wrong task/core count");
        auto a=walk(old),b=walk(p);auto pred=candidate::PeakForGrid(p);
        need(pred.tiles==b.tiles&&pred.cells==b.cells&&pred.input==b.input,"cost disagrees with device traversal");
        need(a.totalTiles==b.totalTiles&&a.totalCells==b.totalCells&&a.totalInput==b.totalInput,"extra global work");
        if(old.pM!=p.pM||old.pN!=p.pN){
            need(b.tiles*8<=a.tiles*7&&b.cells*8<=a.cells*7&&b.input*8<=a.input*7,"insufficient change margin");++changed;
        }
        ++count;
    }
    std::cout<<"{\"checked\":"<<count<<",\"changed\":"<<changed<<",\"examples\":[";
    bool first=true;
    for(auto dims:std::vector<std::array<int,5>>{{1,384,768,256,5},{1,1024,1024,256,20},
        {1,4096,4096,256,20},{8,4096,4096,256,20},{24,1024,1024,256,20},
        {3,144,528,256,4},{1,128,256,256,1}}){
        auto[B,M,N,K,c]=dims;auto a=baseline::MakePlan(B,M,N,K,c),b=candidate::MakePlan(B,M,N,K,c);
        auto wa=walk(a),wb=walk(b);if(!first)std::cout<<",";first=false;
        std::cout<<"{\"shape\":["<<B<<","<<M<<","<<N<<","<<K<<"],\"cores\":"<<c
            <<",\"old_grid\":["<<a.pM<<","<<a.pN<<"],\"new_grid\":["<<b.pM<<","<<b.pN
            <<"],\"old_peak_tiles\":"<<wa.tiles<<",\"new_peak_tiles\":"<<wb.tiles
            <<",\"old_peak_cells\":"<<wa.cells<<",\"new_peak_cells\":"<<wb.cells
            <<",\"old_peak_input_units\":"<<wa.input<<",\"new_peak_input_units\":"<<wb.input<<"}";
    }
    std::cout<<"]}\n";return 0;
}catch(const std::exception&e){std::cerr<<e.what();return 1;}}
