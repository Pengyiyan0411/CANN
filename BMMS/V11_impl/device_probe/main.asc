// OFFLINE TEST EXECUTABLE ONLY. Never place this in the Judge submission.
// Input/golden generation and copies belong to the test harness, not the kernel.
#include <cstdint>
#include <cstdlib>
#include <cstdio>
#include <cstring>
#include <vector>
#include <fstream>
#include <stdexcept>
#include <chrono>
#include <string>
#include "acl/acl.h"
struct TensorInfo {int numDims;int dtype;int64_t shape[8];};
struct TensorGroupInfo {int numTensors;TensorInfo tensors[1];};
#include "kernel_under_test.asc"

static void check(aclError e,const char*where){if(e!=ACL_SUCCESS){
    throw std::runtime_error(std::string(where)+" failed, aclError="+std::to_string(e));}}
static std::vector<uint8_t> load(const char*path,size_t n){
    std::ifstream f(path,std::ios::binary|std::ios::ate);
    if(!f||static_cast<size_t>(f.tellg())!=n)throw std::runtime_error(std::string("bad input size: ")+path);
    std::vector<uint8_t> x(n);f.seekg(0);f.read(reinterpret_cast<char*>(x.data()),n);
    if(!f)throw std::runtime_error("input read failed");return x;
}
int main(int argc,char**argv){
    if(argc!=13){std::fprintf(stderr,"Usage: bench B M N K dtype(1=f16,2=bf16) ta tb cores repeats a.bin b.bin all_y.bin\n");return 2;}
    void *a=nullptr,*b=nullptr,*y=nullptr;aclrtStream stream=nullptr;
    bool initialized=false,deviceSet=false;
    int device=0;const char*env=std::getenv("ASCEND_DEVICE_ID");if(env)device=std::atoi(env);
    try{
        int64_t dims[4];for(int i=0;i<4;++i)dims[i]=std::stoll(argv[i+1]);
        const int64_t B=dims[0],M=dims[1],N=dims[2],K=dims[3];
        int dt=std::stoi(argv[5]),ta=std::stoi(argv[6]),tb=std::stoi(argv[7]);
        int cores=std::stoi(argv[8]),reps=std::stoi(argv[9]);
        if(B<1||B>64||M<1||M>8192||N<1||N>8192||K<32||K>8192||K%8||
           B*M*K>(1LL<<26)||B*N*K>(1LL<<26)||dt<1||dt>2||ta<0||ta>1||tb<0||tb>1||
           cores<1||cores>64||reps<1||reps>1000)throw std::runtime_error("invalid test arguments");
        auto ha=load(argv[10],size_t(B*M*K*2));auto hb=load(argv[11],size_t(B*N*K*2));
        std::vector<float> all(size_t(B)*reps);std::vector<uint32_t> sentinel(B,0x7fc00001u);
        TensorGroupInfo ia{},ib{},iy{};ia.numTensors=ib.numTensors=iy.numTensors=1;
        ia.tensors[0]={3,dt,{B,ta?K:M,ta?M:K}};
        ib.tensors[0]={3,dt,{B,tb?N:K,tb?K:N}};iy.tensors[0]={1,0,{B}};
        check(aclInit(nullptr),"aclInit");initialized=true;
        check(aclrtSetDevice(device),"aclrtSetDevice");deviceSet=true;
        check(aclrtCreateStream(&stream),"create stream");
        check(aclrtMalloc(&a,ha.size(),ACL_MEM_MALLOC_HUGE_FIRST),"alloc a");
        check(aclrtMalloc(&b,hb.size(),ACL_MEM_MALLOC_HUGE_FIRST),"alloc b");
        check(aclrtMalloc(&y,B*4,ACL_MEM_MALLOC_HUGE_FIRST),"alloc y");
        check(aclrtMemcpy(a,ha.size(),ha.data(),ha.size(),ACL_MEMCPY_HOST_TO_DEVICE),"copy a");
        check(aclrtMemcpy(b,hb.size(),hb.data(),hb.size(),ACL_MEMCPY_HOST_TO_DEVICE),"copy b");
        // One warmup is excluded from host timing, but remains visible to msprof.
        run_kernel((GM_ADDR)a,ia,(GM_ADDR)b,ib,(GM_ADDR)y,iy,cores,stream,ta,tb);
        check(aclrtSynchronizeStream(stream),"warmup sync");
        double wall=0;
        for(int i=0;i<reps;++i){
            // Refill output with NaNs to catch unwritten results. This is a COPY,
            // outside run_kernel, not a preparation device kernel in the submission.
            check(aclrtMemcpy(y,B*4,sentinel.data(),B*4,ACL_MEMCPY_HOST_TO_DEVICE),"output sentinel");
            auto start=std::chrono::steady_clock::now();
            run_kernel((GM_ADDR)a,ia,(GM_ADDR)b,ib,(GM_ADDR)y,iy,cores,stream,ta,tb);
            check(aclrtSynchronizeStream(stream),"run sync");
            wall+=std::chrono::duration<double,std::micro>(std::chrono::steady_clock::now()-start).count();
            check(aclrtMemcpy(all.data()+i*B,B*4,y,B*4,ACL_MEMCPY_DEVICE_TO_HOST),"read output");
        }
        std::ofstream f(argv[12],std::ios::binary);f.write((const char*)all.data(),all.size()*4);
        if(!f)throw std::runtime_error("output write failed");
        // This number includes host tiling/alloc/free/synchronization. It is NOT
        // Judge Task Duration. Use the actual kernel tasks in msprof for A/B.
        std::printf("{\"host_call_mean_us\":%.6f,\"repeats\":%d,\"not_kernel_task_duration\":true}\n",wall/reps,reps);
        check(aclrtFree(y),"free y");y=nullptr;check(aclrtFree(b),"free b");b=nullptr;
        check(aclrtFree(a),"free a");a=nullptr;check(aclrtDestroyStream(stream),"destroy stream");stream=nullptr;
        check(aclrtResetDevice(device),"reset device");deviceSet=false;
        check(aclFinalize(),"aclFinalize");initialized=false;return 0;
    }catch(const std::exception&e){
        std::fprintf(stderr,"DEVICE_TEST_ERROR: %s\n",e.what());
        if(stream)aclrtSynchronizeStream(stream);
        if(y)aclrtFree(y);if(b)aclrtFree(b);if(a)aclrtFree(a);
        if(stream)aclrtDestroyStream(stream);if(deviceSet)aclrtResetDevice(device);if(initialized)aclFinalize();
        return 1;
    }
}
