// V11 R01: real 2x2 operand reuse, K1=256 / K0=64.
// Experimental source: CANN compilation, precision and performance need a device.
#ifndef BMMS11_REUSE_FRAGMENT_INCLUDED
#define BMMS11_REUSE_FRAGMENT_INCLUDED
namespace bmms11 {
constexpr int32_t TM=64,TN=128,AM=128,BN=256,K1=256,K0=64;
constexpr uint16_t READY=4,FREE=6;
using Plan=bmms83::NativePlan;
using bmms83::MinI;
static inline bool Eligible(int32_t B,int32_t M,int32_t N,int32_t K,int32_t cores){
    return B>=1&&B<=64&&cores>=1&&cores<=64&&M>=AM&&M<=8192&&N>=BN&&N<=8192&&
        K>=K1&&K<=8192&&M%16==0&&N%16==0&&K%32==0&&
        int64_t(B)*M*K<=(1LL<<26)&&int64_t(B)*N*K<=(1LL<<26)&&
        int64_t(B)*bmms83::UpH(M,AM)*bmms83::UpH(N,BN)>=cores;
}
static inline Plan MakePlan(int32_t B,int32_t M,int32_t N,int32_t K,int32_t cores){
    Plan p{};p.B=B;p.M=M;p.N=N;p.K=K;
    p.mTiles=bmms83::UpH(M,AM);p.nTiles=bmms83::UpH(N,BN);
    cores=bmms83::MaxH(1,cores);
    p.pM=bmms83::MinH(p.mTiles,bmms83::MaxH(1,bmms83::UpH(cores,B)));
    p.pN=bmms83::MinH(p.nTiles,bmms83::MaxH(1,bmms83::UpH(cores,B*p.pM)));
    p.tasks=B*p.pM*p.pN;p.blocks=bmms83::MinH(cores,p.tasks);
    return p;
}
static inline uint64_t RingBytes(const Plan& p){return uint64_t(p.blocks)*2*TM*TN*4ULL;}
static inline uint64_t PartialBytes(const Plan& p){return uint64_t(p.B)*p.pN*p.M*4ULL;}
static inline uint64_t WorkspaceBytes(const Plan& p){return RingBytes(p)+PartialBytes(p);}

template<class T,bool TA,bool TB>
class ReuseProducer {
    AscendC::TPipe* pipe_;Plan p;
    AscendC::GlobalTensor<T> a,b;
    AscendC::GlobalTensor<float> ring;
    AscendC::TBuf<AscendC::TPosition::A1> a1Buf;
    AscendC::TBuf<AscendC::TPosition::B1> b1Buf;
    AscendC::TBuf<AscendC::TPosition::A2> a2Buf;
    AscendC::TBuf<AscendC::TPosition::B2> b2Buf;
    AscendC::TBuf<AscendC::TPosition::CO1> cBuf;
    AscendC::TEventID l1Ready[2],l1Free[2],l0Ready[2],l0Free[2],cReady,cFree;
    int32_t seq=0;bool cPending=false;

    __aicore__ inline void LoadStage(int batch,int m0,int n0,int ar,int br,int k0,int kr,int s){
        auto aa=a1Buf.template Get<T>()[s*AM*K1];
        auto bb=b1Buf.template Get<T>()[s*K1*BN];
        AscendC::Nd2NzParams qa{};qa.ndNum=1;
        qa.nValue=TA?kr:ar;qa.dValue=TA?ar:kr;
        qa.srcDValue=TA?p.M:p.K;qa.dstNzC0Stride=TA?kr:ar;qa.dstNzNStride=1;
        const int64_t ai=int64_t(batch)*p.M*p.K+(TA?int64_t(k0)*p.M+m0:int64_t(m0)*p.K+k0);
        AscendC::DataCopy(aa,a[ai],qa);
        AscendC::Nd2NzParams qb{};qb.ndNum=1;
        qb.nValue=TB?br:kr;qb.dValue=TB?kr:br;
        qb.srcDValue=TB?p.K:p.N;qb.dstNzC0Stride=TB?br:kr;qb.dstNzNStride=1;
        const int64_t bi=int64_t(batch)*p.K*p.N+(TB?int64_t(n0)*p.K+k0:int64_t(k0)*p.N+n0);
        AscendC::DataCopy(bb,b[bi],qb);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1Ready[s]);
    }

    __aicore__ inline void LoadL0(int ar,int br,int kr1,int kk,int kr0,int s1,int s0){
        auto sa=a1Buf.template Get<T>()[s1*AM*K1];
        auto sb=b1Buf.template Get<T>()[s1*K1*BN];
        auto da=a2Buf.template Get<T>()[s0*AM*K0];
        auto db=b2Buf.template Get<T>()[s0*K0*BN];
        AscendC::LoadData2DParams la{};la.repeatTimes=kr0/16;
        la.srcStride=TA?1:ar/16;la.ifTranspose=TA;
        for(int mo=0;mo<ar;mo+=TM){
            const int mr=MinI(TM,ar-mo);
            for(int i=0;i<mr/16;++i){
                const int off=TA?(mo/16+i)*kr1*16+kk*16:(kk/16)*ar*16+(mo+i*16)*16;
                AscendC::LoadData(da[(mo/TM)*TM*K0+i*kr0*16],sa[off],la);
            }
        }
        AscendC::LoadData2DParams lb{};lb.repeatTimes=MinI(TN,br)/16;
        lb.srcStride=TB?1:kr1/16;lb.ifTranspose=!TB;
        for(int no=0;no<br;no+=TN){
            const int nr=MinI(TN,br-no);lb.repeatTimes=nr/16;
            for(int j=0;j<kr0/16;++j){
                const int off=TB?(kk/16+j)*br*16+no*16:(no/16)*kr1*16+(kk+j*16)*16;
                AscendC::LoadData(db[(no/TN)*K0*TN+j*nr*16],sb[off],lb);
            }
        }
        AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(l0Ready[s0]);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(l0Ready[s0]);
    }

    __aicore__ inline void Macro(int group,int batch,int m0,int n0,int ar,int br){
        const int kCount=(p.K+K1-1)/K1;
        int l0Count=0;
        LoadStage(batch,m0,n0,ar,br,0,MinI(K1,p.K),0);
        for(int ki=0;ki<kCount;++ki){
            const int s1=ki&1,kBase=ki*K1,kr1=MinI(K1,p.K-kBase);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1Ready[s1]);
            if(ki+1<kCount){
                const int next=s1^1,nextK=(ki+1)*K1;
                if(ki>=1)AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1Free[next]);
                LoadStage(batch,m0,n0,ar,br,nextK,MinI(K1,p.K-nextK),next);
            }
            for(int kk=0;kk<kr1;kk+=K0){
                const int s0=l0Count&1,kr0=MinI(K0,kr1-kk);
                if(l0Count>=2)AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0Free[s0]);
                LoadL0(ar,br,kr1,kk,kr0,s1,s0);
                // Free L1 only after the last K0 slice has read BOTH shared operands.
                if(kk+kr0==kr1)AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1Free[s1]);
                if(cPending){AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree);cPending=false;}
                auto aa=a2Buf.template Get<T>()[s0*AM*K0];
                auto bb=b2Buf.template Get<T>()[s0*K0*BN];
                for(int mo=0;mo<ar;mo+=TM){
                    const int mr=MinI(TM,ar-mo);
                    for(int no=0;no<br;no+=TN){
                        const int nr=MinI(TN,br-no),ci=(mo/TM)*2+no/TN;
                        auto cc=cBuf.template Get<float>()[ci*TM*TN];
                        AscendC::MmadParams q{};q.m=mr;q.n=nr;q.k=kr0;q.cmatrixInitVal=(l0Count==0);
                        AscendC::Mmad(cc,aa[(mo/TM)*TM*K0],bb[(no/TN)*K0*TN],q);
                        if((mr/16)*(nr/16)<10)AscendC::PipeBarrier<PIPE_M>();
                    }
                }
                // Reused A/B stay owned by M until all four output MMADs complete.
                AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0Free[s0]);++l0Count;
            }
        }
        for(int s=0;s<MinI(2,kCount);++s)AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1Free[s]);
        for(int s=0;s<MinI(2,l0Count);++s)AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0Free[s]);
        AscendC::SetFlag<AscendC::HardEvent::M_FIX>(cReady);
        AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(cReady);
        for(int mo=0;mo<ar;mo+=TM){
            const int mr=MinI(TM,ar-mo);
            for(int no=0;no<br;no+=TN){
                const int nr=MinI(TN,br-no),ci=(mo/TM)*2+no/TN,slot=seq&1;
                if(seq>=2)AscendC::CrossCoreWaitFlag<0x2>(FREE+slot);
                AscendC::FixpipeParamsV220 f{};f.nSize=nr;f.mSize=mr;f.srcStride=mr;
                f.dstStride=TN;f.ndNum=1;f.quantPre=QuantMode_t::NoQuant;
                AscendC::Fixpipe<float,float>(ring[(int64_t(group)*2+slot)*TM*TN],cBuf.template Get<float>()[ci*TM*TN],f);
                AscendC::CrossCoreSetFlag<0x2,PIPE_FIX>(READY+slot);++seq;
            }
        }
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree);cPending=true;
    }
public:
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR z,GM_ADDR r,const Plan& plan,AscendC::TPipe* pipe){
        p=plan;pipe_=pipe;
        for(int s=0;s<2;++s){
            l1Ready[s]=pipe->AllocEventID<AscendC::HardEvent::MTE2_MTE1>();
            l1Free[s]=pipe->AllocEventID<AscendC::HardEvent::MTE1_MTE2>();
            l0Ready[s]=pipe->AllocEventID<AscendC::HardEvent::MTE1_M>();
            l0Free[s]=pipe->AllocEventID<AscendC::HardEvent::M_MTE1>();
        }
        cReady=pipe->AllocEventID<AscendC::HardEvent::M_FIX>();cFree=pipe->AllocEventID<AscendC::HardEvent::FIX_M>();
        a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x),int64_t(p.B)*p.M*p.K);
        b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z),int64_t(p.B)*p.K*p.N);
        ring.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(r),int64_t(p.blocks)*2*TM*TN);
        pipe->InitBuffer(a1Buf,2*AM*K1*sizeof(T));pipe->InitBuffer(b1Buf,2*K1*BN*sizeof(T));
        pipe->InitBuffer(a2Buf,2*AM*K0*sizeof(T));pipe->InitBuffer(b2Buf,2*K0*BN*sizeof(T));
        pipe->InitBuffer(cBuf,4*TM*TN*sizeof(float));
    }
    __aicore__ inline void Process(){
        const int group=AscendC::GetBlockIdx(),perBatch=p.pM*p.pN;
        for(int task=group;task<p.tasks;task+=p.blocks){
            const int batch=task/perBatch,slot=task-batch*perBatch,ms=slot/p.pN,ns=slot-ms*p.pN;
            const int mt0=ms*p.mTiles/p.pM,mt1=(ms+1)*p.mTiles/p.pM;
            const int nt0=ns*p.nTiles/p.pN,nt1=(ns+1)*p.nTiles/p.pN;
            const int mBegin=mt0*AM,mEnd=MinI(mt1*AM,p.M),nBegin=nt0*BN,nEnd=MinI(nt1*BN,p.N);
            for(int m0=mBegin;m0<mEnd;m0+=AM)for(int n0=nBegin;n0<nEnd;n0+=BN)
                Macro(group,batch,m0,n0,MinI(AM,mEnd-m0),MinI(BN,nEnd-n0));
        }
        for(int s=0;s<MinI(2,seq);++s)AscendC::CrossCoreWaitFlag<0x2>(FREE+s);
        if(cPending)AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree);
        for(int s=0;s<2;++s){
            pipe_->ReleaseEventID<AscendC::HardEvent::MTE2_MTE1>(l1Ready[s]);
            pipe_->ReleaseEventID<AscendC::HardEvent::MTE1_MTE2>(l1Free[s]);
            pipe_->ReleaseEventID<AscendC::HardEvent::MTE1_M>(l0Ready[s]);
            pipe_->ReleaseEventID<AscendC::HardEvent::M_MTE1>(l0Free[s]);
        }
        pipe_->ReleaseEventID<AscendC::HardEvent::M_FIX>(cReady);pipe_->ReleaseEventID<AscendC::HardEvent::FIX_M>(cFree);
    }
};

// @ROW_MAX_CONSUMER@

#ifndef BMMS11_CPU_TEST
template<class T,bool TA,bool TB>
__aicore__ inline void Entry(GM_ADDR a,GM_ADDR b,GM_ADDR y,GM_ADDR ring,GM_ADDR partial,Plan p){
    AscendC::TPipe pipe;
    if ASCEND_IS_AIC {ReuseProducer<T,TA,TB> op;op.Init(a,b,ring,p,&pipe);op.Process();}
    if ASCEND_IS_AIV {RowMaxConsumer op;op.Init(ring,partial,y,p,&pipe);op.Process();}
}
#endif
} // namespace bmms11
// BMMS11_CPU_EXTRACT_END

#define BMMS11_KERNEL(NAME,T,TA,TB) \
__schedmode__(1) __global__ __mix__(1,2) void NAME(GM_ADDR a,GM_ADDR b,GM_ADDR y,GM_ADDR ring,GM_ADDR part,bmms11::Plan p){bmms11::Entry<T,TA,TB>(a,b,y,ring,part,p);}
BMMS11_KERNEL(bmms11_f16_nn,half,false,false)
BMMS11_KERNEL(bmms11_f16_nt,half,false,true)
BMMS11_KERNEL(bmms11_f16_tn,half,true,false)
BMMS11_KERNEL(bmms11_f16_tt,half,true,true)
BMMS11_KERNEL(bmms11_b16_nn,bfloat16_t,false,false)
BMMS11_KERNEL(bmms11_b16_nt,bfloat16_t,false,true)
BMMS11_KERNEL(bmms11_b16_tn,bfloat16_t,true,false)
BMMS11_KERNEL(bmms11_b16_tt,bfloat16_t,true,true)
#undef BMMS11_KERNEL
namespace bmms11 {
static inline bool TryLaunch(GM_ADDR a,GM_ADDR b,GM_ADDR y,int32_t B,int32_t M,int32_t N,int32_t K,
    int32_t dtype,bool ta,bool tb,int32_t cores,aclrtStream stream){
    if((dtype!=1&&dtype!=2)||!Eligible(B,M,N,K,cores))return false;
    const auto family=bmms8::Classify(B,M,N,K,ta,tb);
    if(family==bmms8::Family::Resident||family==bmms8::Family::Tiny)return false;
    const auto p=MakePlan(B,M,N,K,cores);uint8_t* ws=nullptr;
    if(aclrtMalloc(reinterpret_cast<void**>(&ws),WorkspaceBytes(p),ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)std::abort();
    uint8_t* partial=ws+RingBytes(p);
#define BMMS11_LAUNCH(NAME) NAME<<<p.blocks,nullptr,stream>>>(a,b,y,ws,partial,p)
    if(dtype==1){
        if(!ta&&!tb){BMMS11_LAUNCH(bmms11_f16_nn);}else if(!ta&&tb){BMMS11_LAUNCH(bmms11_f16_nt);}
        else if(ta&&!tb){BMMS11_LAUNCH(bmms11_f16_tn);}else{BMMS11_LAUNCH(bmms11_f16_tt);}
    }else{
        if(!ta&&!tb){BMMS11_LAUNCH(bmms11_b16_nn);}else if(!ta&&tb){BMMS11_LAUNCH(bmms11_b16_nt);}
        else if(ta&&!tb){BMMS11_LAUNCH(bmms11_b16_tn);}else{BMMS11_LAUNCH(bmms11_b16_tt);}
    }
#undef BMMS11_LAUNCH
    if(aclrtSynchronizeStream(stream)!=ACL_SUCCESS)std::abort();if(aclrtFree(ws)!=ACL_SUCCESS)std::abort();return true;
}
} // namespace bmms11
#endif
