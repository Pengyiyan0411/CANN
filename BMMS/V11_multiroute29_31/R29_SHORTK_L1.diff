+namespace bmms29 {
+static inline bool TryLaunch(GM_ADDR a,GM_ADDR b,GM_ADDR y,
+    int32_t B,int32_t M,int32_t N,int32_t K,int32_t dtype,bool ta,bool tb,
+    int32_t cores,aclrtStream stream){
+    if((dtype!=1&&dtype!=2)||!Eligible(B,M,N,K,cores))return false;
+    const auto family=bmms8::Classify(B,M,N,K,ta,tb);
+    if(family==bmms8::Family::Resident||family==bmms8::Family::Tiny)return false;
+    const auto p=bmms11d::MakePlan(B,M,N,K,cores);
+    uint8_t* ws=nullptr;
+    if(aclrtMalloc(reinterpret_cast<void**>(&ws),bmms11d::WorkspaceBytes(p),ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)std::abort();
+    uint8_t* partial=ws+bmms11d::RingBytes(p);
+#define BMMS29_LAUNCH(NAME) NAME<<<p.blocks,nullptr,stream>>>(a,b,y,ws,partial,p)
+    if(dtype==1){
+        if(!ta&&!tb){BMMS29_LAUNCH(bmms29_f16_nn);}
+        else if(!ta&&tb){BMMS29_LAUNCH(bmms29_f16_nt);}
+        else if(ta&&!tb){BMMS29_LAUNCH(bmms29_f16_tn);}
+        else{BMMS29_LAUNCH(bmms29_f16_tt);}
+    }else{
+        if(!ta&&!tb){BMMS29_LAUNCH(bmms29_b16_nn);}
+        else if(!ta&&tb){BMMS29_LAUNCH(bmms29_b16_nt);}
+        else if(ta&&!tb){BMMS29_LAUNCH(bmms29_b16_tn);}
+        else{BMMS29_LAUNCH(bmms29_b16_tt);}
+    }
+#undef BMMS29_LAUNCH
+    if(aclrtSynchronizeStream(stream)!=ACL_SUCCESS)std::abort();
+    if(aclrtFree(ws)!=ACL_SUCCESS)std::abort();
+    return true;
+}
