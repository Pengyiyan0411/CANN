+class DenseGatherConsumer {
+    NativePlan p;AscendC::TPipe* pipe_;int mergeRows;
+    AscendC::GlobalTensor<float> ring,part,out;
+    AscendC::TQue<AscendC::TPosition::VECIN,1> cq;
+    AscendC::TQue<AscendC::TPosition::VECOUT,1> oq;
