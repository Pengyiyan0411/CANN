+        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(abReady[slot]);
+    }
+    __aicore__ inline void Emit(int group,int mo,int no,int mr,int nr,int ar,int br,int stage){
+        const int slot=seq&1;
