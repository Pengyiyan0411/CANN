uint64_t checks=0,unchanged=0,hits[3]={},case5=0,split=0,routes[6]={},maxUB=0,partitionChecks=0;
Record execute(int i,int B,int M,int N,int K,int dt,bool ta,bool tb,int cores){
    TensorGroupInfo a{1,{{3,dt,{B,ta?K:M,ta?M:K}}}},b{1,{{3,dt,{B,tb?N:K,tb?K:N}}}},y{1,{{1,0,{B,0,0}}}};
    actual={};functions[i](nullptr,a,nullptr,b,nullptr,y,cores,nullptr,ta,tb);
    need(actual.launches==1&&actual.mallocs==actual.frees&&actual.syncs==actual.frees,"lifecycle mismatch");return actual;
}
void check(int B,int M,int N,int K,int dt,bool ta,bool tb,int cores){
    if(int64_t(B)*M*K>(1LL<<26)||int64_t(B)*N*K>(1LL<<26))return;
    Record baseline=execute(0,B,M,N,K,dt,ta,tb,cores);++routes[baseline.route];
    const int c=cores>0&&cores<=64?cores:1;
    for(int i=1;i<=3;++i){
        bool hit=i==1?(baseline.route==RESIDUAL&&M<128&&N<256&&K<512&&B<c):
            i==2?(baseline.route==NATIVE&&B==1&&M>=128&&N>32&&K==128&&baseline.blocks>1):baseline.route==MACRO;
        Record got=execute(i,B,M,N,K,dt,ta,tb,cores),expected=baseline;
        if(hit){
            ++hits[i-1];expected.strategy=i+28;
            if(i==2){
                auto p=bmms30::MakeNative(B,M,N,K,c);
                need(p.B==B&&p.M==M&&p.N==N&&p.K==K&&p.mTiles==(M+127)/128&&p.nTiles==(N+127)/128,"wrong native tile geometry");
                need(p.pM>=1&&p.pM<=p.mTiles&&p.pN>=1&&p.pN<=p.nTiles,"empty native shard");
                need(p.tasks==B*p.pM*p.pN&&p.tasks<=2*c&&p.blocks==std::min(c,p.tasks),"wrong native launch geometry");
                uint64_t area=0;int lastM=0;
                for(int ms=0;ms<p.pM;++ms){int begin=ms*p.mTiles/p.pM*128,end=std::min(M,(ms+1)*p.mTiles/p.pM*128);
                    need(begin==lastM&&begin<end,"M shard gap/overlap");lastM=end;int lastN=0;
                    for(int ns=0;ns<p.pN;++ns){int n0=ns*p.nTiles/p.pN*128,n1=std::min(N,(ns+1)*p.nTiles/p.pN*128);
                        need(n0==lastN&&n0<n1,"N shard gap/overlap");lastN=n1;area+=uint64_t(end-begin)*(n1-n0);++partitionChecks;}
                    need(lastN==N,"N tail missing");}
                need(lastM==M&&area==uint64_t(M)*N,"output not partitioned exactly once");
                int mergeRows=std::min(M,(8192/p.pN/16)*16);
                uint64_t ub=2*64*128*4+64*4+256*4+uint64_t(M)*8+uint64_t(mergeRows)*p.pN*4+32;
                need(mergeRows>=16&&ub<=192*1024,"R30 UB over capacity");maxUB=std::max(maxUB,ub);
                expected.blocks=p.blocks;expected.plan={p.B,p.M,p.N,p.K,p.mTiles,p.nTiles,p.pM,p.pN,p.tasks,p.blocks};
                expected.allocation=bmms30::NativeRingBytes(p)+bmms30::NativePartialBytes(p);expected.partial=bmms30::NativeRingBytes(p);
            }
        }else ++unchanged;
        need(got==expected,"non-target dispatch or target plan changed");++checks;
        if(B>1&&M<=32&&N<=32&&K==128){need(got==baseline,"R25 Case5 protection failed");++case5;}
        if(baseline.route==SPLIT){need(got==baseline,"R25 Split-K protection failed");++split;}
    }
}
int main(){try{
    for(int B:{1,2,3,20,64})for(int M:{16,32,48,64,112,128,144,272,1024,8192})for(int N:{16,32,48,128,144,240,256,528,1024,8192})
    for(int K:{32,64,128,256,480,512,4096})for(int cores:{0,1,3,20,64,65})check(B,M,N,K,1,false,false,cores);
    for(int M=16;M<128;M+=16)for(int N=16;N<256;N+=16)for(int K=256;K<512;K+=32)
        for(int B:{1,3})for(int c:{1,3,4,20})check(B,M,N,K,2,true,true,c);
    for(int dt:{1,2})for(bool ta:{false,true})for(bool tb:{false,true})for(int c:{1,3,20,64})
        for(auto s:std::vector<std::array<int,4>>{{7,16,32,128},{1,144,272,128},{1,112,240,480},{1,128,256,512},
            {1,48,96,4096},{1,272,528,544},{1,128,256,8192},{3,80,1,96},{3,1,80,96},{3,3,3,64},{1,17,19,264}})
            check(s[0],s[1],s[2],s[3],dt,ta,tb,c);
    for(int r=0;r<6;++r)need(routes[r]>0,"missing original route");for(int i=0;i<3;++i)need(hits[i]>0,"missing target");
    need(unchanged&&case5&&split&&maxUB&&partitionChecks,"missing coverage");
    std::cout<<"{\"dispatch_checks\":"<<checks<<",\"unchanged_full_launch_records\":"<<unchanged<<",\"candidate_selections\":["<<hits[0]<<","<<hits[1]<<","<<hits[2]
        <<"],\"Case5_metadata_protection_checks\":"<<case5<<",\"SplitK_protection_checks\":"<<split<<",\"R30_max_UB_bytes\":"<<maxUB
        <<",\"R30_partition_checks\":"<<partitionChecks<<",\"original_routes\":[";
    for(int i=0;i<6;++i){if(i)std::cout<<",";std::cout<<routes[i];}std::cout<<"]}\n";
}catch(const std::exception&e){std::cerr<<e.what()<<"\n";return 1;}}
