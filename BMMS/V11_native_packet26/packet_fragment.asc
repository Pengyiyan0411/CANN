
// BMMS26_BEGIN
namespace bmms26 {
using namespace bmms83;
// Look ahead in the exact original task / M-stage / N-panel / M-tile / N-tile
// order. This cursor describes valid bytes only; it never reads ring padding.
class PacketCursor {
    NativePlan p;
    int task,mBegin,mEnd,nBegin,nEnd,mBase,nBase,mo,no;
    __aicore__ inline void StartTask(){
        if(task>=p.tasks)return;
        const int perBatch=p.pM*p.pN,slot=task%perBatch;
        const int ms=slot/p.pN,ns=slot%p.pN;
        mBegin=(ms*p.mTiles/p.pM)*TM;
        mEnd=MinI(((ms+1)*p.mTiles/p.pM)*TM,p.M);
        nBegin=(ns*p.nTiles/p.pN)*TN;
        nEnd=MinI(((ns+1)*p.nTiles/p.pN)*TN,p.N);
        mBase=mBegin;nBase=nBegin;mo=0;no=0;
    }
public:
    __aicore__ inline void Init(const NativePlan& plan,int group){p=plan;task=group;StartTask();}
    __aicore__ inline bool Next(int& mr,int& nr){
        if(task>=p.tasks)return false;
        const int ar=MinI(AM,mEnd-mBase),br=MinI(BN,nEnd-nBase);
        mr=MinI(TM,ar-mo);nr=MinI(TN,br-no);
        no+=TN;
        if(no>=br){no=0;mo+=TM;
            if(mo>=ar){mo=0;nBase+=BN;
                if(nBase>=nEnd){nBase=nBegin;mBase+=AM;
                    if(mBase>=mEnd){task+=p.blocks;StartTask();}
                }
            }
        }
        return true;
    }
};

class DensePacketConsumer {
    static constexpr int HALF_TILE=(TM/2)*TN;
    NativePlan p;AscendC::TPipe* pipe_;int mergeRows;
    AscendC::GlobalTensor<float> ring,part,out;
    AscendC::TQue<AscendC::TPosition::VECOUT,1> oq;
    AscendC::TBuf<AscendC::TPosition::VECCALC> groupBuf,rowBuf;
    AscendC::TBuf<AscendC::TPosition::VECOUT> runningBuf;
    AscendC::TBuf<AscendC::TPosition::VECIN> workBuf;
    __aicore__ inline void FetchPacket(PacketCursor& cursor,int group,int sub,int ringSlot){
        auto data=workBuf.Get<float>();
        int mr[PACKET_TILES],nr[PACKET_TILES],count=0;
        for(int i=0;i<PACKET_TILES;++i){
            if(!cursor.Next(mr[i],nr[i]))break;
            ++count;
        }
        // Prior packet V reads must finish before MTE2 reuses the UB storage.
        // Only a short-N tile needs -inf in the lanes not written by DMA.
        for(int i=0;i<count;++i){
            if(nr[i]<TN)AscendC::Duplicate(data[i*HALF_TILE],bmmmaxsum_v43::NEG_INF,(mr[i]/2)*TN);
        }
        bmms71::Fence<AscendC::HardEvent::V_MTE2>(*pipe_);
        const int64_t off=(int64_t(group)*2+ringSlot)*PACKET_TILES*TM*TN;
        AscendC::DataCopyPadExtParams<float> pd{false,0,0,0.0f};
        for(int i=0;i<count;){
            const int vr=mr[i]/2;
            if(nr[i]==TN){
                int end=i+1;
                while(end<count&&nr[end]==TN&&mr[end]==mr[i])++end;
                // Consecutive full-N tiles with the same valid M extent can
                // share one DMA, including M tails such as mr=48 or mr=16.
                // GM strides are bytes; UB dstStride is in 32-byte blocks.
                AscendC::DataCopyExtParams cp{static_cast<uint16_t>(end-i),uint32_t(vr*TN*4),uint32_t((TM*TN-vr*TN)*4),uint32_t((HALF_TILE-vr*TN)/8),0};
                AscendC::DataCopyPad(data[i*HALF_TILE],ring[off+i*TM*TN+sub*vr*TN],cp,pd);
                i=end;
            }else{
                AscendC::DataCopyExtParams cp{static_cast<uint16_t>(vr),uint32_t(nr[i]*4),uint32_t((TN-nr[i])*4),uint32_t((TN-nr[i])/8),0};
                AscendC::DataCopyPad(data[i*HALF_TILE],ring[off+i*TM*TN+sub*vr*TN],cp,pd);
                ++i;
            }
        }
        bmms71::Fence<AscendC::HardEvent::MTE2_V>(*pipe_);
        // All published values are now in private UB. Both AIVs acknowledge;
        // AIC may recycle GM while V reduces this packet from its UB copy.
        AscendC::CrossCoreSetFlag<0x2,PIPE_MTE2>(FREE+ringSlot);
    }
public:
    __aicore__ inline void Init(GM_ADDR r,GM_ADDR pt,GM_ADDR y,const NativePlan& plan,AscendC::TPipe* pipe){
        p=plan;pipe_=pipe;
        ring.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(r),int64_t(p.blocks)*2*PACKET_TILES*TM*TN);
        part.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(pt),int64_t(p.B)*p.pN*p.M);
        out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y),p.B);
        pipe->InitBuffer(oq,1,32);
        pipe->InitBuffer(groupBuf,(TM/2)*TN*4);pipe->InitBuffer(rowBuf,(TM/2)*4);
        pipe->InitBuffer(runningBuf,AM*4);
        mergeRows=MinI(p.M,(16384/p.pN/16)*16);
        const int mergeElements=2*p.M+mergeRows*p.pN;
        const int workElements=mergeElements>PACKET_TILES*HALF_TILE?mergeElements:PACKET_TILES*HALF_TILE;
        pipe->InitBuffer(workBuf,workElements*4);
    }
    __aicore__ inline void Process(){
        const int worker=AscendC::GetBlockIdx(),group=worker/2,sub=worker%2;
        const int perBatch=p.pM*p.pN;
        PacketCursor cursor;cursor.Init(p,group);
        int seq=0;auto acc=groupBuf.Get<float>();auto rows=rowBuf.Get<float>();auto run=runningBuf.Get<float>();
        for(int task=group;task<p.tasks;task+=p.blocks){
            const int batch=task/perBatch,slot=task-batch*perBatch;
            const int ms=slot/p.pN,ns=slot-ms*p.pN;
            const int mt0=ms*p.mTiles/p.pM,mt1=(ms+1)*p.mTiles/p.pM;
            const int nt0=ns*p.nTiles/p.pN,nt1=(ns+1)*p.nTiles/p.pN;
            const int mBegin=mt0*TM,mEnd=MinI(mt1*TM,p.M);
            const int nBegin=nt0*TN,nEnd=MinI(nt1*TN,p.N);
            for(int mBase=mBegin;mBase<mEnd;mBase+=AM){
                const int ar=MinI(AM,mEnd-mBase);
                AscendC::Duplicate(run,bmmmaxsum_v43::NEG_INF,ar);AscendC::PipeBarrier<PIPE_V>();
                for(int nBase=nBegin;nBase<nEnd;nBase+=BN){
                    const int br=MinI(BN,nEnd-nBase);
                    for(int mo=0;mo<ar;mo+=TM){
                        const int mr=MinI(TM,ar-mo),vr=mr/2;
                        AscendC::Duplicate(acc,bmmmaxsum_v43::NEG_INF,vr*TN);AscendC::PipeBarrier<PIPE_V>();
                        for(int no=0;no<br;no+=TN){
                            const int nr=MinI(TN,br-no),ringSlot=(seq/PACKET_TILES)&1,tileSlot=seq%PACKET_TILES;
                            if(tileSlot==0){
                                AscendC::CrossCoreWaitFlag<0x2>(READY+ringSlot);
                                FetchPacket(cursor,group,sub,ringSlot);
                            }
                            auto c=workBuf.Get<float>()[tileSlot*HALF_TILE];
                            AscendC::Max(acc,acc,c,vr*TN);AscendC::PipeBarrier<PIPE_V>();++seq;
                        }
                        AscendC::BinaryRepeatParams rp{1,1,1,16,16,16};
                        AscendC::Max(acc,acc,acc[64],64,vr,rp);AscendC::PipeBarrier<PIPE_V>();
                        AscendC::WholeReduceMax(rows,acc,64,vr,1,1,16,AscendC::ReduceOrder::ORDER_ONLY_VALUE);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Max(run[mo+sub*vr],run[mo+sub*vr],rows,vr);AscendC::PipeBarrier<PIPE_V>();
                    }
                }
                bmms71::Fence<AscendC::HardEvent::V_MTE3>(*pipe_);
                for(int mo=0;mo<ar;mo+=TM){
                    const int vr=MinI(TM,ar-mo)/2;
                    const int64_t dst=(int64_t(batch)*p.pN+ns)*p.M+mBase+mo+sub*vr;
                    AscendC::DataCopy(part[dst],run[mo+sub*vr],vr);
                }
                bmms71::Fence<AscendC::HardEvent::MTE3_V>(*pipe_);
            }
        }
        bmms71::Fence<AscendC::HardEvent::MTE3_MTE2>(*pipe_);AscendC::SyncAll<true>();
        // One batch: collect all N shards with one strided DMA per row stripe.
        // Keep the original all-M ReduceSum, and the original single barrier.
        // Packet reads are complete. Reuse the same UB allocation for the merge.
        bmms71::Fence<AscendC::HardEvent::V_MTE2>(*pipe_);
        auto merged=workBuf.Get<float>(),values=merged[p.M];
        if(worker==0){
            if(p.pN==1){
                AscendC::DataCopy(merged,part[0],p.M);
                bmms71::Fence<AscendC::HardEvent::MTE2_V>(*pipe_);
            }else{
                for(int m0=0;m0<p.M;m0+=mergeRows){
                    const int rows=MinI(mergeRows,p.M-m0);
                    AscendC::DataCopyExtParams cp{static_cast<uint16_t>(p.pN),uint32_t(rows*4),uint32_t((p.M-rows)*4),0,0};
                    AscendC::DataCopyPadExtParams<float> pd{false,0,0,0.0f};
                    AscendC::DataCopyPad(values,part[m0],cp,pd);
                    bmms71::Fence<AscendC::HardEvent::MTE2_V>(*pipe_);
                    // Handles non-power-of-two pN without padding or dropping a shard.
                    for(int active=p.pN;active>1;){
                        const int pairs=active/2,keep=active-pairs;
                        AscendC::Max(values,values,values[keep*rows],pairs*rows);
                        AscendC::PipeBarrier<PIPE_V>();active=keep;
                    }
                    AscendC::Max(merged[m0],values,values,rows);
                    bmms71::Fence<AscendC::HardEvent::V_MTE2>(*pipe_);
                }
            }
            auto yy=oq.AllocTensor<float>();AscendC::ReduceSum(yy,merged,merged[p.M+mergeRows*p.pN],p.M);
            oq.EnQue(yy);yy=oq.DeQue<float>();AscendC::DataCopyExtParams oc{1,4,0,0,0};
            AscendC::DataCopyPad(out[0],yy,oc);oq.FreeTensor(yy);
        }
    }
};



template<class T,bool TA,bool TB>
__aicore__ inline void Entry(GM_ADDR a,GM_ADDR b,GM_ADDR y,GM_ADDR ring,GM_ADDR partial,NativePlan p){
    AscendC::TPipe pipe;
    if ASCEND_IS_AIC {bmms83::SmallKProducer<T,TA,TB,128> op;op.Init(a,b,ring,p,&pipe);op.Process();}
    if ASCEND_IS_AIV {DensePacketConsumer op;op.Init(ring,partial,y,p,&pipe);op.Process();}
}
} // namespace bmms26
// BMMS26_CPU_EXTRACT_END
#define BMMS26_KERNEL(NAME,T,TA,TB) \
__schedmode__(1) __global__ __mix__(1,2) void NAME(GM_ADDR a,GM_ADDR b,GM_ADDR y,GM_ADDR ring,GM_ADDR part,bmms83::NativePlan p){bmms26::Entry<T,TA,TB>(a,b,y,ring,part,p);}
BMMS26_KERNEL(bmms26_dense_f16_nn,half,false,false)
BMMS26_KERNEL(bmms26_dense_f16_nt,half,false,true)
BMMS26_KERNEL(bmms26_dense_f16_tn,half,true,false)
BMMS26_KERNEL(bmms26_dense_f16_tt,half,true,true)
BMMS26_KERNEL(bmms26_dense_b16_nn,bfloat16_t,false,false)
BMMS26_KERNEL(bmms26_dense_b16_nt,bfloat16_t,false,true)
BMMS26_KERNEL(bmms26_dense_b16_tn,bfloat16_t,true,false)
BMMS26_KERNEL(bmms26_dense_b16_tt,bfloat16_t,true,true)
#undef BMMS26_KERNEL
namespace bmms26 {
static inline bool TryLaunch(GM_ADDR a,GM_ADDR b,GM_ADDR y,const NativePlan& p,int dtype,bool ta,bool tb,aclrtStream stream){
    if(!(p.K==128&&p.B==1&&p.M>32&&p.N>32&&p.blocks>1))return false;
    uint8_t* ws=nullptr;const uint64_t rb=NativeRingBytes(p),pb=NativePartialBytes(p);
    if(aclrtMalloc(reinterpret_cast<void**>(&ws),rb+pb,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)std::abort();
    uint8_t* partial=ws+rb;
#define BMMS26_LAUNCH(NAME) NAME<<<p.blocks,nullptr,stream>>>(a,b,y,ws,partial,p)
    {
        if(dtype==1){
            if(!ta&&!tb){BMMS26_LAUNCH(bmms26_dense_f16_nn);}else if(!ta&&tb){BMMS26_LAUNCH(bmms26_dense_f16_nt);}
            else if(ta&&!tb){BMMS26_LAUNCH(bmms26_dense_f16_tn);}else{BMMS26_LAUNCH(bmms26_dense_f16_tt);}
        }else{
            if(!ta&&!tb){BMMS26_LAUNCH(bmms26_dense_b16_nn);}else if(!ta&&tb){BMMS26_LAUNCH(bmms26_dense_b16_nt);}
            else if(ta&&!tb){BMMS26_LAUNCH(bmms26_dense_b16_tn);}else{BMMS26_LAUNCH(bmms26_dense_b16_tt);}
        }
    }
#undef BMMS26_LAUNCH
    if(aclrtSynchronizeStream(stream)!=ACL_SUCCESS)std::abort();
    if(aclrtFree(ws)!=ACL_SUCCESS)std::abort();return true;
}
} // namespace bmms26
// BMMS26_END

