+                }
+                const int panelCount=(nEnd-nBegin+BN-1)/BN,used=MinI(2,panelCount);
+                for(int st=0;st<used;++st)AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(bFree[st]);
+                AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(bFree[2]);
