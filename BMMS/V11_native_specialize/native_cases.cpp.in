    // Independently exercise the three semantic families, all K, dtypes and layouts.
    for(int rev=0;rev<2;++rev){
        for(auto d:std::vector<std::array<int,5>>{
            {1,16,528,32,1},{1,32,656,64,1},{3,16,784,128,2},
            {1,144,16,32,2},{1,208,32,64,2},{3,80,16,128,2},
            {1,144,272,32,1},{1,272,656,64,1},{3,80,656,128,2}}){
            layouts<half>(d,0,rev);layouts<bfloat16_t>(d,0,rev);
        }
        // Batches sharing groups, odd packet boundaries, A0 refresh across AM=256.
        dense<half,true,true>(3,272,400,128,2,1,rev);
        dense<bfloat16_t,false,false>(3,272,400,128,2,0,rev);
        dense<half,false,true>(1,64,640,64,3,0,rev);
        dense<bfloat16_t,true,false>(1,144,528,128,1,2,rev);
    }
    // Explicit logical-work controls; reverse worker start order must not change them.
    for(int rev=0;rev<2;++rev){
        dense<half,false,false>(1,256,1024,32,1,0,rev);
        dense<half,false,false>(1,256,1024,64,1,0,rev);
        dense<half,false,false>(1,256,1024,128,1,0,rev);
        dense<half,false,false>(1,256,16,128,1,0,rev);
    }
