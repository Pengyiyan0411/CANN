        // One batch: collect all N shards with one strided DMA per row stripe.
        // Keep the original all-M ReduceSum, and the original single barrier.
        auto merged=mergedBuf.Get<float>(),values=tmpBuf.Get<float>();
        if(worker==0){
            if(p.pN==1){
                AscendC::DataCopy(merged,part[0],p.M);
                bmms71::Fence<AscendC::HardEvent::MTE2_V>(*pipe_);
            }else{
                for(int m0=0;m0<p.M;m0+=mergeRows){
                    const int rows=MinI(mergeRows,p.M-m0);
                    AscendC::DataCopyExtParams cp{static_cast<uint16_t>(p.pN),uint32_t(rows*4),uint32_t((p.M-rows)*4),0,0};
                    AscendC::DataCopyPadExtParams<float> pd{false,0,0,0.0f};
                    AscendC::DataCopyPad(values,part[m0],cp,pd);
                    bmms71::Fence<AscendC::HardEvent::MTE2_V>(*pipe_);
                    // Handles non-power-of-two pN without padding or dropping a shard.
                    for(int active=p.pN;active>1;){
                        const int pairs=active/2,keep=active-pairs;
                        AscendC::Max(values,values,values[keep*rows],pairs*rows);
                        AscendC::PipeBarrier<PIPE_V>();active=keep;
                    }
                    AscendC::Max(merged[m0],values,values,rows);
                    bmms71::Fence<AscendC::HardEvent::V_MTE2>(*pipe_);
                }
            }
            auto yy=oq.AllocTensor<float>();AscendC::ReduceSum(yy,merged,sumBuf.Get<float>(),p.M);
            oq.EnQue(yy);yy=oq.DeQue<float>();AscendC::DataCopyExtParams oc{1,4,0,0,0};
            AscendC::DataCopyPad(out[0],yy,oc);oq.FreeTensor(yy);
        }
