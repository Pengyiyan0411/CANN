// Each batch is a complete <=32x32 output tile. Both AIVs participate in
// packet credits; alternating tiles have one owner that reads all valid rows.
// No row-partial GM round trip and no cross-group barrier are needed.
class SmallBatchConsumer {
    NativePlan p;
    AscendC::GlobalTensor<float> ring,out;
    AscendC::TQue<AscendC::TPosition::VECIN,1> cq;
    AscendC::TQue<AscendC::TPosition::VECOUT,1> oq;
    AscendC::TBuf<AscendC::TPosition::VECCALC> rowBuf,sumBuf;
public:
    __aicore__ inline void Init(GM_ADDR r,GM_ADDR pt,GM_ADDR y,const NativePlan& plan,AscendC::TPipe* pipe){
        p=plan;
        ring.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(r),int64_t(p.blocks)*2*PACKET_TILES*TM*TN);
        out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y),p.B);
        pipe->InitBuffer(cq,1,p.M*p.N*4);pipe->InitBuffer(oq,1,32);
        pipe->InitBuffer(rowBuf,p.M*4);pipe->InitBuffer(sumBuf,p.M*4);
    }
    __aicore__ inline void Process(){
        const int worker=AscendC::GetBlockIdx(),group=worker/2,sub=worker%2;
        int seq=0;
        for(int batch=group;batch<p.B;batch+=p.blocks){
            const int ringSlot=(seq/PACKET_TILES)&1,tileSlot=seq%PACKET_TILES;
            if(tileSlot==0)AscendC::CrossCoreWaitFlag<0x2>(READY+ringSlot);
            if(sub==(seq&1)){
                auto c=cq.AllocTensor<float>();
                const int64_t off=((int64_t(group)*2+ringSlot)*PACKET_TILES+tileSlot)*TM*TN;
                // M,N are 16-aligned: every loaded row is complete, with no UB padding.
                AscendC::DataCopyExtParams cp{static_cast<uint16_t>(p.M),uint32_t(p.N*4),uint32_t((TN-p.N)*4),0,0};
                AscendC::DataCopyPadExtParams<float> pd{false,0,0,0.0f};
                AscendC::DataCopyPad(c,ring[off],cp,pd);cq.EnQue(c);c=cq.DeQue<float>();
                auto rows=rowBuf.Get<float>();
                AscendC::WholeReduceMax(rows,c,p.N,p.M,1,1,p.N/8,AscendC::ReduceOrder::ORDER_ONLY_VALUE);
                AscendC::PipeBarrier<PIPE_V>();
                auto yy=oq.AllocTensor<float>();
                AscendC::ReduceSum(yy,rows,sumBuf.Get<float>(),p.M);
                oq.EnQue(yy);yy=oq.DeQue<float>();
                AscendC::DataCopyExtParams oc{1,4,0,0,0};
                AscendC::DataCopyPad(out[batch],yy,oc);oq.FreeTensor(yy);cq.FreeTensor(c);
            }
            // Even an AIV owning no tile in this packet must acknowledge it.
            if(tileSlot+1==PACKET_TILES)AscendC::CrossCoreSetFlag<0x2,PIPE_MTE2>(FREE+ringSlot);
            ++seq;
        }
        if(seq%PACKET_TILES)AscendC::CrossCoreSetFlag<0x2,PIPE_MTE2>(FREE+((seq/PACKET_TILES)&1));
    }
};
