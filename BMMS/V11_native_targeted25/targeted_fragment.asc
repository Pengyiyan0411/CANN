
// BMMS25_BEGIN
namespace bmms25 {
using namespace bmms83;
static inline int Select(const NativePlan& p){
    if(BMMS25_SMALL&&p.K==128&&p.B>1&&p.M<=32&&p.N<=32&&p.blocks>1)return 1;
    if(BMMS25_DENSE&&p.K==128&&p.B==1&&p.M>32&&p.N>32&&p.blocks>1)return 2;
    return 0;
}
// Each batch is a complete <=32x32 output tile. Both AIVs participate in
// packet credits; alternating tiles have one owner that reads all valid rows.
// No row-partial GM round trip and no cross-group barrier are needed.
class SmallBatchConsumer {
    NativePlan p;
    AscendC::GlobalTensor<float> ring,out;
    AscendC::TQue<AscendC::TPosition::VECIN,1> cq;
    AscendC::TQue<AscendC::TPosition::VECOUT,1> oq;
    AscendC::TBuf<AscendC::TPosition::VECCALC> rowBuf,sumBuf;
public:
    __aicore__ inline void Init(GM_ADDR r,GM_ADDR pt,GM_ADDR y,const NativePlan& plan,AscendC::TPipe* pipe){
        p=plan;
        ring.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(r),int64_t(p.blocks)*2*PACKET_TILES*TM*TN);
        out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y),p.B);
        pipe->InitBuffer(cq,1,p.M*p.N*4);pipe->InitBuffer(oq,1,32);
        pipe->InitBuffer(rowBuf,p.M*4);pipe->InitBuffer(sumBuf,p.M*4);
    }
    __aicore__ inline void Process(){
        const int worker=AscendC::GetBlockIdx(),group=worker/2,sub=worker%2;
        int seq=0;
        for(int batch=group;batch<p.B;batch+=p.blocks){
            const int ringSlot=(seq/PACKET_TILES)&1,tileSlot=seq%PACKET_TILES;
            if(tileSlot==0)AscendC::CrossCoreWaitFlag<0x2>(READY+ringSlot);
            if(sub==(seq&1)){
                auto c=cq.AllocTensor<float>();
                const int64_t off=((int64_t(group)*2+ringSlot)*PACKET_TILES+tileSlot)*TM*TN;
                // M,N are 16-aligned: every loaded row is complete, with no UB padding.
                AscendC::DataCopyExtParams cp{static_cast<uint16_t>(p.M),uint32_t(p.N*4),uint32_t((TN-p.N)*4),0,0};
                AscendC::DataCopyPadExtParams<float> pd{false,0,0,0.0f};
                AscendC::DataCopyPad(c,ring[off],cp,pd);cq.EnQue(c);c=cq.DeQue<float>();
                auto rows=rowBuf.Get<float>();
                AscendC::WholeReduceMax(rows,c,p.N,p.M,1,1,p.N/8,AscendC::ReduceOrder::ORDER_ONLY_VALUE);
                AscendC::PipeBarrier<PIPE_V>();
                auto yy=oq.AllocTensor<float>();
                AscendC::ReduceSum(yy,rows,sumBuf.Get<float>(),p.M);
                oq.EnQue(yy);yy=oq.DeQue<float>();
                AscendC::DataCopyExtParams oc{1,4,0,0,0};
                AscendC::DataCopyPad(out[batch],yy,oc);oq.FreeTensor(yy);cq.FreeTensor(c);
            }
            // Even an AIV owning no tile in this packet must acknowledge it.
            if(tileSlot+1==PACKET_TILES)AscendC::CrossCoreSetFlag<0x2,PIPE_MTE2>(FREE+ringSlot);
            ++seq;
        }
        if(seq%PACKET_TILES)AscendC::CrossCoreSetFlag<0x2,PIPE_MTE2>(FREE+((seq/PACKET_TILES)&1));
    }
};

class DenseGatherConsumer {
    NativePlan p;AscendC::TPipe* pipe_;int mergeRows;
    AscendC::GlobalTensor<float> ring,part,out;
    AscendC::TQue<AscendC::TPosition::VECIN,1> cq;
    AscendC::TQue<AscendC::TPosition::VECOUT,1> oq;
    AscendC::TBuf<AscendC::TPosition::VECCALC> groupBuf,rowBuf,sumBuf;
    AscendC::TBuf<AscendC::TPosition::VECOUT> runningBuf;
    AscendC::TBuf<AscendC::TPosition::VECIN> mergedBuf,tmpBuf;
public:
    __aicore__ inline void Init(GM_ADDR r,GM_ADDR pt,GM_ADDR y,const NativePlan& plan,AscendC::TPipe* pipe){
        p=plan;pipe_=pipe;
        ring.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(r),int64_t(p.blocks)*2*PACKET_TILES*TM*TN);
        part.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(pt),int64_t(p.B)*p.pN*p.M);
        out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y),p.B);
        pipe->InitBuffer(cq,1,(TM/2)*TN*4);pipe->InitBuffer(oq,1,32);
        pipe->InitBuffer(groupBuf,(TM/2)*TN*4);pipe->InitBuffer(rowBuf,(TM/2)*4);
        pipe->InitBuffer(runningBuf,AM*4);pipe->InitBuffer(mergedBuf,p.M*4);
        mergeRows=MinI(p.M,(16384/p.pN/16)*16);
        pipe->InitBuffer(tmpBuf,mergeRows*p.pN*4);pipe->InitBuffer(sumBuf,p.M*4);
    }
    __aicore__ inline void Process(){
        const int worker=AscendC::GetBlockIdx(),group=worker/2,sub=worker%2;
        const int perBatch=p.pM*p.pN;
        int seq=0;auto acc=groupBuf.Get<float>();auto rows=rowBuf.Get<float>();auto run=runningBuf.Get<float>();
        for(int task=group;task<p.tasks;task+=p.blocks){
            const int batch=task/perBatch,slot=task-batch*perBatch;
            const int ms=slot/p.pN,ns=slot-ms*p.pN;
            const int mt0=ms*p.mTiles/p.pM,mt1=(ms+1)*p.mTiles/p.pM;
            const int nt0=ns*p.nTiles/p.pN,nt1=(ns+1)*p.nTiles/p.pN;
            const int mBegin=mt0*TM,mEnd=MinI(mt1*TM,p.M);
            const int nBegin=nt0*TN,nEnd=MinI(nt1*TN,p.N);
            for(int mBase=mBegin;mBase<mEnd;mBase+=AM){
                const int ar=MinI(AM,mEnd-mBase);
                AscendC::Duplicate(run,bmmmaxsum_v43::NEG_INF,ar);AscendC::PipeBarrier<PIPE_V>();
                for(int nBase=nBegin;nBase<nEnd;nBase+=BN){
                    const int br=MinI(BN,nEnd-nBase);
                    for(int mo=0;mo<ar;mo+=TM){
                        const int mr=MinI(TM,ar-mo),vr=mr/2;
                        AscendC::Duplicate(acc,bmmmaxsum_v43::NEG_INF,vr*TN);AscendC::PipeBarrier<PIPE_V>();
                        for(int no=0;no<br;no+=TN){
                            const int nr=MinI(TN,br-no),ringSlot=(seq/PACKET_TILES)&1,tileSlot=seq%PACKET_TILES;
                            if(tileSlot==0)AscendC::CrossCoreWaitFlag<0x2>(READY+ringSlot);
                            auto c=cq.AllocTensor<float>();
                            AscendC::Duplicate(c,bmmmaxsum_v43::NEG_INF,vr*TN);
                            bmms71::Fence<AscendC::HardEvent::V_MTE2>(*pipe_);
                            const int64_t off=((int64_t(group)*2+ringSlot)*PACKET_TILES+tileSlot)*TM*TN+sub*vr*TN;
                            AscendC::DataCopyExtParams cp{static_cast<uint16_t>(vr),uint32_t(nr*4),uint32_t((TN-nr)*4),uint32_t((TN-nr)/8),0};
                            AscendC::DataCopyPadExtParams<float> pd{false,0,0,0.0f};
                            AscendC::DataCopyPad(c,ring[off],cp,pd);cq.EnQue(c);c=cq.DeQue<float>();
                            if(tileSlot+1==PACKET_TILES)AscendC::CrossCoreSetFlag<0x2,PIPE_MTE2>(FREE+ringSlot);
                            AscendC::Max(acc,acc,c,vr*TN);AscendC::PipeBarrier<PIPE_V>();cq.FreeTensor(c);++seq;
                        }
                        AscendC::BinaryRepeatParams rp{1,1,1,16,16,16};
                        AscendC::Max(acc,acc,acc[64],64,vr,rp);AscendC::PipeBarrier<PIPE_V>();
                        AscendC::WholeReduceMax(rows,acc,64,vr,1,1,16,AscendC::ReduceOrder::ORDER_ONLY_VALUE);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Max(run[mo+sub*vr],run[mo+sub*vr],rows,vr);AscendC::PipeBarrier<PIPE_V>();
                    }
                }
                bmms71::Fence<AscendC::HardEvent::V_MTE3>(*pipe_);
                for(int mo=0;mo<ar;mo+=TM){
                    const int vr=MinI(TM,ar-mo)/2;
                    const int64_t dst=(int64_t(batch)*p.pN+ns)*p.M+mBase+mo+sub*vr;
                    AscendC::DataCopy(part[dst],run[mo+sub*vr],vr);
                }
                bmms71::Fence<AscendC::HardEvent::MTE3_V>(*pipe_);
            }
        }
        // The final partial packet has no next tile to trigger the normal release.
        if(seq%PACKET_TILES)AscendC::CrossCoreSetFlag<0x2,PIPE_MTE2>(FREE+((seq/PACKET_TILES)&1));
        bmms71::Fence<AscendC::HardEvent::MTE3_MTE2>(*pipe_);AscendC::SyncAll<true>();
        // One batch: collect all N shards with one strided DMA per row stripe.
        // Keep the original all-M ReduceSum, and the original single barrier.
        auto merged=mergedBuf.Get<float>(),values=tmpBuf.Get<float>();
        if(worker==0){
            if(p.pN==1){
                AscendC::DataCopy(merged,part[0],p.M);
                bmms71::Fence<AscendC::HardEvent::MTE2_V>(*pipe_);
            }else{
                for(int m0=0;m0<p.M;m0+=mergeRows){
                    const int rows=MinI(mergeRows,p.M-m0);
                    AscendC::DataCopyExtParams cp{static_cast<uint16_t>(p.pN),uint32_t(rows*4),uint32_t((p.M-rows)*4),0,0};
                    AscendC::DataCopyPadExtParams<float> pd{false,0,0,0.0f};
                    AscendC::DataCopyPad(values,part[m0],cp,pd);
                    bmms71::Fence<AscendC::HardEvent::MTE2_V>(*pipe_);
                    // Handles non-power-of-two pN without padding or dropping a shard.
                    for(int active=p.pN;active>1;){
                        const int pairs=active/2,keep=active-pairs;
                        AscendC::Max(values,values,values[keep*rows],pairs*rows);
                        AscendC::PipeBarrier<PIPE_V>();active=keep;
                    }
                    AscendC::Max(merged[m0],values,values,rows);
                    bmms71::Fence<AscendC::HardEvent::V_MTE2>(*pipe_);
                }
            }
            auto yy=oq.AllocTensor<float>();AscendC::ReduceSum(yy,merged,sumBuf.Get<float>(),p.M);
            oq.EnQue(yy);yy=oq.DeQue<float>();AscendC::DataCopyExtParams oc{1,4,0,0,0};
            AscendC::DataCopyPad(out[0],yy,oc);oq.FreeTensor(yy);
        }
    }
};


template<class T,bool TA,bool TB,bool SMALL>
__aicore__ inline void Entry(GM_ADDR a,GM_ADDR b,GM_ADDR y,GM_ADDR ring,GM_ADDR partial,NativePlan p){
    AscendC::TPipe pipe;
    if ASCEND_IS_AIC {bmms83::SmallKProducer<T,TA,TB,128> op;op.Init(a,b,ring,p,&pipe);op.Process();}
    if ASCEND_IS_AIV {
        if constexpr(SMALL){SmallBatchConsumer op;op.Init(ring,partial,y,p,&pipe);op.Process();}
        else{DenseGatherConsumer op;op.Init(ring,partial,y,p,&pipe);op.Process();}
    }
}
} // namespace bmms25
// BMMS25_CPU_EXTRACT_END
#define BMMS25_KERNEL(NAME,T,TA,TB,SMALL) \
__schedmode__(1) __global__ __mix__(1,2) void NAME(GM_ADDR a,GM_ADDR b,GM_ADDR y,GM_ADDR ring,GM_ADDR part,bmms83::NativePlan p){bmms25::Entry<T,TA,TB,SMALL>(a,b,y,ring,part,p);}
BMMS25_KERNEL(bmms25_small_f16_nn,half,false,false,true)
BMMS25_KERNEL(bmms25_small_f16_nt,half,false,true,true)
BMMS25_KERNEL(bmms25_small_f16_tn,half,true,false,true)
BMMS25_KERNEL(bmms25_small_f16_tt,half,true,true,true)
BMMS25_KERNEL(bmms25_small_b16_nn,bfloat16_t,false,false,true)
BMMS25_KERNEL(bmms25_small_b16_nt,bfloat16_t,false,true,true)
BMMS25_KERNEL(bmms25_small_b16_tn,bfloat16_t,true,false,true)
BMMS25_KERNEL(bmms25_small_b16_tt,bfloat16_t,true,true,true)
BMMS25_KERNEL(bmms25_dense_f16_nn,half,false,false,false)
BMMS25_KERNEL(bmms25_dense_f16_nt,half,false,true,false)
BMMS25_KERNEL(bmms25_dense_f16_tn,half,true,false,false)
BMMS25_KERNEL(bmms25_dense_f16_tt,half,true,true,false)
BMMS25_KERNEL(bmms25_dense_b16_nn,bfloat16_t,false,false,false)
BMMS25_KERNEL(bmms25_dense_b16_nt,bfloat16_t,false,true,false)
BMMS25_KERNEL(bmms25_dense_b16_tn,bfloat16_t,true,false,false)
BMMS25_KERNEL(bmms25_dense_b16_tt,bfloat16_t,true,true,false)
#undef BMMS25_KERNEL
namespace bmms25 {
static inline bool TryLaunch(GM_ADDR a,GM_ADDR b,GM_ADDR y,const NativePlan& p,int dtype,bool ta,bool tb,aclrtStream stream){
    const int strategy=Select(p);if(!strategy)return false;
    uint8_t* ws=nullptr;const uint64_t rb=NativeRingBytes(p),pb=NativePartialBytes(p);
    if(aclrtMalloc(reinterpret_cast<void**>(&ws),rb+pb,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)std::abort();
    uint8_t* partial=ws+rb;
#define BMMS25_LAUNCH(NAME) NAME<<<p.blocks,nullptr,stream>>>(a,b,y,ws,partial,p)
    if(strategy==1){
        if(dtype==1){
            if(!ta&&!tb){BMMS25_LAUNCH(bmms25_small_f16_nn);}else if(!ta&&tb){BMMS25_LAUNCH(bmms25_small_f16_nt);}
            else if(ta&&!tb){BMMS25_LAUNCH(bmms25_small_f16_tn);}else{BMMS25_LAUNCH(bmms25_small_f16_tt);}
        }else{
            if(!ta&&!tb){BMMS25_LAUNCH(bmms25_small_b16_nn);}else if(!ta&&tb){BMMS25_LAUNCH(bmms25_small_b16_nt);}
            else if(ta&&!tb){BMMS25_LAUNCH(bmms25_small_b16_tn);}else{BMMS25_LAUNCH(bmms25_small_b16_tt);}
        }
    }else{
        if(dtype==1){
            if(!ta&&!tb){BMMS25_LAUNCH(bmms25_dense_f16_nn);}else if(!ta&&tb){BMMS25_LAUNCH(bmms25_dense_f16_nt);}
            else if(ta&&!tb){BMMS25_LAUNCH(bmms25_dense_f16_tn);}else{BMMS25_LAUNCH(bmms25_dense_f16_tt);}
        }else{
            if(!ta&&!tb){BMMS25_LAUNCH(bmms25_dense_b16_nn);}else if(!ta&&tb){BMMS25_LAUNCH(bmms25_dense_b16_nt);}
            else if(ta&&!tb){BMMS25_LAUNCH(bmms25_dense_b16_tn);}else{BMMS25_LAUNCH(bmms25_dense_b16_tt);}
        }
    }
#undef BMMS25_LAUNCH
    if(aclrtSynchronizeStream(stream)!=ACL_SUCCESS)std::abort();
    if(aclrtFree(ws)!=ACL_SUCCESS)std::abort();return true;
}
} // namespace bmms25
// BMMS25_END

