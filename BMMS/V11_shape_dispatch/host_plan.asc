// Host-only policy. Device entry points never call this selector or its cost model.
using Plan=bmms83::NativePlan;
enum class Strategy : int32_t { R14=0, ShortN=1, ShortM=2, Dense=3 };
struct Selection {Strategy strategy;Plan plan;};
static inline int32_t UpH(int32_t a,int32_t b){return (a+b-1)/b;}
static inline int32_t MinH(int32_t a,int32_t b){return a<b?a:b;}
static inline int32_t MaxH(int32_t a,int32_t b){return a>b?a:b;}

template<int TM,int AM>
static inline int32_t StageCount(int32_t mt,int32_t pm){
    const int q=mt/pm,r=mt%pm,span=AM/TM;
    return r*UpH(q+1,span)+(pm-r)*UpH(q,span);
}
template<int TM,int TN,int AM>
static inline double Cost(const Plan& p,int pm,int pn,int cores){
    const int tasks=p.B*pm*pn,waves=UpH(tasks,cores);
    const double work=double(UpH(p.mTiles,pm))*UpH(p.nTiles,pn)*waves;
    const double reads=(double(p.M)*pn+double(p.N)*StageCount<TM,AM>(p.mTiles,pm))/double(TM*TN);
    const double partial=pn==1?0.015*pm:0.40*double(p.M)*pn/double(TM*TN);
    const double tax=0.015*double(tasks)/MaxH(1,MinH(tasks,cores));
    const double split=pn<=1?0.0:(p.K==32?0.08:p.K==64?0.04:0.02)*(pn-1);
    return work+0.55*reads+partial+tax+split;
}
template<int TM,int TN,int AM>
static inline Plan MakePlan(int B,int M,int N,int K,int cores){
    Plan p{B,M,N,K,UpH(M,TM),UpH(N,TN),1,1,B,MinH(B,cores)};
    double best=Cost<TM,TN,AM>(p,1,1,cores);
    const int cap=MinH(cores,2*MaxH(1,UpH(cores,B)));
    for(int pm=1;pm<=MinH(p.mTiles,cap);++pm)for(int pn=1;pn<=MinH(p.nTiles,cap);++pn){
        const int tasks=B*pm*pn;if(tasks>2*cores)continue;
        const double c=Cost<TM,TN,AM>(p,pm,pn,cores);
        if(c<best-1e-9||(c<=best+1e-9&&(pn<p.pN||(pn==p.pN&&tasks<p.tasks)))){
            best=c;p.pM=pm;p.pN=pn;p.tasks=tasks;p.blocks=MinH(cores,tasks);
        }
    }
    return p;
}

static inline Selection Select(int B,int M,int N,int K,int dtype,bool ta,bool tb,int cores){
    Selection s{Strategy::R14,{}};
    if(B<1||B>64||cores<1||cores>64||(dtype!=1&&dtype!=2)||M>8192||N>8192||
       !bmms83::NativeEligible(M,N,K))return s;
    const auto family=bmms8::Classify(B,M,N,K,ta,tb);
    if(family==bmms8::Family::Tiny||family==bmms8::Family::Resident)return s;
    const Plan old=bmms83::MakeNative(B,M,N,K,cores);s.plan=old;
    // N16/N32: no reason to reserve or vector-reduce 128 columns per row.
    if(family==bmms8::Family::ShortN_SmallK&&(N==16||N==32)){
        s.strategy=Strategy::ShortN;s.plan=MakePlan<64,32,256>(B,M,N,K,cores);
    // M16/M32, K32/K64, whole N256 tiles: wide N fits double-buffered L0B.
    }else if(family==bmms8::Family::ShortM_SmallK&&(M==16||M==32)&&
             (K==32||K==64)&&N>=256&&N%256==0){
        s.strategy=Strategy::ShortM;s.plan=MakePlan<32,256,32>(B,M,N,K,cores);
    // Full dense tiles only: double M height halves Cube/Fixpipe tile count.
    }else if(family==bmms8::Family::Dense_SmallK&&M>=128&&M%128==0&&N>=128&&N%128==0){
        s.strategy=Strategy::Dense;s.plan=MakePlan<128,128,256>(B,M,N,K,cores);
    }
    // Do not exchange usable core groups for a larger tile without device evidence.
    if(s.strategy!=Strategy::R14&&s.plan.blocks<old.blocks){s.strategy=Strategy::R14;s.plan=old;}
    return s;
}
static inline uint64_t RingBytes(const Selection& s){
    const int tm=s.strategy==Strategy::ShortM?32:s.strategy==Strategy::Dense?128:64;
    const int tn=s.strategy==Strategy::ShortN?32:s.strategy==Strategy::ShortM?256:128;
    return uint64_t(s.plan.blocks)*2*4*tm*tn*sizeof(float);
}
static inline uint64_t PartialBytes(const Plan& p){return uint64_t(p.B)*p.pN*p.M*sizeof(float);}
