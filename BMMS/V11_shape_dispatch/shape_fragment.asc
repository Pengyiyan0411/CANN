BMMS22_KERNEL(bmms22_dn_b16_nt_k128,bfloat16_t,false,true,128,128,128,256,512)
BMMS22_KERNEL(bmms22_dn_b16_tn_k128,bfloat16_t,true,false,128,128,128,256,512)
