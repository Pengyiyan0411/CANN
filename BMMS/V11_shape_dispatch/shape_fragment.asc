namespace bmms22 {
static inline bool TryLaunch(GM_ADDR a,GM_ADDR b,GM_ADDR y,int B,int M,int N,int K,int dtype,bool ta,bool tb,int cores,aclrtStream stream){
    const Selection selection=Select(B,M,N,K,dtype,ta,tb,cores);
    if(selection.strategy==Strategy::R14)return false;
    const Plan p=selection.plan;const uint64_t rb=RingBytes(selection),pb=PartialBytes(p);
    uint8_t* ws=nullptr;
    if(aclrtMalloc(reinterpret_cast<void**>(&ws),rb+pb,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)std::abort();
    uint8_t* partial=ws+rb;
#define BMMS22_LAUNCH(NAME) NAME<<<p.blocks,nullptr,stream>>>(a,b,y,ws,partial,p)
    if(selection.strategy==Strategy::ShortN){
        if(K==32){
            if(dtype==1){
                if(!ta&&!tb){BMMS22_LAUNCH(bmms22_sn_f16_nn_k32);}
                else if(!ta&&tb){BMMS22_LAUNCH(bmms22_sn_f16_nt_k32);}
                else if(ta&&!tb){BMMS22_LAUNCH(bmms22_sn_f16_tn_k32);}
                else if(ta&&tb){BMMS22_LAUNCH(bmms22_sn_f16_tt_k32);}
            }else{
                if(!ta&&!tb){BMMS22_LAUNCH(bmms22_sn_b16_nn_k32);}
                else if(!ta&&tb){BMMS22_LAUNCH(bmms22_sn_b16_nt_k32);}
                else if(ta&&!tb){BMMS22_LAUNCH(bmms22_sn_b16_tn_k32);}
                else if(ta&&tb){BMMS22_LAUNCH(bmms22_sn_b16_tt_k32);}
            }
        }
        else if(K==64){
            if(dtype==1){
                if(!ta&&!tb){BMMS22_LAUNCH(bmms22_sn_f16_nn_k64);}
                else if(!ta&&tb){BMMS22_LAUNCH(bmms22_sn_f16_nt_k64);}
                else if(ta&&!tb){BMMS22_LAUNCH(bmms22_sn_f16_tn_k64);}
                else if(ta&&tb){BMMS22_LAUNCH(bmms22_sn_f16_tt_k64);}
            }else{
                if(!ta&&!tb){BMMS22_LAUNCH(bmms22_sn_b16_nn_k64);}
                else if(!ta&&tb){BMMS22_LAUNCH(bmms22_sn_b16_nt_k64);}
                else if(ta&&!tb){BMMS22_LAUNCH(bmms22_sn_b16_tn_k64);}
                else if(ta&&tb){BMMS22_LAUNCH(bmms22_sn_b16_tt_k64);}
            }
        }
        else if(K==128){
            if(dtype==1){
                if(!ta&&!tb){BMMS22_LAUNCH(bmms22_sn_f16_nn_k128);}
                else if(!ta&&tb){BMMS22_LAUNCH(bmms22_sn_f16_nt_k128);}
                else if(ta&&!tb){BMMS22_LAUNCH(bmms22_sn_f16_tn_k128);}
                else if(ta&&tb){BMMS22_LAUNCH(bmms22_sn_f16_tt_k128);}
            }else{
                if(!ta&&!tb){BMMS22_LAUNCH(bmms22_sn_b16_nn_k128);}
                else if(!ta&&tb){BMMS22_LAUNCH(bmms22_sn_b16_nt_k128);}
                else if(ta&&!tb){BMMS22_LAUNCH(bmms22_sn_b16_tn_k128);}
                else if(ta&&tb){BMMS22_LAUNCH(bmms22_sn_b16_tt_k128);}
            }
        }
    }
    else if(selection.strategy==Strategy::ShortM){
        if(K==32){
            if(dtype==1){
                if(!ta&&!tb){BMMS22_LAUNCH(bmms22_sm_f16_nn_k32);}
                else if(!ta&&tb){BMMS22_LAUNCH(bmms22_sm_f16_nt_k32);}
                else if(ta&&!tb){BMMS22_LAUNCH(bmms22_sm_f16_tn_k32);}
                else if(ta&&tb){BMMS22_LAUNCH(bmms22_sm_f16_tt_k32);}
            }else{
                if(!ta&&!tb){BMMS22_LAUNCH(bmms22_sm_b16_nn_k32);}
                else if(!ta&&tb){BMMS22_LAUNCH(bmms22_sm_b16_nt_k32);}
                else if(ta&&!tb){BMMS22_LAUNCH(bmms22_sm_b16_tn_k32);}
                else if(ta&&tb){BMMS22_LAUNCH(bmms22_sm_b16_tt_k32);}
            }
        }
        else if(K==64){
            if(dtype==1){
                if(!ta&&!tb){BMMS22_LAUNCH(bmms22_sm_f16_nn_k64);}
                else if(!ta&&tb){BMMS22_LAUNCH(bmms22_sm_f16_nt_k64);}
                else if(ta&&!tb){BMMS22_LAUNCH(bmms22_sm_f16_tn_k64);}
                else if(ta&&tb){BMMS22_LAUNCH(bmms22_sm_f16_tt_k64);}
            }else{
                if(!ta&&!tb){BMMS22_LAUNCH(bmms22_sm_b16_nn_k64);}
                else if(!ta&&tb){BMMS22_LAUNCH(bmms22_sm_b16_nt_k64);}
                else if(ta&&!tb){BMMS22_LAUNCH(bmms22_sm_b16_tn_k64);}
                else if(ta&&tb){BMMS22_LAUNCH(bmms22_sm_b16_tt_k64);}
            }
        }
    }
    else if(selection.strategy==Strategy::Dense){
        if(K==32){
            if(dtype==1){
                if(!ta&&!tb){BMMS22_LAUNCH(bmms22_dn_f16_nn_k32);}
                else if(!ta&&tb){BMMS22_LAUNCH(bmms22_dn_f16_nt_k32);}
                else if(ta&&!tb){BMMS22_LAUNCH(bmms22_dn_f16_tn_k32);}
                else if(ta&&tb){BMMS22_LAUNCH(bmms22_dn_f16_tt_k32);}
            }else{
                if(!ta&&!tb){BMMS22_LAUNCH(bmms22_dn_b16_nn_k32);}
                else if(!ta&&tb){BMMS22_LAUNCH(bmms22_dn_b16_nt_k32);}
                else if(ta&&!tb){BMMS22_LAUNCH(bmms22_dn_b16_tn_k32);}
                else if(ta&&tb){BMMS22_LAUNCH(bmms22_dn_b16_tt_k32);}
            }
        }
        else if(K==64){
            if(dtype==1){
                if(!ta&&!tb){BMMS22_LAUNCH(bmms22_dn_f16_nn_k64);}
                else if(!ta&&tb){BMMS22_LAUNCH(bmms22_dn_f16_nt_k64);}
                else if(ta&&!tb){BMMS22_LAUNCH(bmms22_dn_f16_tn_k64);}
                else if(ta&&tb){BMMS22_LAUNCH(bmms22_dn_f16_tt_k64);}
            }else{
                if(!ta&&!tb){BMMS22_LAUNCH(bmms22_dn_b16_nn_k64);}
                else if(!ta&&tb){BMMS22_LAUNCH(bmms22_dn_b16_nt_k64);}
                else if(ta&&!tb){BMMS22_LAUNCH(bmms22_dn_b16_tn_k64);}
                else if(ta&&tb){BMMS22_LAUNCH(bmms22_dn_b16_tt_k64);}
            }
        }
        else if(K==128){
            if(dtype==1){
                if(!ta&&!tb){BMMS22_LAUNCH(bmms22_dn_f16_nn_k128);}
                else if(!ta&&tb){BMMS22_LAUNCH(bmms22_dn_f16_nt_k128);}
                else if(ta&&!tb){BMMS22_LAUNCH(bmms22_dn_f16_tn_k128);}
                else if(ta&&tb){BMMS22_LAUNCH(bmms22_dn_f16_tt_k128);}
            }else{
                if(!ta&&!tb){BMMS22_LAUNCH(bmms22_dn_b16_nn_k128);}
                else if(!ta&&tb){BMMS22_LAUNCH(bmms22_dn_b16_nt_k128);}
                else if(ta&&!tb){BMMS22_LAUNCH(bmms22_dn_b16_tn_k128);}
                else if(ta&&tb){BMMS22_LAUNCH(bmms22_dn_b16_tt_k128);}
            }
        }
    }
#undef BMMS22_LAUNCH
    if(aclrtSynchronizeStream(stream)!=ACL_SUCCESS)std::abort();
    if(aclrtFree(ws)!=ACL_SUCCESS)std::abort();return true;
}
} // namespace bmms22
