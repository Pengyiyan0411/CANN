    // Public only so the source CPU harness can also exercise the reduction stage in isolation.
    __aicore__ inline void FinishReduction(){
        const int worker=AscendC::GetBlockIdx();
        auto merged=mergedBuf.Get<float>(),tmp=tmpBuf.Get<float>();
        const bool parallelMerge=p.pN>=4&&p.M>=1024;
        const int64_t scratchBase=int64_t(p.B)*p.pN*p.M;
        if(parallelMerge){
            const int chunks=(p.M+AM-1)/AM;
            auto accum=runningBuf.Get<float>();
            for(int job=worker;job<p.B*chunks;job+=2*p.blocks){
                const int batch=job/chunks,row=(job%chunks)*AM,mr=MinI(AM,p.M-row);
                const int64_t start=int64_t(batch)*p.pN*p.M+row;
                AscendC::DataCopyExtParams cp{1,uint32_t(mr*4),0,0,0};
                AscendC::DataCopyPadExtParams<float> pad{false,0,0,0.0f};
                AscendC::DataCopyPad(merged,part[start],cp,pad);
                bmms71::Fence<AscendC::HardEvent::MTE2_V>(*pipe_);
                for(int ns=1;ns<p.pN;++ns){
                    AscendC::DataCopyPad(tmp,part[start+int64_t(ns)*p.M],cp,pad);
                    bmms71::Fence<AscendC::HardEvent::MTE2_V>(*pipe_);
                    if(ns==1)AscendC::Max(accum,merged,tmp,mr);
                    else AscendC::Max(accum,accum,tmp,mr);
                    bmms71::Fence<AscendC::HardEvent::V_MTE2>(*pipe_);
                }
                bmms71::Fence<AscendC::HardEvent::V_MTE3>(*pipe_);
                AscendC::DataCopyPad(part[scratchBase+int64_t(batch)*p.M+row],accum,cp);
                bmms71::Fence<AscendC::HardEvent::MTE3_V>(*pipe_);
            }
            // All AIVs participate, including workers with no row chunk.
            bmms71::Fence<AscendC::HardEvent::MTE3_MTE2>(*pipe_);
            AscendC::SyncAll<true>(); // MERGE_COMPLETE_BARRIER
        }
        for(int batch=worker;batch<p.B;batch+=2*p.blocks){
            const int64_t start=parallelMerge?scratchBase+int64_t(batch)*p.M:int64_t(batch)*p.pN*p.M;
            AscendC::DataCopy(merged,part[start],p.M);bmms71::Fence<AscendC::HardEvent::MTE2_V>(*pipe_);
            if(!parallelMerge)for(int ns=1;ns<p.pN;++ns){
                AscendC::DataCopy(tmp,part[start+int64_t(ns)*p.M],p.M);bmms71::Fence<AscendC::HardEvent::MTE2_V>(*pipe_);
                AscendC::Max(merged,merged,tmp,p.M);bmms71::Fence<AscendC::HardEvent::V_MTE2>(*pipe_);
            }
            // Keep the original full-M ReduceSum and its input order; never sum per chunk.
            auto yy=oq.AllocTensor<float>();AscendC::ReduceSum(yy,merged,sumBuf.Get<float>(),p.M);
            oq.EnQue(yy);yy=oq.DeQue<float>();AscendC::DataCopyExtParams oc{1,4,0,0,0};
            AscendC::DataCopyPad(out[batch],yy,oc);oq.FreeTensor(yy);bmms71::Fence<AscendC::HardEvent::V_MTE2>(*pipe_);
        }
    }

