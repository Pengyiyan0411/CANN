std::string reductionChecks(){
    int checked=0,parallelCases=0;uint64_t maxPeak=0;std::ostringstream details;
    for(int rev=0;rev<2;++rev)for(auto d:std::vector<std::array<int,4>>{
#if defined(NEGATIVE_MERGE_BARRIER) || defined(NEGATIVE_MERGE_SHARD)
        {1,1024,4,20}
#else
        {1,1024,4,20},{3,1040,4,20},{1,8192,16,64},{64,1024,4,64},
        {3,2048,8,7},{1,1024,32,32},{1,1008,4,20},{1,1024,3,20},
        {1,144,1,1},{3,1040,2,7},{1,2048,4,1}
#endif
    }){
        auto[B,M,pn,cores]=d;
        bmms11r2::Plan p{};p.B=B;p.M=M;p.N=pn*256;p.K=256;
        p.mTiles=(M+127)/128;p.nTiles=pn;p.pN=pn;
        p.pM=std::min(p.mTiles,std::max(1,cores/(B*pn)));
        p.tasks=B*p.pM*p.pN;p.blocks=std::min(cores,p.tasks);
        const size_t oldCount=size_t(B)*pn*M;
        std::vector<float> part(bmms11r2::PartialBytes(p)/4,NAN),ring(bmms11r2::RingBytes(p)/4,NAN),y(B,NAN);
        std::vector<double> gold(B,0);
        for(int b=0;b<B;++b)for(int m=0;m<M;++m){
            float row=-INFINITY;
            for(int ns=0;ns<pn;++ns){
                float value=(ns+1)*0.125f+(m%31)*0.03125f+(b%7)*0.015625f;
                if(rev)value-=8.0f;
                part[(size_t(b)*pn+ns)*M+m]=value;row=std::max(row,value);
            }
            gold[b]+=row;
        }
        auto before=part;
        Mock::Context ctx(2*p.blocks);ctx.add(ring.data(),ring.size()*4,false);
        ctx.add(part.data(),part.size()*4,false);ctx.add(y.data(),y.size()*4,false);
        auto region=ctx.locate((uintptr_t)part.data(),part.size()*4);
        for(size_t i=0;i<oldCount;++i)region->writer[i]=1000;
        ReductionAudit::State state(part.data(),B,M,pn,2*p.blocks,HAS_MERGE_SCRATCH);
        ReductionAudit::active=&state;
        workers(2*p.blocks,ctx,[&](int w){
            Mock::cube=false;
            AscendC::TPipe pipe;bmms11r2::RowMaxConsumer op;
            op.Init(reinterpret_cast<GM_ADDR>(ring.data()),reinterpret_cast<GM_ADDR>(part.data()),
                    reinterpret_cast<GM_ADDR>(y.data()),p,&pipe);
            // Emulate the real first phase's completed publication barrier.
            AscendC::SyncAll<true>();op.FinishReduction();
        },rev);
        ReductionAudit::active=nullptr;
        const bool parallel=HAS_MERGE_SCRATCH&&pn>=4&&M>=1024;
        state.check(parallel);
        Mock::need(std::memcmp(part.data(),before.data(),oldCount*4)==0,"original N shards overwritten");
        for(int b=0;b<B;++b)Mock::need(std::bit_cast<uint32_t>(y[b])==std::bit_cast<uint32_t>(float(gold[b])),
            "N-merge reference mismatch");
        Mock::need(ctx.barrier.generation==(parallel?2:1),"unexpected barrier count");
        uint64_t totalReads=0,totalWrites=0;
        for(int w=0;w<2*p.blocks;++w){totalReads+=state.originalReads[w]+state.scratchReads[w];totalWrites+=state.scratchWrites[w];}
        Mock::need(totalReads==oldCount+(parallel?size_t(B)*M:0),"wrong reduction input traffic");
        if(checked++)details<<",";if(parallel)++parallelCases;
        details<<"{\"B\":"<<B<<",\"M\":"<<M<<",\"pN\":"<<pn<<",\"blocks\":"<<p.blocks
            <<",\"reverse\":"<<rev<<",\"parallel\":"<<(parallel?"true":"false")
            <<",\"peak_read_elements\":"<<state.peakReads()<<",\"total_read_elements\":"<<totalReads
            <<",\"scratch_write_elements\":"<<totalWrites<<",\"barriers\":"<<ctx.barrier.generation<<"}";
        maxPeak=std::max(maxPeak,state.peakReads());
    }
    return std::string("{\"checked\":")+std::to_string(checked)+",\"parallel_cases\":"+
        std::to_string(parallelCases)+",\"fixtures\":["+details.str()+"]}";
}
