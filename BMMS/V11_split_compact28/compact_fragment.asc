
// BMMS28_BEGIN: compact epilogue for single-spatial, small-output, long-K plans.
namespace bmms28 {
using Plan=bmms23::Plan;
constexpr int32_t TM=bmms23::TM,TN=bmms23::TN,KB=bmms23::KB;
// Keep R23's maximum input merge allocation, not a new hardware UB assumption.
constexpr int32_t MERGE_FLOATS=bmms23::MAX_SPLITS*bmms23::ROWS*bmms23::TN;
constexpr uint16_t READY=bmms23::READY;
static inline bool Eligible(int B,int M,int N,int K,int dtype,int cores){
    if(!bmms23::Eligible(B,M,N,K,dtype,cores))return false;
    if(B!=1||M>64||N>128||int64_t(M)*N>4096)return false;
    return bmms23::MakePlan(B,M,N,K,cores).splits>=8;
}
template<class T,bool TA,bool TB>
class Producer {
    AscendC::TPipe* pipe_;Plan p;
    AscendC::GlobalTensor<T> a,b;
    AscendC::GlobalTensor<float> ring;
    AscendC::TBuf<AscendC::TPosition::A1> a1Buf;
    AscendC::TBuf<AscendC::TPosition::B1> b1Buf;
    AscendC::TBuf<AscendC::TPosition::A2> a2Buf;
    AscendC::TBuf<AscendC::TPosition::B2> b2Buf;
    AscendC::TBuf<AscendC::TPosition::CO1> cBuf;
    AscendC::TEventID l1Ready[2],l1Free[2],l0Ready[2],l0Free[2],cReady,cFree;

    // Compact ND2NZ tiles use their actual kr/mr/nr extents; each ping-pong
    // slot still reserves the maximum KB tile size. K tail stays a multiple
    // of 32: 32/64 for KB64; 32/64/96/128 for KB128.
    __aicore__ inline void LoadStage(int batch,int m0,int n0,int mr,int nr,int k0,int kr,int stage){
        auto dstA=a1Buf.template Get<T>()[stage*TM*KB];
        auto dstB=b1Buf.template Get<T>()[stage*KB*TN];
        AscendC::Nd2NzParams qa{};qa.ndNum=1;
        qa.nValue=TA?kr:mr;qa.dValue=TA?mr:kr;
        qa.srcDValue=TA?p.M:p.K;qa.dstNzC0Stride=TA?kr:mr;qa.dstNzNStride=1;
        const int64_t offA=int64_t(batch)*p.M*p.K+
            (TA?int64_t(k0)*p.M+m0:int64_t(m0)*p.K+k0);
        AscendC::DataCopy(dstA,a[offA],qa);

        AscendC::Nd2NzParams qb{};qb.ndNum=1;
        qb.nValue=TB?nr:kr;qb.dValue=TB?kr:nr;
        qb.srcDValue=TB?p.K:p.N;qb.dstNzC0Stride=TB?nr:kr;qb.dstNzNStride=1;
        const int64_t offB=int64_t(batch)*p.K*p.N+
            (TB?int64_t(n0)*p.K+k0:int64_t(k0)*p.N+n0);
        AscendC::DataCopy(dstB,b[offB],qb);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1Ready[stage]);
    }

    __aicore__ inline void LoadL0(int mr,int nr,int kr,int stage){
        auto srcA=a1Buf.template Get<T>()[stage*TM*KB];
        auto srcB=b1Buf.template Get<T>()[stage*KB*TN];
        auto dstA=a2Buf.template Get<T>()[stage*TM*KB];
        auto dstB=b2Buf.template Get<T>()[stage*KB*TN];
        AscendC::LoadData2DParams la{};la.repeatTimes=kr/16;
        la.srcStride=TA?1:mr/16;la.ifTranspose=TA;
        for(int i=0;i<mr/16;++i){
            const int off=TA?i*kr*16:i*256;
            AscendC::LoadData(dstA[i*kr*16],srcA[off],la);
        }
        AscendC::LoadData2DParams lb{};lb.repeatTimes=nr/16;
        lb.srcStride=TB?1:kr/16;lb.ifTranspose=!TB;
        for(int j=0;j<kr/16;++j){
            const int off=TB?j*nr*16:j*256;
            AscendC::LoadData(dstB[j*nr*16],srcB[off],lb);
        }
        // Input L1 slot may be overwritten only after both LoadData streams.
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1Free[stage]);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(l0Ready[stage]);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(l0Ready[stage]);
    }

    __aicore__ inline void Emit(int group,int batch,int m0,int n0,int mr,int nr,int kBegin,int kEnd){
        const int kCount=(kEnd-kBegin+KB-1)/KB;
        LoadStage(batch,m0,n0,mr,nr,kBegin,bmms83::MinI(KB,kEnd-kBegin),0);
        auto cc=cBuf.template Get<float>();
        for(int ki=0;ki<kCount;++ki){
            const int stage=ki&1,k0=kBegin+ki*KB,kr=bmms83::MinI(KB,kEnd-k0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1Ready[stage]);
            if(ki+1<kCount){
                const int next=stage^1,nextK=kBegin+(ki+1)*KB;
                if(ki>=1)AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1Free[next]);
                LoadStage(batch,m0,n0,mr,nr,nextK,bmms83::MinI(KB,kEnd-nextK),next);
            }
            if(ki>=2)AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0Free[stage]);
            LoadL0(mr,nr,kr,stage);
            auto aa=a2Buf.template Get<T>()[stage*TM*KB];
            auto bb=b2Buf.template Get<T>()[stage*KB*TN];
            AscendC::MmadParams q{};q.m=mr;q.n=nr;q.k=kr;q.cmatrixInitVal=(ki==0);
            AscendC::Mmad(cc,aa,bb,q);
            // Official Mmad dependency for small output tiles, also used by R01.
            if((mr/16)*(nr/16)<10)AscendC::PipeBarrier<PIPE_M>();
            AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0Free[stage]);
        }
        // Drain exactly the outstanding credits, leaving all input slots
        // empty before the next output tile starts its own staged K loop.
        for(int stage=0;stage<bmms83::MinI(2,kCount);++stage){
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1Free[stage]);
            AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0Free[stage]);
        }
        AscendC::SetFlag<AscendC::HardEvent::M_FIX>(cReady);
        AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(cReady);
        AscendC::FixpipeParamsV220 f{};f.nSize=nr;f.mSize=mr;f.srcStride=mr;
        f.dstStride=p.N;f.ndNum=1;f.quantPre=QuantMode_t::NoQuant;
        AscendC::Fixpipe<float,float>(ring[int64_t(group)*TM*TN],cc,f);
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree);
        AscendC::CrossCoreSetFlag<0x2,PIPE_FIX>(READY);
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree);
    }

public:
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR z,GM_ADDR r,const Plan& plan,AscendC::TPipe* pipe){
        p=plan;pipe_=pipe;
        for(int s=0;s<2;++s){
            l1Ready[s]=pipe_->AllocEventID<AscendC::HardEvent::MTE2_MTE1>();
            l1Free[s]=pipe_->AllocEventID<AscendC::HardEvent::MTE1_MTE2>();
            l0Ready[s]=pipe_->AllocEventID<AscendC::HardEvent::MTE1_M>();
            l0Free[s]=pipe_->AllocEventID<AscendC::HardEvent::M_MTE1>();
        }
        cReady=pipe_->AllocEventID<AscendC::HardEvent::M_FIX>();
        cFree=pipe_->AllocEventID<AscendC::HardEvent::FIX_M>();
        a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x),int64_t(p.B)*p.M*p.K);
        b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z),int64_t(p.B)*p.K*p.N);
        ring.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(r),int64_t(p.blocks)*TM*TN);
        pipe->InitBuffer(a1Buf,2*TM*KB*sizeof(T));pipe->InitBuffer(b1Buf,2*KB*TN*sizeof(T));
        pipe->InitBuffer(a2Buf,2*TM*KB*sizeof(T));pipe->InitBuffer(b2Buf,2*KB*TN*sizeof(T));
        pipe->InitBuffer(cBuf,TM*TN*sizeof(float));
    }

    __aicore__ inline void Process(){
        const int group=AscendC::GetBlockIdx(),ks=group%p.splits,tile=group/p.splits;
        const int nt=tile%p.nTiles,mt=(tile/p.nTiles)%p.mTiles,batch=tile/(p.mTiles*p.nTiles);
        const int m0=mt*TM,n0=nt*TN;
        const int units=p.K/32,kBegin=(ks*units/p.splits)*32,kEnd=((ks+1)*units/p.splits)*32;
        Emit(group,batch,m0,n0,bmms83::MinI(TM,p.M-m0),bmms83::MinI(TN,p.N-n0),kBegin,kEnd);
        for(int s=0;s<2;++s){
            pipe_->ReleaseEventID<AscendC::HardEvent::MTE2_MTE1>(l1Ready[s]);
            pipe_->ReleaseEventID<AscendC::HardEvent::MTE1_MTE2>(l1Free[s]);
            pipe_->ReleaseEventID<AscendC::HardEvent::MTE1_M>(l0Ready[s]);
            pipe_->ReleaseEventID<AscendC::HardEvent::M_MTE1>(l0Free[s]);
        }
        pipe_->ReleaseEventID<AscendC::HardEvent::M_FIX>(cReady);
        pipe_->ReleaseEventID<AscendC::HardEvent::FIX_M>(cFree);
    }
};

// Same K tree and row reductions as R23, with compact-N partials and one DMA
// per row stripe across all K shards. Only one spatial tile is admitted.
class Consumer {
    Plan p;AscendC::TPipe* pipe_;int32_t stripeRows;
    AscendC::GlobalTensor<float> partial,out;
    AscendC::TBuf<AscendC::TPosition::VECIN> inBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> rowsBuf,runBuf,sumBuf;
    AscendC::TQue<AscendC::TPosition::VECOUT,1> oq;
public:
    __aicore__ inline void Init(GM_ADDR ws,GM_ADDR y,const Plan& plan,AscendC::TPipe* pipe){
        p=plan;pipe_=pipe;
        stripeRows=bmms83::MinI(p.M,(MERGE_FLOATS/p.splits/p.N/16)*16);
        partial.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ws),int64_t(p.blocks)*TM*TN);
        out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y),p.B);
        pipe->InitBuffer(inBuf,p.splits*stripeRows*p.N*sizeof(float));
        pipe->InitBuffer(rowsBuf,stripeRows*sizeof(float));
        pipe->InitBuffer(runBuf,p.M*sizeof(float));pipe->InitBuffer(sumBuf,p.M*sizeof(float));
        pipe->InitBuffer(oq,1,32);
    }
    __aicore__ inline void Process(){
        // All AIV participants retain the original publication protocol.
        AscendC::CrossCoreWaitFlag<0x2>(READY);
        AscendC::SyncAll<true>();
        if(AscendC::GetBlockIdx()!=0)return;
        auto values=inBuf.Get<float>(),rows=rowsBuf.Get<float>(),run=runBuf.Get<float>();
        AscendC::Duplicate(run,bmmmaxsum_v43::NEG_INF,p.M);AscendC::PipeBarrier<PIPE_V>();
        for(int m0=0;m0<p.M;m0+=stripeRows){
            const int mr=bmms83::MinI(stripeRows,p.M-m0),cells=mr*p.N;
            bmms71::Fence<AscendC::HardEvent::V_MTE2>(*pipe_);
            // Each shard keeps its original 64x128 GM reservation; only its
            // MxN prefix is written. Read valid contiguous rows from every slot.
            AscendC::DataCopyExtParams cp{uint16_t(p.splits),uint32_t(cells*4),uint32_t((TM*TN-cells)*4),0,0};
            AscendC::DataCopyPadExtParams<float> np{false,0,0,0.0f};
            AscendC::DataCopyPad(values,partial[int64_t(m0)*p.N],cp,np);
            bmms71::Fence<AscendC::HardEvent::MTE2_V>(*pipe_);
            for(int width=p.splits;width>1;width/=2){
                const int count=(width/2)*cells;
                AscendC::Add(values,values,values[count],count);AscendC::PipeBarrier<PIPE_V>();
            }
            if(p.N>64){
                AscendC::BinaryRepeatParams rp{1,1,1,uint8_t(p.N/8),uint8_t(p.N/8),uint8_t(p.N/8)};
                AscendC::Max(values,values,values[64],p.N-64,mr,rp);AscendC::PipeBarrier<PIPE_V>();
            }
            AscendC::WholeReduceMax(rows,values,bmms83::MinI(p.N,64),mr,1,1,p.N/8,AscendC::ReduceOrder::ORDER_ONLY_VALUE);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Max(run[m0],run[m0],rows,mr);AscendC::PipeBarrier<PIPE_V>();
        }
        auto result=oq.AllocTensor<float>();
        AscendC::ReduceSum(result,run,sumBuf.Get<float>(),p.M);AscendC::PipeBarrier<PIPE_V>();
        oq.EnQue(result);result=oq.DeQue<float>();
        AscendC::DataCopyExtParams cp{1,4,0,0,0};AscendC::DataCopyPad(out[0],result,cp);oq.FreeTensor(result);
    }
};

#ifndef BMMS28_CPU_TEST
template<class T,bool TA,bool TB>
__aicore__ inline void Entry(GM_ADDR a,GM_ADDR b,GM_ADDR y,GM_ADDR ws,Plan p){
    AscendC::TPipe pipe;
    if ASCEND_IS_AIC {Producer<T,TA,TB> op;op.Init(a,b,ws,p,&pipe);op.Process();}
    if ASCEND_IS_AIV {Consumer op;op.Init(ws,y,p,&pipe);op.Process();}
}
#endif
} // namespace bmms28
// BMMS28_CPU_EXTRACT_END
#define BMMS28_KERNEL(NAME,T,TA,TB) \
__schedmode__(1) __global__ __mix__(1,2) void NAME(GM_ADDR a,GM_ADDR b,GM_ADDR y,GM_ADDR ws,bmms23::Plan p){bmms28::Entry<T,TA,TB>(a,b,y,ws,p);}
BMMS28_KERNEL(bmms28_f16_nn,half,false,false)
BMMS28_KERNEL(bmms28_f16_nt,half,false,true)
BMMS28_KERNEL(bmms28_f16_tn,half,true,false)
BMMS28_KERNEL(bmms28_f16_tt,half,true,true)
BMMS28_KERNEL(bmms28_b16_nn,bfloat16_t,false,false)
BMMS28_KERNEL(bmms28_b16_nt,bfloat16_t,false,true)
BMMS28_KERNEL(bmms28_b16_tn,bfloat16_t,true,false)
BMMS28_KERNEL(bmms28_b16_tt,bfloat16_t,true,true)
#undef BMMS28_KERNEL
namespace bmms28 {
static inline bool TryLaunch(GM_ADDR a,GM_ADDR b,GM_ADDR y,int B,int M,int N,int K,int dtype,bool ta,bool tb,int cores,aclrtStream stream){
    if(!Eligible(B,M,N,K,dtype,cores))return false;
    Plan p=bmms23::MakePlan(B,M,N,K,cores);
    uint8_t* ws=nullptr;
    if(aclrtMalloc(reinterpret_cast<void**>(&ws),bmms23::WorkspaceBytes(p),ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)std::abort();
#define BMMS28_LAUNCH(NAME) NAME<<<p.blocks,nullptr,stream>>>(a,b,y,ws,p)
    if(dtype==1){
        if(!ta&&!tb){BMMS28_LAUNCH(bmms28_f16_nn);}else if(!ta&&tb){BMMS28_LAUNCH(bmms28_f16_nt);}
        else if(ta&&!tb){BMMS28_LAUNCH(bmms28_f16_tn);}else{BMMS28_LAUNCH(bmms28_f16_tt);}
    }else{
        if(!ta&&!tb){BMMS28_LAUNCH(bmms28_b16_nn);}else if(!ta&&tb){BMMS28_LAUNCH(bmms28_b16_nt);}
        else if(ta&&!tb){BMMS28_LAUNCH(bmms28_b16_tn);}else{BMMS28_LAUNCH(bmms28_b16_tt);}
    }
#undef BMMS28_LAUNCH
    if(aclrtSynchronizeStream(stream)!=ACL_SUCCESS)std::abort();
    if(aclrtFree(ws)!=ACL_SUCCESS)std::abort();return true;
}
} // namespace bmms28
// BMMS28_END

