// Each batch has one AIV owner: merge all K partials, then N max, then M sum.
// This needs only the initial publication barrier, and no inter-AIV result merge.
class Consumer {
    Plan p;AscendC::TPipe* pipe_;
    AscendC::GlobalTensor<float> partial,out;
    AscendC::TBuf<AscendC::TPosition::VECIN> inBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> rowsBuf,runBuf,sumBuf;
    AscendC::TQue<AscendC::TPosition::VECOUT,1> oq;
public:
    __aicore__ inline void Init(GM_ADDR ws,GM_ADDR y,const Plan& plan,AscendC::TPipe* pipe){
        p=plan;pipe_=pipe;
        partial.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ws),int64_t(p.blocks)*TM*TN);
        out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y),p.B);
        pipe->InitBuffer(inBuf,p.splits*ROWS*TN*sizeof(float));
        pipe->InitBuffer(rowsBuf,ROWS*sizeof(float));pipe->InitBuffer(runBuf,p.M*sizeof(float));
        pipe->InitBuffer(sumBuf,p.M*sizeof(float));pipe->InitBuffer(oq,1,32);
    }
    __aicore__ inline void Process(){
        const int worker=AscendC::GetBlockIdx();
        // First wait for this group's Fixpipe. All AIVs then propagate that
        // publication through one vector-only global barrier before remote reads.
        AscendC::CrossCoreWaitFlag<0x2>(READY);
        AscendC::SyncAll<true>();
        auto values=inBuf.Get<float>(),rows=rowsBuf.Get<float>(),run=runBuf.Get<float>();
        for(int batch=worker;batch<p.B;batch+=2*p.blocks){
            AscendC::Duplicate(run,bmmmaxsum_v43::NEG_INF,p.M);AscendC::PipeBarrier<PIPE_V>();
            for(int m0=0;m0<p.M;m0+=ROWS){
                const int mt=m0/TM,localM=m0%TM;
                for(int nt=0;nt<p.nTiles;++nt){
                    const int nr=bmms83::MinI(TN,p.N-nt*TN);
                    // Tail columns are zero during K summation, and are excluded
                    // from the later N reduction. Never read uninitialized GM padding.
                    if(nr<TN){AscendC::Duplicate(values,0.0f,p.splits*ROWS*TN);AscendC::PipeBarrier<PIPE_V>();}
                    bmms71::Fence<AscendC::HardEvent::V_MTE2>(*pipe_);
                    const int tile=(batch*p.mTiles+mt)*p.nTiles+nt;
                    AscendC::DataCopyExtParams cp{uint16_t(ROWS),uint32_t(nr*4),uint32_t((TN-nr)*4),uint32_t((TN-nr)/8),0};
                    AscendC::DataCopyPadExtParams<float> np{false,0,0,0.0f};
                    for(int ks=0;ks<p.splits;++ks){
                        const int64_t src=int64_t(tile*p.splits+ks)*TM*TN+localM*TN;
                        AscendC::DataCopyPad(values[ks*ROWS*TN],partial[src],cp,np);
                    }
                    bmms71::Fence<AscendC::HardEvent::MTE2_V>(*pipe_);
                    // Fixed reduction tree. No atomics, and no max of K fragments.
                    for(int width=p.splits;width>1;width/=2){
                        const int count=(width/2)*ROWS*TN;
                        AscendC::Add(values,values,values[count],count);AscendC::PipeBarrier<PIPE_V>();
                    }
                    if(nr>64){
                        AscendC::BinaryRepeatParams rp{1,1,1,TN/8,TN/8,TN/8};
                        AscendC::Max(values,values,values[64],nr-64,ROWS,rp);AscendC::PipeBarrier<PIPE_V>();
                    }
                    AscendC::WholeReduceMax(rows,values,bmms83::MinI(nr,64),ROWS,1,1,TN/8,AscendC::ReduceOrder::ORDER_ONLY_VALUE);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::Max(run[m0],run[m0],rows,ROWS);AscendC::PipeBarrier<PIPE_V>();
                }
            }
            auto result=oq.AllocTensor<float>();
            AscendC::ReduceSum(result,run,sumBuf.Get<float>(),p.M);AscendC::PipeBarrier<PIPE_V>();
            oq.EnQue(result);result=oq.DeQue<float>();
            AscendC::DataCopyExtParams cp{1,4,0,0,0};AscendC::DataCopyPad(out[batch],result,cp);oq.FreeTensor(result);
        }
    }
};

