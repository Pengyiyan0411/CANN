constexpr int32_t TM=64,TN=128,KB=128,ROWS=16,MAX_SPLITS=16;
constexpr uint16_t READY=4;
struct Plan {int32_t B,M,N,K,mTiles,nTiles,splits,blocks;};
static inline int32_t MinH(int32_t a,int32_t b){return a<b?a:b;}
static inline Plan MakePlan(int B,int M,int N,int K,int cores){
    Plan p{B,M,N,K,(M+TM-1)/TM,(N+TN-1)/TN,1,0};
    const int spatial=B*p.mTiles*p.nTiles;
    // All tasks must be simultaneously resident before the AIV publication barrier.
    const int cap=MinH(MAX_SPLITS,MinH(cores/spatial,K/512));
    while(2*p.splits<=cap)p.splits*=2;
    p.blocks=spatial*p.splits;return p;
}
static inline bool Eligible(int B,int M,int N,int K,int dtype,int cores){
    if((dtype!=1&&dtype!=2)||B<1||B>64||cores<1||cores>64||
       M<16||M>=128||N<16||N>=256||M%16||N%16||
       K<4096||K>8192||K%32)return false;
    return MakePlan(B,M,N,K,cores).splits>=2;
}
static inline uint64_t WorkspaceBytes(const Plan& p){return uint64_t(p.blocks)*TM*TN*sizeof(float);}

