template<class T,bool TA,bool TB>
class Producer {
    AscendC::TPipe* pipe_;Plan p;int ks,kBegin,kr,kStep;
    AscendC::GlobalTensor<T> a,b;
    AscendC::GlobalTensor<float> ring;
    AscendC::TBuf<AscendC::TPosition::A1> a1Buf;
    AscendC::TBuf<AscendC::TPosition::B1> b1Buf;
    AscendC::TBuf<AscendC::TPosition::A2> a2Buf;
    AscendC::TBuf<AscendC::TPosition::B2> b2Buf;
    AscendC::TBuf<AscendC::TPosition::CO1> cBuf;
    AscendC::TEventID l1Ready,l0Ready,l0Free,cReady,cFree;
public:
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR z,GM_ADDR r,const Plan& plan,AscendC::TPipe* pipe){
        p=plan;pipe_=pipe;ks=AscendC::GetBlockIdx();
        const int units=p.K/32;kBegin=(ks*units/p.splits)*32;
        kr=((ks+1)*units/p.splits)*32-kBegin;
        // Each complete L0 operand fits 64 KiB. No ping-pong aliasing;
        // reuse is explicitly fenced M -> MTE1 before the next chunk.
        kStep=bmms83::MinI(512,bmms83::MinI(32768/p.M,32768/p.N)/32*32);
        l1Ready=pipe_->AllocEventID<AscendC::HardEvent::MTE2_MTE1>();
        l0Ready=pipe_->AllocEventID<AscendC::HardEvent::MTE1_M>();
        l0Free=pipe_->AllocEventID<AscendC::HardEvent::M_MTE1>();
        cReady=pipe_->AllocEventID<AscendC::HardEvent::M_FIX>();
        cFree=pipe_->AllocEventID<AscendC::HardEvent::FIX_M>();
        a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x),int64_t(p.M)*p.K);
        b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z),int64_t(p.K)*p.N);
        ring.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(r),int64_t(p.blocks)*TM*TN);
        // kr <= 1024 in this guard; combined L1 allocation <= 320 KiB.
        pipe->InitBuffer(a1Buf,p.M*kr*sizeof(T));pipe->InitBuffer(b1Buf,kr*p.N*sizeof(T));
        pipe->InitBuffer(a2Buf,p.M*kStep*sizeof(T));pipe->InitBuffer(b2Buf,kStep*p.N*sizeof(T));
        pipe->InitBuffer(cBuf,p.M*p.N*sizeof(float));
    }
    __aicore__ inline void Process(){
        auto ax=a1Buf.template Get<T>(),bx=b1Buf.template Get<T>();
        AscendC::Nd2NzParams qa{};qa.ndNum=1;
        qa.nValue=TA?kr:p.M;qa.dValue=TA?p.M:kr;
        qa.srcDValue=TA?p.M:p.K;qa.dstNzC0Stride=TA?kr:p.M;qa.dstNzNStride=1;
        AscendC::DataCopy(ax,a[TA?int64_t(kBegin)*p.M:kBegin],qa);
        AscendC::Nd2NzParams qb{};qb.ndNum=1;
        qb.nValue=TB?p.N:kr;qb.dValue=TB?kr:p.N;
        qb.srcDValue=TB?p.K:p.N;qb.dstNzC0Stride=TB?p.N:kr;qb.dstNzNStride=1;
        AscendC::DataCopy(bx,b[TB?kBegin:int64_t(kBegin)*p.N],qb);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1Ready);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1Ready);
        auto aa=a2Buf.template Get<T>(),bb=b2Buf.template Get<T>();
        auto cc=cBuf.template Get<float>();
        for(int kk=0;kk<kr;kk+=kStep){
            const int kc=bmms83::MinI(kStep,kr-kk);
            if(kk)AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0Free);
            AscendC::LoadData2DParams la{};la.repeatTimes=kc/16;
            la.srcStride=TA?1:p.M/16;la.ifTranspose=TA;
            for(int i=0;i<p.M/16;++i){
                const int off=TA?i*kr*16+kk*16:i*256+kk*p.M;
                AscendC::LoadData(aa[i*kc*16],ax[off],la);
            }
            AscendC::LoadData2DParams lb{};lb.repeatTimes=p.N/16;
            lb.srcStride=TB?1:kr/16;lb.ifTranspose=!TB;
            for(int j=0;j<kc/16;++j){
                const int off=TB?(kk/16+j)*p.N*16:(kk/16+j)*256;
                AscendC::LoadData(bb[j*p.N*16],bx[off],lb);
            }
            AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(l0Ready);
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(l0Ready);
            AscendC::MmadParams q{};q.m=p.M;q.n=p.N;q.k=kc;q.cmatrixInitVal=(kk==0);
            AscendC::Mmad(cc,aa,bb,q);
            if((p.M/16)*(p.N/16)<10)AscendC::PipeBarrier<PIPE_M>();
            AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0Free);
        }
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0Free);
        AscendC::SetFlag<AscendC::HardEvent::M_FIX>(cReady);
        AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(cReady);
        AscendC::FixpipeParamsV220 f{};f.nSize=p.N;f.mSize=p.M;f.srcStride=p.M;
        f.dstStride=TN;f.ndNum=1;f.quantPre=QuantMode_t::NoQuant;
        AscendC::Fixpipe<float,float>(ring[int64_t(ks)*TM*TN],cc,f);
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree);
        AscendC::CrossCoreSetFlag<0x2,PIPE_FIX>(READY);
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree);
        pipe_->ReleaseEventID<AscendC::HardEvent::MTE2_MTE1>(l1Ready);
        pipe_->ReleaseEventID<AscendC::HardEvent::MTE1_M>(l0Ready);
        pipe_->ReleaseEventID<AscendC::HardEvent::M_MTE1>(l0Free);
        pipe_->ReleaseEventID<AscendC::HardEvent::M_FIX>(cReady);
        pipe_->ReleaseEventID<AscendC::HardEvent::FIX_M>(cFree);
    }
};

