// Each active AIV owns 8 entire rows, including all K splits and all real N.
// No partial maxima across K. The second barrier publishes completed row maxima.
class Consumer {
    Plan p;AscendC::TPipe* pipe_;
    AscendC::GlobalTensor<float> partial,rowMax,out;
    AscendC::TBuf<AscendC::TPosition::VECIN> inBuf,allRowsBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> scratchBuf;
    AscendC::TQue<AscendC::TPosition::VECOUT,1> oq;
public:
    __aicore__ inline void Init(GM_ADDR ws,GM_ADDR y,const Plan& plan,AscendC::TPipe* pipe){
        p=plan;pipe_=pipe;
        partial.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ws),int64_t(p.blocks)*TM*TN);
        rowMax.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ws)+int64_t(p.blocks)*TM*TN,p.M);
        out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y),1);
        pipe->InitBuffer(inBuf,p.splits*ROWS*p.N*sizeof(float));
        pipe->InitBuffer(allRowsBuf,p.M*sizeof(float));
        pipe->InitBuffer(scratchBuf,p.M*sizeof(float));pipe->InitBuffer(oq,1,32);
    }
    __aicore__ inline void Process(){
        const int worker=AscendC::GetBlockIdx();
        AscendC::CrossCoreWaitFlag<0x2>(READY);
        AscendC::SyncAll<true>();
        if(worker<p.M/ROWS){
            const int cells=ROWS*p.N,m0=worker*ROWS;
            auto values=inBuf.Get<float>();
            // One strided transfer gathers this owner's rows from every K slot.
            // Fixpipe writes compact N within the original 64x128 reservation.
            AscendC::DataCopyExtParams cp{uint16_t(p.splits),uint32_t(cells*4),uint32_t((TM*TN-cells)*4),0,0};
            AscendC::DataCopyPadExtParams<float> np{false,0,0,0.0f};
            AscendC::DataCopyPad(values,partial[m0*p.N],cp,np);
            bmms71::Fence<AscendC::HardEvent::MTE2_V>(*pipe_);
            for(int width=p.splits;width>1;width/=2){
                const int count=(width/2)*cells;
                AscendC::Add(values,values,values[count],count);AscendC::PipeBarrier<PIPE_V>();
            }
            if(p.N>64){
                AscendC::BinaryRepeatParams rp{1,1,1,uint8_t(p.N/8),uint8_t(p.N/8),uint8_t(p.N/8)};
                AscendC::Max(values,values,values[64],p.N-64,ROWS,rp);AscendC::PipeBarrier<PIPE_V>();
            }
            auto result=oq.AllocTensor<float>();
            AscendC::WholeReduceMax(result,values,bmms83::MinI(p.N,64),ROWS,1,1,p.N/8,AscendC::ReduceOrder::ORDER_ONLY_VALUE);
            AscendC::PipeBarrier<PIPE_V>();oq.EnQue(result);result=oq.DeQue<float>();
            // Exactly 32 bytes per owner: no adjacent partial writes share a block.
            AscendC::DataCopy(rowMax[m0],result,ROWS);oq.FreeTensor(result);
        }
        // All active and idle AIVs reach the same second publication barrier.
        bmms71::Fence<AscendC::HardEvent::MTE3_MTE2>(*pipe_);
        AscendC::SyncAll<true>();
        if(worker==0){
            auto rows=allRowsBuf.Get<float>();AscendC::DataCopy(rows,rowMax,p.M);
            bmms71::Fence<AscendC::HardEvent::MTE2_V>(*pipe_);
            auto result=oq.AllocTensor<float>();
            AscendC::ReduceSum(result,rows,scratchBuf.Get<float>(),p.M);AscendC::PipeBarrier<PIPE_V>();
            oq.EnQue(result);result=oq.DeQue<float>();
            AscendC::DataCopyExtParams cp{1,4,0,0,0};AscendC::DataCopyPad(out,result,cp);oq.FreeTensor(result);
        }
    }
};

