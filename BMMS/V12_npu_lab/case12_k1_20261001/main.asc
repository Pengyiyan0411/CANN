// Offline validation only. Tensor ABI matches the supplied Judge main.asc.
#include <cstdint>
#include <cstdlib>
#include <cstdio>
#include <cmath>
#include <cstring>
#include <vector>
#include <string>
#include <fstream>
#include <chrono>
#include "acl/acl.h"
struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
#include BMMS_KERNEL_HEADER

static void ck(aclError code,const char* name) {
    if(code!=ACL_SUCCESS){std::fprintf(stderr,"ACL_ERROR %s %d\n",name,int(code));std::exit(2);}
}
static std::vector<uint8_t> readbin(const std::string& path,size_t n) {
    std::ifstream f(path,std::ios::binary|std::ios::ate);
    if(!f||f.tellg()!=std::streampos(n)){std::fprintf(stderr,"BAD_FILE %s\n",path.c_str());std::exit(2);}
    std::vector<uint8_t> v(n);f.seekg(0);
    if(!f.read(reinterpret_cast<char*>(v.data()),n))std::exit(2);
    return v;
}
int main(int argc,char**argv) {
    if(argc!=4){std::fprintf(stderr,"Usage: bench manifest.txt repeats output.jsonl\n");return 2;}
    std::setvbuf(stdout,nullptr,_IOLBF,0);std::setvbuf(stderr,nullptr,_IOLBF,0);
    const int repeats=std::atoi(argv[2]);if(repeats<1||repeats>1000)return 2;
    std::ifstream mf(argv[1]);FILE*out=std::fopen(argv[3],"w");if(!mf||!out)return 2;
    const std::string manifest=argv[1];const auto sep=manifest.find_last_of("/\\");
    const std::string root=sep==std::string::npos?".":manifest.substr(0,sep);
    const char* deviceEnv=std::getenv("BMMS_DEVICE");const int device=deviceEnv?std::atoi(deviceEnv):0;
    ck(aclInit(nullptr),"init");ck(aclrtSetDevice(device),"set device");
    aclrtStream stream=nullptr;ck(aclrtCreateStream(&stream),"create stream");
    int64_t cores=0;ck(aclrtGetDeviceInfo(device,ACL_DEV_ATTR_CUBE_CORE_NUM,&cores),"core count");
    if(cores<1||cores>64)return 2;
    std::printf("ENV version=%s device=%d cube_cores=%lld\n",BMMS_VARIANT,device,(long long)cores);
    int id,dt,ta,tb,total=0;int64_t B,M,N,K;
    while(mf>>id>>B>>M>>N>>K>>dt>>ta>>tb) {
        if(B<1||B>64||M<1||M>8192||N<1||N>8192||K<32||K>8192||K%8||B*M*K>(1LL<<26)||B*N*K>(1LL<<26)||(dt!=1&&dt!=2)||(ta!=0&&ta!=1)||(tb!=0&&tb!=1))return 2;
        const std::string prefix=root+"/case"+std::to_string(id);
        const auto ah=readbin(prefix+"_a.bin",B*M*K*2),bh=readbin(prefix+"_b.bin",B*N*K*2),gh=readbin(prefix+"_golden.bin",B*8);
        std::vector<double> golden(B);std::memcpy(golden.data(),gh.data(),B*8);
        std::vector<float> got(B);std::vector<uint32_t> poison(B);
        void *a=nullptr,*b=nullptr,*y=nullptr;
        ck(aclrtMalloc(&a,ah.size(),ACL_MEM_MALLOC_HUGE_FIRST),"alloc A");
        ck(aclrtMalloc(&b,bh.size(),ACL_MEM_MALLOC_HUGE_FIRST),"alloc B");
        ck(aclrtMalloc(&y,B*4,ACL_MEM_MALLOC_HUGE_FIRST),"alloc Y");
        ck(aclrtMemcpy(a,ah.size(),ah.data(),ah.size(),ACL_MEMCPY_HOST_TO_DEVICE),"H2D A");
        ck(aclrtMemcpy(b,bh.size(),bh.data(),bh.size(),ACL_MEMCPY_HOST_TO_DEVICE),"H2D B");
        const int64_t as[]={B,ta?K:M,ta?M:K},bs[]={B,tb?N:K,tb?K:N},ys[]={B};
        const TensorInfo ai{as,3,dt},bi{bs,3,dt},yi{ys,1,0};
        const TensorGroupInfo ag{&ai,1},bg{&bi,1},yg{&yi,1};
        bool target=false;int pm=0,pn=0,blocks=0;
        if(bmms11r2::Eligible(B,M,N,K,cores)){
            auto p=bmms11r2::MakePlan(B,M,N,K,cores);pm=p.pM;pn=p.pN;blocks=p.blocks;
            target=B==1&&M>=1280&&M<1536&&N>=4096&&N<6144&&K==1536&&!tb&&bmms1230::AlignedPitch(M,N,K,ta,tb)&&!bmms1241::Eligible(B,M,N,K,cores)&&p.pN==2&&p.pM>=8&&p.pM==p.mTiles&&p.tasks==cores&&p.blocks==cores;
        }
        std::printf("CASE %d B=%lld M=%lld N=%lld K=%lld dtype=%d ta=%d tb=%d case12_k1_guard=%d grid=%dx%d blocks=%d\n",id,(long long)B,(long long)M,(long long)N,(long long)K,dt,ta,tb,int(target),pm,pn,blocks);
        double wall=0,maxError=0,maxRatio=0;bool pass=true;
        for(int rep=0;rep<repeats;++rep){
            for(int j=0;j<B;++j)poison[j]=0x7fc00000u+rep+1;
            ck(aclrtMemcpy(y,B*4,poison.data(),B*4,ACL_MEMCPY_HOST_TO_DEVICE),"poison");
            auto begin=std::chrono::steady_clock::now();
            run_kernel((GM_ADDR)a,ag,(GM_ADDR)b,bg,(GM_ADDR)y,yg,cores,stream,ta,tb);
            ck(aclrtSynchronizeStreamWithTimeout(stream,10000),"kernel sync");
            wall+=std::chrono::duration<double,std::micro>(std::chrono::steady_clock::now()-begin).count();
            ck(aclrtMemcpy(got.data(),B*4,y,B*4,ACL_MEMCPY_DEVICE_TO_HOST),"D2H");
            for(int j=0;j<B;++j){
                const double e=std::fabs(double(got[j])-golden[j]),lim=1e-4+1e-4*std::fabs(golden[j]);
                if(e>maxError)maxError=e;if(e/lim>maxRatio)maxRatio=e/lim;
                if(!std::isfinite(got[j])||e>lim){pass=false;std::fprintf(stderr,"MISMATCH case=%d rep=%d batch=%d got=%.9g expected=%.17g\n",id,rep,j,got[j],golden[j]);}
            }
        }
        std::fprintf(out,"{\"case\":%d,\"version\":\"%s\",\"pass\":%s,\"max_abs_error\":%.9g,\"max_tolerance_ratio\":%.9g,\"host_call_mean_us\":%.6f,\"kernel_timing\":false,\"repeats\":%d,\"case12_k1_guard\":%s,\"cube_cores\":%lld}\n",id,BMMS_VARIANT,pass?"true":"false",maxError,maxRatio,wall/repeats,repeats,target?"true":"false",(long long)cores);
        std::fflush(out);std::printf("RESULT %d %s error=%.9g\n",id,pass?"PASS":"FAIL",maxError);
        ck(aclrtFree(y),"free Y");ck(aclrtFree(b),"free B");ck(aclrtFree(a),"free A");
        if(!pass)return 3;++total;
    }
    std::fclose(out);ck(aclrtDestroyStream(stream),"destroy stream");ck(aclrtResetDevice(device),"reset device");ck(aclFinalize(),"finalize");
    std::printf("COMPLETE passed=%d\n",total);return 0;
}
