// Auxiliary unprofiled, device-stream throughput. This does not reproduce
// Judge host allocation/synchronization or its unknown timing contract.
// Reuse the verified loader and exact Tensor ABI, and compile the full source.
#define main verification_entry_not_used
#include "main.asc"
#undef main

static void launch_direct(bool candidate,void* a,void* b,void* y,void* ws,
                          const bmms11r2::Plan& plan,int dt,bool ta,bool tb,aclrtStream stream){
    auto p=plan;
    auto ring=reinterpret_cast<uint8_t*>(ws);
    auto partial=ring+bmms11r2::RingBytes(p);
#define CALL(NAME) NAME<<<p.blocks,nullptr,stream>>>(reinterpret_cast<uint8_t*>(a),reinterpret_cast<uint8_t*>(b),reinterpret_cast<uint8_t*>(y),ring,partial,p)
#define DISPATCH(NS) \
    if(dt==1){ \
        if(!ta&&!tb){CALL(NS##_f16_nn);}else if(!ta&&tb){CALL(NS##_f16_nt);} \
        else if(ta&&!tb){CALL(NS##_f16_tn);}else{CALL(NS##_f16_tt);} \
    }else{ \
        if(!ta&&!tb){CALL(NS##_b16_nn);}else if(!ta&&tb){CALL(NS##_b16_nt);} \
        else if(ta&&!tb){CALL(NS##_b16_tn);}else{CALL(NS##_b16_tt);} \
    }
    if(candidate){DISPATCH(bmms1207);}else{DISPATCH(bmms11r2);}
#undef DISPATCH
#undef CALL
}

int main(int argc,char** argv){
    if(argc!=4){std::fprintf(stderr,"Usage: event_bench manifest.txt windows output.jsonl\n");return 2;}
    const int windows=std::atoi(argv[2]),batchCalls=64;
    const bool aa=std::getenv("BMMS_EVENT_AA")!=nullptr;
    if(windows<1||windows>100)return 2;
    std::setvbuf(stdout,nullptr,_IOLBF,0);
    std::ifstream mf(argv[1]);FILE* out=std::fopen(argv[3],"w");if(!mf||!out)return 2;
    const std::string manifest=argv[1];auto sep=manifest.find_last_of("/\\");
    const std::string root=sep==std::string::npos?".":manifest.substr(0,sep);
    ck(aclInit(nullptr),"init");ck(aclrtSetDevice(0),"device");
    aclrtStream stream=nullptr;ck(aclrtCreateStream(&stream),"stream");
    int64_t cores=0;ck(aclrtGetDeviceInfo(0,ACL_DEV_ATTR_CUBE_CORE_NUM,&cores),"cores");
    int id,dt,ta,tb;int64_t B,M,N,K;
    while(mf>>id>>B>>M>>N>>K>>dt>>ta>>tb){
        if(!bmms1207::Eligible(B,M,N,K,cores)||(dt!=1&&dt!=2)||(ta!=0&&ta!=1)||(tb!=0&&tb!=1))return 2;
        const auto p=bmms11r2::MakePlan(B,M,N,K,cores);
        auto prefix=root+"/case"+std::to_string(id);
        auto ah=readbin(prefix+"_a.bin",B*M*K*2),bh=readbin(prefix+"_b.bin",B*N*K*2),gh=readbin(prefix+"_golden.bin",B*8);
        std::vector<double> golden(B);std::memcpy(golden.data(),gh.data(),B*8);
        std::vector<float> got(B);std::vector<uint32_t> poison(B,0x7fc00001u);
        void *a=nullptr,*b=nullptr,*y=nullptr,*ws=nullptr;
        ck(aclrtMalloc(&a,ah.size(),ACL_MEM_MALLOC_HUGE_FIRST),"a");
        ck(aclrtMalloc(&b,bh.size(),ACL_MEM_MALLOC_HUGE_FIRST),"b");
        ck(aclrtMalloc(&y,B*4,ACL_MEM_MALLOC_HUGE_FIRST),"y");
        ck(aclrtMalloc(&ws,bmms11r2::WorkspaceBytes(p),ACL_MEM_MALLOC_HUGE_FIRST),"workspace");
        ck(aclrtMemcpy(a,ah.size(),ah.data(),ah.size(),ACL_MEMCPY_HOST_TO_DEVICE),"copy a");
        ck(aclrtMemcpy(b,bh.size(),bh.data(),bh.size(),ACL_MEMCPY_HOST_TO_DEVICE),"copy b");
        for(int warm=0;warm<100;++warm)launch_direct(!aa&&(warm%2),a,b,y,ws,p,dt,ta,tb,stream);
        ck(aclrtSynchronizeStreamWithTimeout(stream,10000),"warmup sync");
        for(int w=0;w<windows;++w){
            for(int order=0;order<2;++order){
                const bool label=((order+w)%2)!=0,candidate=!aa&&label;
                ck(aclrtMemcpy(y,B*4,poison.data(),B*4,ACL_MEMCPY_HOST_TO_DEVICE),"poison");
                for(int warm=0;warm<8;++warm)launch_direct(candidate,a,b,y,ws,p,dt,ta,tb,stream);
                ck(aclrtSynchronizeStreamWithTimeout(stream,10000),"prime sync");
                aclrtEvent begin=nullptr,end=nullptr;
                ck(aclrtCreateEvent(&begin),"start event");ck(aclrtCreateEvent(&end),"end event");
                ck(aclrtRecordEvent(begin,stream),"record start");
                for(int rep=0;rep<batchCalls;++rep)launch_direct(candidate,a,b,y,ws,p,dt,ta,tb,stream);
                ck(aclrtRecordEvent(end,stream),"record end");
                ck(aclrtSynchronizeStreamWithTimeout(stream,10000),"timed sync");
                float ms=0;ck(aclrtEventElapsedTime(&ms,begin,end),"elapsed");
                ck(aclrtMemcpy(got.data(),B*4,y,B*4,ACL_MEMCPY_DEVICE_TO_HOST),"copy output");
                double maxRatio=0;
                for(int j=0;j<B;++j){
                    const double error=std::fabs(double(got[j])-golden[j]),limit=1e-4+1e-4*std::fabs(golden[j]);
                    if(!std::isfinite(got[j])||error>limit){std::fprintf(stderr,"ERROR case %d\n",id);return 3;}
                    if(error/limit>maxRatio)maxRatio=error/limit;
                }
                std::fprintf(out,"{\"case\":%d,\"window\":%d,\"label\":\"%s\",\"kernel\":\"%s\",\"aa\":%s,\"calls\":%d,\"device_stream_us_per_call\":%.8f,\"max_tolerance_ratio\":%.9g}\n",
                    id,w,label?"B":"A",candidate?"r07":"r03",aa?"true":"false",batchCalls,ms*1000.0/batchCalls,maxRatio);
                std::fflush(out);
                ck(aclrtDestroyEvent(end),"destroy end");ck(aclrtDestroyEvent(begin),"destroy start");
            }
        }
        std::printf("PASS case=%d windows=%d aa=%d\n",id,windows,int(aa));
        ck(aclrtFree(ws),"free ws");ck(aclrtFree(y),"free y");ck(aclrtFree(b),"free b");ck(aclrtFree(a),"free a");
    }
    std::fclose(out);ck(aclrtDestroyStream(stream),"destroy stream");ck(aclrtResetDevice(0),"reset");ck(aclFinalize(),"finalize");
    return 0;
}
