// Auxiliary unprofiled, device-stream throughput. This does not reproduce
// Judge host allocation/synchronization or its unknown timing contract.
// Reuse the verified loader and exact Tensor ABI, and compile the full source.
#define main verification_entry_not_used
#include "main.asc"
#undef main


namespace c8diag {
template<class T,bool TA,bool TB,int PHASE>
__aicore__ inline void Entry(GM_ADDR a,GM_ADDR b,GM_ADDR y,GM_ADDR ap,GM_ADDR bp,GM_ADDR ring,GM_ADDR part,bmms_c8p43::RaggedPlan p){
    AscendC::TPipe pipe;
    if ASCEND_IS_AIC {
        if(PHASE!=2)AscendC::CrossCoreWaitFlag<0x2>(bmms_c8p43::PACK_TO_CUBE);
        if(PHASE!=1){bmms11r2::ReuseProducer<T,TA,TB> op;op.Init(ap,bp,ring,p.cube,&pipe);op.Process();}
    }
    if ASCEND_IS_AIV {
        if(PHASE!=2){
            AscendC::TBuf<AscendC::TPosition::VECCALC> pack;
            pipe.InitBuffer(pack,bmms_c8p43::PACK_SLOTS*bmms_c8p43::PACK_SLOT_ELEMS*2);
            bmms_c8p43::PackInputs(a,b,ap,bp,p,&pipe,pack);
        }
        if(PHASE!=1){bmms_c8p43::MaskedRowMaxConsumer op;op.Init(ring,part,y,p,&pipe);op.Process();}
    }
}
}
#define KERN(NAME,T,TA,TB,P) __schedmode__(1) __global__ __mix__(1,2) __aicore__ void NAME(GM_ADDR a,GM_ADDR b,GM_ADDR y,GM_ADDR ap,GM_ADDR bp,GM_ADDR r,GM_ADDR pt,bmms_c8p43::RaggedPlan p){c8diag::Entry<T,TA,TB,P>(a,b,y,ap,bp,r,pt,p);}
KERN(c8diag1_f16_nn,half,false,false,1)
KERN(c8diag1_f16_nt,half,false,true,1)
KERN(c8diag1_f16_tn,half,true,false,1)
KERN(c8diag1_f16_tt,half,true,true,1)
KERN(c8diag1_b16_nn,bfloat16_t,false,false,1)
KERN(c8diag1_b16_nt,bfloat16_t,false,true,1)
KERN(c8diag1_b16_tn,bfloat16_t,true,false,1)
KERN(c8diag1_b16_tt,bfloat16_t,true,true,1)
KERN(c8diag2_f16_nn,half,false,false,2)
KERN(c8diag2_f16_nt,half,false,true,2)
KERN(c8diag2_f16_tn,half,true,false,2)
KERN(c8diag2_f16_tt,half,true,true,2)
KERN(c8diag2_b16_nn,bfloat16_t,false,false,2)
KERN(c8diag2_b16_nt,bfloat16_t,false,true,2)
KERN(c8diag2_b16_tn,bfloat16_t,true,false,2)
KERN(c8diag2_b16_tt,bfloat16_t,true,true,2)
#undef KERN
static void launch_direct(int phase,void* a,void* b,void* y,void* ws,const bmms_c8p43::RaggedPlan& plan,int dt,bool ta,bool tb,aclrtStream stream){
    auto p=plan;auto ap=(uint8_t*)ws;auto bp=ap+bmms_c8p43::ABytes(p);auto ring=bp+bmms_c8p43::BBytes(p);auto part=ring+bmms_c8p43::RingBytes(p);
#define CALL(NAME) NAME<<<p.cube.blocks,nullptr,stream>>>((uint8_t*)a,(uint8_t*)b,(uint8_t*)y,ap,bp,ring,part,p)
#define DISPATCH(NS) \
    if(dt==1){ \
        if(!ta&&!tb){CALL(NS##_f16_nn);}else if(!ta&&tb){CALL(NS##_f16_nt);} \
        else if(ta&&!tb){CALL(NS##_f16_tn);}else{CALL(NS##_f16_tt);} \
    }else{ \
        if(!ta&&!tb){CALL(NS##_b16_nn);}else if(!ta&&tb){CALL(NS##_b16_nt);} \
        else if(ta&&!tb){CALL(NS##_b16_tn);}else{CALL(NS##_b16_tt);} \
    }
    if(phase==0){DISPATCH(bmms_c8p43);}else if(phase==1){DISPATCH(c8diag1);}else{DISPATCH(c8diag2);}
#undef DISPATCH
#undef CALL
}

int main(int argc,char** argv){
    if(argc!=4){std::fprintf(stderr,"Usage: event_bench manifest.txt windows output.jsonl\n");return 2;}
    const int windows=std::atoi(argv[2]),batchCalls=64;
    const bool aa=std::getenv("BMMS_EVENT_AA")!=nullptr;
    if(windows<1||windows>100)return 2;
    std::setvbuf(stdout,nullptr,_IOLBF,0);
    std::ifstream mf(argv[1]);FILE* out=std::fopen(argv[3],"w");if(!mf||!out)return 2;
    const std::string manifest=argv[1];auto sep=manifest.find_last_of("/\\");
    const std::string root=sep==std::string::npos?".":manifest.substr(0,sep);
    ck(aclInit(nullptr),"init");ck(aclrtSetDevice(0),"device");
    aclrtStream stream=nullptr;ck(aclrtCreateStream(&stream),"stream");
    int64_t cores=0;ck(aclrtGetDeviceInfo(0,ACL_DEV_ATTR_CUBE_CORE_NUM,&cores),"cores");
    int id,dt,ta,tb;int64_t B,M,N,K;
    while(mf>>id>>B>>M>>N>>K>>dt>>ta>>tb){
        if(!bmms_c8p43::Eligible(B,M,N,K,dt,cores)||(dt!=1&&dt!=2)||(ta!=0&&ta!=1)||(tb!=0&&tb!=1))return 2;
        const auto p=bmms_c8p43::MakePlan(M,N,K,cores,ta,tb);
        auto prefix=root+"/case"+std::to_string(id);
        auto ah=readbin(prefix+"_a.bin",B*M*K*2),bh=readbin(prefix+"_b.bin",B*N*K*2),gh=readbin(prefix+"_golden.bin",B*8);
        std::vector<double> golden(B);std::memcpy(golden.data(),gh.data(),B*8);
        std::vector<float> got(B);std::vector<uint32_t> poison(B,0x7fc00001u);
        void *a=nullptr,*b=nullptr,*y=nullptr,*ws=nullptr;
        ck(aclrtMalloc(&a,ah.size(),ACL_MEM_MALLOC_HUGE_FIRST),"a");
        ck(aclrtMalloc(&b,bh.size(),ACL_MEM_MALLOC_HUGE_FIRST),"b");
        ck(aclrtMalloc(&y,B*4,ACL_MEM_MALLOC_HUGE_FIRST),"y");
        ck(aclrtMalloc(&ws,bmms_c8p43::WorkspaceBytes(p),ACL_MEM_MALLOC_HUGE_FIRST),"workspace");
        ck(aclrtMemcpy(a,ah.size(),ah.data(),ah.size(),ACL_MEMCPY_HOST_TO_DEVICE),"copy a");
        ck(aclrtMemcpy(b,bh.size(),bh.data(),bh.size(),ACL_MEMCPY_HOST_TO_DEVICE),"copy b");
        for(int warm=0;warm<100;++warm)launch_direct(0,a,b,y,ws,p,dt,ta,tb,stream);
        ck(aclrtSynchronizeStreamWithTimeout(stream,10000),"warmup sync");
        for(int w=0;w<windows;++w){
            for(int order=0;order<3;++order){
                const int phase=(order+w)%3;
                ck(aclrtMemcpy(y,B*4,poison.data(),B*4,ACL_MEMCPY_HOST_TO_DEVICE),"poison");
                for(int warm=0;warm<8;++warm)launch_direct(phase,a,b,y,ws,p,dt,ta,tb,stream);
                ck(aclrtSynchronizeStreamWithTimeout(stream,10000),"prime sync");
                aclrtEvent begin=nullptr,end=nullptr;
                ck(aclrtCreateEvent(&begin),"start event");ck(aclrtCreateEvent(&end),"end event");
                ck(aclrtRecordEvent(begin,stream),"record start");
                for(int rep=0;rep<batchCalls;++rep)launch_direct(phase,a,b,y,ws,p,dt,ta,tb,stream);
                ck(aclrtRecordEvent(end,stream),"record end");
                ck(aclrtSynchronizeStreamWithTimeout(stream,10000),"timed sync");
                float ms=0;ck(aclrtEventElapsedTime(&ms,begin,end),"elapsed");
                ck(aclrtMemcpy(got.data(),B*4,y,B*4,ACL_MEMCPY_DEVICE_TO_HOST),"copy output");
                if(phase==1){
                    const bmms_c8p43::PackDesc descs[]={p.a,p.b};
                    for(int side=0;side<2;++side){
                        const auto& d=descs[side];auto& original=side?bh:ah;
                        size_t sz=size_t(d.dstRows)*d.dstCols*2;std::vector<uint8_t> packed(sz),expected(sz,0);
                        for(int row=0;row<d.srcRows;++row)std::memcpy(expected.data()+size_t(row)*d.dstCols*2,original.data()+size_t(row)*d.srcCols*2,d.srcCols*2);
                        ck(aclrtMemcpy(packed.data(),sz,(uint8_t*)ws+(side?bmms_c8p43::ABytes(p):0),sz,ACL_MEMCPY_DEVICE_TO_HOST),"pack verify");
                        if(packed!=expected){std::fprintf(stderr,"pack mismatch case %d side %d\n",id,side);return 3;}
                    }
                }
                double maxRatio=0;
                for(int j=0;phase!=1&&j<B;++j){
                    const double error=std::fabs(double(got[j])-golden[j]),limit=1e-4+1e-4*std::fabs(golden[j]);
                    if(!std::isfinite(got[j])||error>limit){std::fprintf(stderr,"ERROR case %d\n",id);return 3;}
                    if(error/limit>maxRatio)maxRatio=error/limit;
                }
                std::fprintf(out,"{\"case\":%d,\"window\":%d,\"phase\":%d,\"pM\":%d,\"pN\":%d,\"blocks\":%d,\"calls\":%d,\"device_stream_us_per_call\":%.8f,\"max_tolerance_ratio\":%.9g}\n",id,w,phase,p.cube.pM,p.cube.pN,p.cube.blocks,batchCalls,ms*1000.0/batchCalls,maxRatio);
                std::fflush(out);
                ck(aclrtDestroyEvent(end),"destroy end");ck(aclrtDestroyEvent(begin),"destroy start");
            }
        }
        std::printf("PASS case=%d windows=%d aa=%d\n",id,windows,int(aa));
        ck(aclrtFree(ws),"free ws");ck(aclrtFree(y),"free y");ck(aclrtFree(b),"free b");ck(aclrtFree(a),"free a");
    }
    std::fclose(out);ck(aclrtDestroyStream(stream),"destroy stream");ck(aclrtResetDevice(0),"reset");ck(aclFinalize(),"finalize");
    return 0;
}
