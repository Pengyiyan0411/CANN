// Offline independent full-output reference. No inter-block communication in either kernel.
__global__ __aicore__ void bmms_audit_rowmax(GM_ADDR c,GM_ADDR rows,int M,int N){
 KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
 AscendC::TPipe pipe;
 AscendC::GlobalTensor<float> gm,out;gm.SetGlobalBuffer((__gm__ float*)c,int64_t(M)*N);out.SetGlobalBuffer((__gm__ float*)rows,M);
 int block=AscendC::GetBlockIdx(),blocks=AscendC::GetBlockNum(),m0=block*M/blocks,m1=(block+1)*M/blocks,nr=m1-m0;
 if(nr==0)return;
 AscendC::TQue<AscendC::TPosition::VECIN,1> iq;
 AscendC::TQue<AscendC::TPosition::VECOUT,1> oq;
 AscendC::TBuf<AscendC::TPosition::VECCALC> tmp;
 pipe.InitBuffer(iq,1,N*4);pipe.InitBuffer(oq,1,nr*32);pipe.InitBuffer(tmp,N*4);
 auto dst=oq.AllocTensor<float>();auto scratch=tmp.Get<float>();
 for(int i=0;i<nr;++i){
  auto x=iq.AllocTensor<float>();AscendC::DataCopyExtParams cp{1,uint32_t(N*4),0,0,0};AscendC::DataCopyPadExtParams<float> pad{false,0,0,0};
  AscendC::DataCopyPad(x,gm[int64_t(m0+i)*N],cp,pad);iq.EnQue(x);x=iq.DeQue<float>();
  AscendC::ReduceMax(dst[i*8],x,scratch,N,false);AscendC::PipeBarrier<PIPE_V>();iq.FreeTensor(x);
 }
 oq.EnQue(dst);dst=oq.DeQue<float>();
 // Each 4-byte result occupies one 32-byte UB block; GM results are contiguous.
 AscendC::DataCopyExtParams cp{uint16_t(nr),4,0,0,0};AscendC::DataCopyPad(out[m0],dst,cp);oq.FreeTensor(dst);
}
__global__ __aicore__ void bmms_audit_rowsum(GM_ADDR rows,GM_ADDR y,int M){
 KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
 AscendC::TPipe pipe;AscendC::GlobalTensor<float> gm,out;gm.SetGlobalBuffer((__gm__ float*)rows,M);out.SetGlobalBuffer((__gm__ float*)y,1);
 AscendC::TQue<AscendC::TPosition::VECIN,1> iq;AscendC::TQue<AscendC::TPosition::VECOUT,1> oq;
 AscendC::TBuf<AscendC::TPosition::VECCALC> tmp;pipe.InitBuffer(iq,1,((M+7)/8)*32);pipe.InitBuffer(oq,1,32);pipe.InitBuffer(tmp,((M+7)/8)*32);
 auto x=iq.AllocTensor<float>();AscendC::DataCopyExtParams cp{1,uint32_t(M*4),0,0,0};AscendC::DataCopyPadExtParams<float> pad{false,0,0,0};
 AscendC::DataCopyPad(x,gm,cp,pad);iq.EnQue(x);x=iq.DeQue<float>();auto dst=oq.AllocTensor<float>();AscendC::ReduceSum(dst,x,tmp.Get<float>(),M);iq.FreeTensor(x);
 oq.EnQue(dst);dst=oq.DeQue<float>();AscendC::DataCopyExtParams wp{1,4,0,0,0};AscendC::DataCopyPad(out,dst,wp);oq.FreeTensor(dst);
}
