// Offline diagnostic: FP16/BF16 inputs, full FP32 output, CPU FP64 dot samples and full BMMS output check.
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cmath>
#include <cstring>
#include <vector>
#include <string>
#include <fstream>
#include "acl/acl.h"
#ifdef AUDIT_NATIVE
struct TensorInfo{const int64_t* shape;int64_t numDims;int32_t dtype;};
struct TensorGroupInfo{const TensorInfo* tensors;int64_t numTensors;};
#include "native_gemm.asc"
#else
#include "catlass/gemm/kernel/basic_matmul.hpp"
#include "catlass/gemm/block/block_mmad.hpp"
#include "catlass/gemm/block/block_swizzle.hpp"
#include "catlass/gemm/device/device_gemm.hpp"
#include "catlass/gemm/dispatch_policy.hpp"
#include "catlass/gemm/gemm_type.hpp"
#include "catlass/layout/layout.hpp"
namespace audit_gemm {
template<class T,bool TA> void go(GM_ADDR a,GM_ADDR b,GM_ADDR c,int M,int N,int K,int cores,aclrtStream stream){
 using namespace Catlass;
 using LA=typename std::conditional<TA,layout::ColumnMajor,layout::RowMajor>::type;
 using LB=layout::RowMajor;using LC=layout::RowMajor;
 using DP=Gemm::MmadAtlasA2Pingpong<(AUDIT_UNIT!=0)>;
 using Block=Gemm::Block::BlockMmad<DP,GemmShape<128,256,256>,GemmShape<128,256,64>,Gemm::GemmType<T,LA>,Gemm::GemmType<T,LB>,Gemm::GemmType<float,LC>>;
 using Scheduler=Gemm::Block::GemmIdentityBlockSwizzle<3,1>;
 using Kernel=Gemm::Kernel::BasicMatmul<Block,void,Scheduler>;
 using Device=Gemm::Device::DeviceGemm<Kernel>;
 typename Kernel::Arguments args{GemmCoord(M,N,K),a,b,c};Device op;op.Initialize(args);op(stream,cores);
}
void launch(GM_ADDR a,GM_ADDR b,GM_ADDR c,int M,int N,int K,int dt,bool ta,int cores,aclrtStream stream){
 if(dt==1){if(ta)go<half,true>(a,b,c,M,N,K,cores,stream);else go<half,false>(a,b,c,M,N,K,cores,stream);}
 else{if(ta)go<bfloat16_t,true>(a,b,c,M,N,K,cores,stream);else go<bfloat16_t,false>(a,b,c,M,N,K,cores,stream);}
}
}
#endif
#ifdef AUDIT_COMPLETE
#include "audit_epilogue.asc"
#endif
static void ck(aclError r,const char* s){if(r){fprintf(stderr,"ACL %s %d\n",s,int(r));exit(2);}}
static std::vector<uint8_t> read(const std::string&p,size_t n){std::ifstream f(p,std::ios::binary|std::ios::ate);if(!f||f.tellg()!=std::streampos(n)){fprintf(stderr,"BAD_FILE %s\n",p.c_str());exit(2);}std::vector<uint8_t>x(n);f.seekg(0);f.read((char*)x.data(),n);return x;}
static float decode(uint16_t u,int dt){
 if(dt==2){uint32_t q=uint32_t(u)<<16;float f;memcpy(&f,&q,4);return f;}
 const int e=(u>>10)&31,m=u&1023;float f=e==0?std::ldexp(float(m),-24):std::ldexp(float(1024+m),e-25);return (u&32768)?-f:f;
}
int main(int argc,char**argv){
 if(argc!=4)return 2;std::setvbuf(stdout,nullptr,_IOLBF,0);
 int repeats=atoi(argv[2]);if(repeats<1||repeats>1000)return 2;
 std::string manifest=argv[1],dir=manifest.substr(0,manifest.find_last_of('/'));
 std::ifstream mf(manifest);FILE*out=fopen(argv[3],"w");if(!mf||!out)return 2;
 ck(aclInit(nullptr),"init");ck(aclrtSetDevice(0),"device");aclrtStream stream;ck(aclrtCreateStream(&stream),"stream");
 int64_t cores;ck(aclrtGetDeviceInfo(0,ACL_DEV_ATTR_CUBE_CORE_NUM,&cores),"cores");
 int id,B,M,N,K,dt,ta,tb,count=0;
 while(mf>>id>>B>>M>>N>>K>>dt>>ta>>tb){
  if(B!=1||M%16||N%16||K%32||tb||M<128||N<256||(dt!=1&&dt!=2))return 2;
  auto prefix=dir+"/case"+std::to_string(id);auto ah=read(prefix+"_a.bin",size_t(M)*K*2),bh=read(prefix+"_b.bin",size_t(K)*N*2),gh=read(prefix+"_golden.bin",8);
  double golden;memcpy(&golden,gh.data(),8);size_t nc=size_t(M)*N;std::vector<float> ch(nc,NAN);
  void*a,*b,*c;ck(aclrtMalloc(&a,ah.size(),ACL_MEM_MALLOC_HUGE_FIRST),"a");ck(aclrtMalloc(&b,bh.size(),ACL_MEM_MALLOC_HUGE_FIRST),"b");ck(aclrtMalloc(&c,nc*4,ACL_MEM_MALLOC_HUGE_FIRST),"c");
  ck(aclrtMemcpy(a,ah.size(),ah.data(),ah.size(),ACL_MEMCPY_HOST_TO_DEVICE),"ha");ck(aclrtMemcpy(b,bh.size(),bh.data(),bh.size(),ACL_MEMCPY_HOST_TO_DEVICE),"hb");ck(aclrtMemcpy(c,nc*4,ch.data(),nc*4,ACL_MEMCPY_HOST_TO_DEVICE),"poison c");
  void *rows=nullptr,*yd=nullptr;
#ifdef AUDIT_COMPLETE
  ck(aclrtMalloc(&rows,M*4,ACL_MEM_MALLOC_HUGE_FIRST),"rows");ck(aclrtMalloc(&yd,4,ACL_MEM_MALLOC_HUGE_FIRST),"y");
  std::vector<float> poison(M,NAN);ck(aclrtMemcpy(rows,M*4,poison.data(),M*4,ACL_MEMCPY_HOST_TO_DEVICE),"poison rows");ck(aclrtMemcpy(yd,4,poison.data(),4,ACL_MEMCPY_HOST_TO_DEVICE),"poison y");
#endif
  for(int r=0;r<repeats;++r){audit_gemm::launch((GM_ADDR)a,(GM_ADDR)b,(GM_ADDR)c,M,N,K,dt,ta,cores,stream);
#ifdef AUDIT_COMPLETE
   bmms_audit_rowmax<<<cores*2,nullptr,stream>>>((GM_ADDR)c,(GM_ADDR)rows,M,N);
   bmms_audit_rowsum<<<1,nullptr,stream>>>((GM_ADDR)rows,(GM_ADDR)yd,M);
#endif
   ck(aclrtSynchronizeStreamWithTimeout(stream,10000),"sync");}
  ck(aclrtMemcpy(ch.data(),nc*4,c,nc*4,ACL_MEMCPY_DEVICE_TO_HOST),"read c");
  bool pass=true;double y=0,maxDotRatio=0;
  for(int m=0;m<M;++m){float mx=-INFINITY;for(int n=0;n<N;++n){float x=ch[size_t(m)*N+n];if(!std::isfinite(x))pass=false;if(x>mx)mx=x;}y+=mx;}
  const auto*aa=(const uint16_t*)ah.data();const auto*bb=(const uint16_t*)bh.data();
  for(int s=0;s<67;++s){int m=s==0?M-1:(s*97)%M,n=s==0?N-1:(s*251)%N;double gold=0;
   for(int k=0;k<K;++k)gold+=double(decode(aa[ta?size_t(k)*M+m:size_t(m)*K+k],dt))*decode(bb[size_t(k)*N+n],dt);
   double ratio=std::fabs(double(ch[size_t(m)*N+n])-gold)/(1e-4+1e-4*std::fabs(gold));if(ratio>maxDotRatio)maxDotRatio=ratio;if(ratio>1)pass=false;
  }
  double yr=std::fabs(y-golden)/(1e-4+1e-4*std::fabs(golden));if(yr>1)pass=false;
#ifdef AUDIT_COMPLETE
  float deviceY;ck(aclrtMemcpy(&deviceY,4,yd,4,ACL_MEMCPY_DEVICE_TO_HOST),"device y");double deviceRatio=std::fabs(double(deviceY)-golden)/(1e-4+1e-4*std::fabs(golden));if(!std::isfinite(deviceY)||deviceRatio>1)pass=false;
  if(deviceRatio>yr)yr=deviceRatio;ck(aclrtFree(yd),"free y");ck(aclrtFree(rows),"free rows");
#endif
  fprintf(out,"{\"case\":%d,\"version\":\"%s\",\"pass\":%s,\"repeats\":%d,\"y_tolerance_ratio\":%.9g,\"dot_tolerance_ratio\":%.9g,\"cores\":%lld}\n",id,AUDIT_VARIANT,pass?"true":"false",repeats,yr,maxDotRatio,(long long)cores);fflush(out);
  printf("CASE %d %s Yratio %.6g CsampleRatio %.6g\n",id,pass?"PASS":"FAIL",yr,maxDotRatio);
  ck(aclrtFree(c),"free c");ck(aclrtFree(b),"free b");ck(aclrtFree(a),"free a");if(!pass)return 3;++count;
 }
 fclose(out);ck(aclrtDestroyStream(stream),"destroy");ck(aclrtResetDevice(0),"reset");ck(aclFinalize(),"finalize");printf("DONE %d\n",count);return 0;
}
