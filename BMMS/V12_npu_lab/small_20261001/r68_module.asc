// BMMS1268_BEGIN
namespace bmms1268 {
static inline bool Eligible(int B,int M,int N,int K){
    return B==1&&M==1&&N==1&&K>=32&&K<=128&&K%8==0;
}
// Exact Dot arithmetic; constant K removes batch iteration and dynamic layout setup.
template<class T,int K>
__aicore__ inline void Device(GM_ADDR a,GM_ADDR b,GM_ADDR y){
    static_assert(K>=32&&K<=128&&K%8==0,"short dot domain");
    constexpr int KP=(K+15)/16*16;
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN,1> iq;
    AscendC::TQue<AscendC::TPosition::VECOUT,1> oq;
    AscendC::TBuf<AscendC::TPosition::VECCALC> floats,scratch;
    pipe.InitBuffer(iq,1,2*KP*sizeof(T));pipe.InitBuffer(oq,1,32);
    pipe.InitBuffer(floats,2*KP*4);pipe.InitBuffer(scratch,KP*4);
    AscendC::GlobalTensor<T> ga,gb;AscendC::GlobalTensor<float> gy;
    ga.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(a),K);
    gb.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(b),K);
    gy.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y),1);
    auto in=iq.AllocTensor<T>();
    AscendC::DataCopyExtParams cp{1,uint32_t(K*sizeof(T)),0,0,0};
    AscendC::DataCopyPadExtParams<T> pad{false,0,0,T(0)};
    AscendC::DataCopyPad(in,ga,cp,pad);AscendC::DataCopyPad(in[KP],gb,cp,pad);
    iq.EnQue(in);in=iq.DeQue<T>();auto fa=floats.Get<float>(),fb=fa[KP];
    if constexpr(K==KP){
        AscendC::Cast(fa,in,AscendC::RoundMode::CAST_NONE,2*K);
    }else{
        AscendC::Cast(fa,in,AscendC::RoundMode::CAST_NONE,K);
        AscendC::Cast(fb,in[KP],AscendC::RoundMode::CAST_NONE,K);
    }
    AscendC::PipeBarrier<PIPE_V>();AscendC::Mul(fa,fa,fb,K);
    AscendC::PipeBarrier<PIPE_V>();auto out=oq.AllocTensor<float>();
    // Keep the same 64-element partial sums, but leave the final result on Vector.
    // The generic ReduceSum implementation also introduces V->S->V/MTE3 handshakes.
    if constexpr(K<=64){
        AscendC::WholeReduceSum(out,fa,K,1,1,1,8);
    }else{
        auto sums=scratch.Get<float>();
        AscendC::WholeReduceSum(sums,fa,64,1,1,1,8);
        AscendC::WholeReduceSum(sums[8],fa[64],K-64,1,1,1,8);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Add(out,sums,sums[8],1);
    }
    oq.EnQue(out);out=oq.DeQue<float>();AscendC::DataCopyExtParams oc{1,4,0,0,0};
    AscendC::DataCopyPad(gy,out,oc);oq.FreeTensor(out);iq.FreeTensor(in);
}
} // namespace bmms1268
// BMMS1268_CPU_END
#define BMMS1268_KERNEL(NAME,T,K) \
__global__ __aicore__ void NAME(GM_ADDR a,GM_ADDR b,GM_ADDR y){bmms1268::Device<T,K>(a,b,y);}
BMMS1268_KERNEL(bmms1268_f16_k32,half,32)
BMMS1268_KERNEL(bmms1268_f16_k40,half,40)
BMMS1268_KERNEL(bmms1268_f16_k48,half,48)
BMMS1268_KERNEL(bmms1268_f16_k56,half,56)
BMMS1268_KERNEL(bmms1268_f16_k64,half,64)
BMMS1268_KERNEL(bmms1268_f16_k72,half,72)
BMMS1268_KERNEL(bmms1268_f16_k80,half,80)
BMMS1268_KERNEL(bmms1268_f16_k88,half,88)
BMMS1268_KERNEL(bmms1268_f16_k96,half,96)
BMMS1268_KERNEL(bmms1268_f16_k104,half,104)
BMMS1268_KERNEL(bmms1268_f16_k112,half,112)
BMMS1268_KERNEL(bmms1268_f16_k120,half,120)
BMMS1268_KERNEL(bmms1268_f16_k128,half,128)
BMMS1268_KERNEL(bmms1268_b16_k32,bfloat16_t,32)
BMMS1268_KERNEL(bmms1268_b16_k40,bfloat16_t,40)
BMMS1268_KERNEL(bmms1268_b16_k48,bfloat16_t,48)
BMMS1268_KERNEL(bmms1268_b16_k56,bfloat16_t,56)
BMMS1268_KERNEL(bmms1268_b16_k64,bfloat16_t,64)
BMMS1268_KERNEL(bmms1268_b16_k72,bfloat16_t,72)
BMMS1268_KERNEL(bmms1268_b16_k80,bfloat16_t,80)
BMMS1268_KERNEL(bmms1268_b16_k88,bfloat16_t,88)
BMMS1268_KERNEL(bmms1268_b16_k96,bfloat16_t,96)
BMMS1268_KERNEL(bmms1268_b16_k104,bfloat16_t,104)
BMMS1268_KERNEL(bmms1268_b16_k112,bfloat16_t,112)
BMMS1268_KERNEL(bmms1268_b16_k120,bfloat16_t,120)
BMMS1268_KERNEL(bmms1268_b16_k128,bfloat16_t,128)
#undef BMMS1268_KERNEL
namespace bmms1268 {
static inline bool TryLaunch(GM_ADDR a,GM_ADDR b,GM_ADDR y,int B,int M,int N,int K,
    int dtype,aclrtStream stream){
    if((dtype!=1&&dtype!=2)||!Eligible(B,M,N,K))return false;
#define BMMS1268_LAUNCH(NAME) NAME<<<1,nullptr,stream>>>(a,b,y)
    if(dtype==1){
        switch(K){
        case 32: BMMS1268_LAUNCH(bmms1268_f16_k32);return true;
        case 40: BMMS1268_LAUNCH(bmms1268_f16_k40);return true;
        case 48: BMMS1268_LAUNCH(bmms1268_f16_k48);return true;
        case 56: BMMS1268_LAUNCH(bmms1268_f16_k56);return true;
        case 64: BMMS1268_LAUNCH(bmms1268_f16_k64);return true;
        case 72: BMMS1268_LAUNCH(bmms1268_f16_k72);return true;
        case 80: BMMS1268_LAUNCH(bmms1268_f16_k80);return true;
        case 88: BMMS1268_LAUNCH(bmms1268_f16_k88);return true;
        case 96: BMMS1268_LAUNCH(bmms1268_f16_k96);return true;
        case 104: BMMS1268_LAUNCH(bmms1268_f16_k104);return true;
        case 112: BMMS1268_LAUNCH(bmms1268_f16_k112);return true;
        case 120: BMMS1268_LAUNCH(bmms1268_f16_k120);return true;
        case 128: BMMS1268_LAUNCH(bmms1268_f16_k128);return true;
        }
    }else{
        switch(K){
        case 32: BMMS1268_LAUNCH(bmms1268_b16_k32);return true;
        case 40: BMMS1268_LAUNCH(bmms1268_b16_k40);return true;
        case 48: BMMS1268_LAUNCH(bmms1268_b16_k48);return true;
        case 56: BMMS1268_LAUNCH(bmms1268_b16_k56);return true;
        case 64: BMMS1268_LAUNCH(bmms1268_b16_k64);return true;
        case 72: BMMS1268_LAUNCH(bmms1268_b16_k72);return true;
        case 80: BMMS1268_LAUNCH(bmms1268_b16_k80);return true;
        case 88: BMMS1268_LAUNCH(bmms1268_b16_k88);return true;
        case 96: BMMS1268_LAUNCH(bmms1268_b16_k96);return true;
        case 104: BMMS1268_LAUNCH(bmms1268_b16_k104);return true;
        case 112: BMMS1268_LAUNCH(bmms1268_b16_k112);return true;
        case 120: BMMS1268_LAUNCH(bmms1268_b16_k120);return true;
        case 128: BMMS1268_LAUNCH(bmms1268_b16_k128);return true;
        }
    }
#undef BMMS1268_LAUNCH
    return false;
}
} // namespace bmms1268
// BMMS1268_END