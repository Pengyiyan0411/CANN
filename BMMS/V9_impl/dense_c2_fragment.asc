// BMMS V9-D03: frozen D01 K128 with two independent L0C slots.
// Insert after the bmms83 declarations/kernels and before run_kernel.
// Source-only candidate: no CANN compile, NPU precision, or timing validation.
// Uses the existing bmms83 row-max consumer and its exact tile traversal.
#ifndef BMMS9D_DENSE_FRAGMENT_INCLUDED
#define BMMS9D_DENSE_FRAGMENT_INCLUDED
#ifndef BMMS9D_K_BLOCK
#define BMMS9D_K_BLOCK 128
#endif

namespace bmms9d {
constexpr int32_t TM=64, TN=128, AM=256, BN=512, KB=BMMS9D_K_BLOCK;
static_assert(KB==64||KB==128,"BMMS9D_K_BLOCK must be 64 or 128");
constexpr uint16_t READY=4, FREE=6;
using Plan=bmms83::NativePlan;

static inline bool Eligible(int32_t M,int32_t N,int32_t K){
    return M>=16&&M<=8192&&N>=16&&N<=8192&&M%16==0&&N%16==0&&
        K>=256&&K<=8192&&K%32==0;
}

static inline Plan MakePlan(int32_t B,int32_t M,int32_t N,int32_t K,int32_t cores){
    Plan p{};p.B=B;p.M=M;p.N=N;p.K=K;
    p.mTiles=bmms83::UpH(M,TM);p.nTiles=bmms83::UpH(N,TN);
    cores=bmms83::MaxH(1,cores);
    p.pM=bmms83::MinH(p.mTiles,bmms83::MaxH(1,bmms83::UpH(cores,B)));
    // Fill a remaining spatial-occupancy gap with the smallest required N
    // split. The consumer preserves row maxima until all N shards are merged.
    p.pN=bmms83::MinH(p.nTiles,bmms83::MaxH(1,bmms83::UpH(cores,B*p.pM)));
    p.tasks=B*p.pM*p.pN;p.blocks=bmms83::MinH(cores,p.tasks);
    return p;
}

static inline uint64_t RingBytes(const Plan& p){return uint64_t(p.blocks)*2*TM*TN*4ULL;}
static inline uint64_t PartialBytes(const Plan& p){return uint64_t(p.B)*p.pN*p.M*4ULL;}
static inline uint64_t WorkspaceBytes(const Plan& p){return RingBytes(p)+PartialBytes(p);}

template<class T,bool TA,bool TB>
class StagedProducer {
    AscendC::TPipe* pipe_;Plan p;
    AscendC::GlobalTensor<T> a,b;
    AscendC::GlobalTensor<float> ring;
    AscendC::TBuf<AscendC::TPosition::A1> a1Buf;
    AscendC::TBuf<AscendC::TPosition::B1> b1Buf;
    AscendC::TBuf<AscendC::TPosition::A2> a2Buf;
    AscendC::TBuf<AscendC::TPosition::B2> b2Buf;
    AscendC::TBuf<AscendC::TPosition::CO1> cBuf;
    AscendC::TEventID l1Ready[2],l1Free[2],l0Ready[2],l0Free[2],cReady,cFree[2];
    int32_t seq=0;

    // Compact ND2NZ tiles use their actual kr/mr/nr extents; each ping-pong
    // slot still reserves the maximum KB tile size. K tail stays a multiple
    // of 32: 32/64 for KB64; 32/64/96/128 for KB128.
    __aicore__ inline void LoadStage(int batch,int m0,int n0,int mr,int nr,int k0,int kr,int stage){
        auto dstA=a1Buf.template Get<T>()[stage*TM*KB];
        auto dstB=b1Buf.template Get<T>()[stage*KB*TN];
        AscendC::Nd2NzParams qa{};qa.ndNum=1;
        qa.nValue=TA?kr:mr;qa.dValue=TA?mr:kr;
        qa.srcDValue=TA?p.M:p.K;qa.dstNzC0Stride=TA?kr:mr;qa.dstNzNStride=1;
        const int64_t offA=int64_t(batch)*p.M*p.K+
            (TA?int64_t(k0)*p.M+m0:int64_t(m0)*p.K+k0);
        AscendC::DataCopy(dstA,a[offA],qa);

        AscendC::Nd2NzParams qb{};qb.ndNum=1;
        qb.nValue=TB?nr:kr;qb.dValue=TB?kr:nr;
        qb.srcDValue=TB?p.K:p.N;qb.dstNzC0Stride=TB?nr:kr;qb.dstNzNStride=1;
        const int64_t offB=int64_t(batch)*p.K*p.N+
            (TB?int64_t(n0)*p.K+k0:int64_t(k0)*p.N+n0);
        AscendC::DataCopy(dstB,b[offB],qb);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1Ready[stage]);
    }

    __aicore__ inline void LoadL0(int mr,int nr,int kr,int stage){
        auto srcA=a1Buf.template Get<T>()[stage*TM*KB];
        auto srcB=b1Buf.template Get<T>()[stage*KB*TN];
        auto dstA=a2Buf.template Get<T>()[stage*TM*KB];
        auto dstB=b2Buf.template Get<T>()[stage*KB*TN];
        AscendC::LoadData2DParams la{};la.repeatTimes=kr/16;
        la.srcStride=TA?1:mr/16;la.ifTranspose=TA;
        for(int i=0;i<mr/16;++i){
            const int off=TA?i*kr*16:i*256;
            AscendC::LoadData(dstA[i*kr*16],srcA[off],la);
        }
        AscendC::LoadData2DParams lb{};lb.repeatTimes=nr/16;
        lb.srcStride=TB?1:kr/16;lb.ifTranspose=!TB;
        for(int j=0;j<kr/16;++j){
            const int off=TB?j*nr*16:j*256;
            AscendC::LoadData(dstB[j*nr*16],srcB[off],lb);
        }
        // Input L1 slot may be overwritten only after both LoadData streams.
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1Free[stage]);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(l0Ready[stage]);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(l0Ready[stage]);
    }

    __aicore__ inline void Emit(int group,int batch,int m0,int n0,int mr,int nr){
        // Two L0C slots: wait only when reusing the same C slot. The
        // other slot may still be read by Fixpipe while this tile accumulates.
        const int cSlot=seq&1;
        if(seq>=2)AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[cSlot]);
        const int kCount=(p.K+KB-1)/KB;
        LoadStage(batch,m0,n0,mr,nr,0,bmms83::MinI(KB,p.K),0);
        auto cc=cBuf.template Get<float>()[cSlot*TM*TN];
        for(int ki=0;ki<kCount;++ki){
            const int stage=ki&1,k0=ki*KB,kr=bmms83::MinI(KB,p.K-k0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1Ready[stage]);
            if(ki+1<kCount){
                const int next=stage^1,nextK=(ki+1)*KB;
                if(ki>=1)AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1Free[next]);
                LoadStage(batch,m0,n0,mr,nr,nextK,bmms83::MinI(KB,p.K-nextK),next);
            }
            if(ki>=2)AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0Free[stage]);
            LoadL0(mr,nr,kr,stage);
            auto aa=a2Buf.template Get<T>()[stage*TM*KB];
            auto bb=b2Buf.template Get<T>()[stage*KB*TN];
            AscendC::MmadParams q{};q.m=mr;q.n=nr;q.k=kr;q.cmatrixInitVal=(ki==0);
            AscendC::Mmad(cc,aa,bb,q);
            AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0Free[stage]);
        }
        // Drain exactly the outstanding credits, leaving all input slots
        // empty before the next output tile starts its own staged K loop.
        for(int stage=0;stage<bmms83::MinI(2,kCount);++stage){
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1Free[stage]);
            AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0Free[stage]);
        }
        AscendC::SetFlag<AscendC::HardEvent::M_FIX>(cReady);
        AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(cReady);
        const int slot=seq&1;
        if(seq>=2)AscendC::CrossCoreWaitFlag<0x2>(FREE+slot);
        AscendC::FixpipeParamsV220 f{};f.nSize=nr;f.mSize=mr;f.srcStride=mr;
        f.dstStride=TN;f.ndNum=1;f.quantPre=QuantMode_t::NoQuant;
        AscendC::Fixpipe<float,float>(ring[(int64_t(group)*2+slot)*TM*TN],cc,f);
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree[cSlot]);
        AscendC::CrossCoreSetFlag<0x2,PIPE_FIX>(READY+slot);
        ++seq;
    }

public:
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR z,GM_ADDR r,const Plan& plan,AscendC::TPipe* pipe){
        p=plan;pipe_=pipe;
        for(int s=0;s<2;++s){
            l1Ready[s]=pipe_->AllocEventID<AscendC::HardEvent::MTE2_MTE1>();
            l1Free[s]=pipe_->AllocEventID<AscendC::HardEvent::MTE1_MTE2>();
            l0Ready[s]=pipe_->AllocEventID<AscendC::HardEvent::MTE1_M>();
            l0Free[s]=pipe_->AllocEventID<AscendC::HardEvent::M_MTE1>();
        }
        cReady=pipe_->AllocEventID<AscendC::HardEvent::M_FIX>();
        for(int s=0;s<2;++s)cFree[s]=pipe_->AllocEventID<AscendC::HardEvent::FIX_M>();
        a.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x),int64_t(p.B)*p.M*p.K);
        b.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z),int64_t(p.B)*p.K*p.N);
        ring.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(r),int64_t(p.blocks)*2*TM*TN);
        pipe->InitBuffer(a1Buf,2*TM*KB*sizeof(T));pipe->InitBuffer(b1Buf,2*KB*TN*sizeof(T));
        pipe->InitBuffer(a2Buf,2*TM*KB*sizeof(T));pipe->InitBuffer(b2Buf,2*KB*TN*sizeof(T));
        pipe->InitBuffer(cBuf,2*TM*TN*sizeof(float));
    }

    __aicore__ inline void Process(){
        const int group=AscendC::GetBlockIdx(),perBatch=p.pM*p.pN;
        for(int task=group;task<p.tasks;task+=p.blocks){
            const int batch=task/perBatch,slot=task-batch*perBatch;
            const int ms=slot/p.pN,ns=slot-ms*p.pN;
            const int mt0=ms*p.mTiles/p.pM,mt1=(ms+1)*p.mTiles/p.pM;
            const int nt0=ns*p.nTiles/p.pN,nt1=(ns+1)*p.nTiles/p.pN;
            const int mBegin=mt0*TM,mEnd=bmms83::MinI(mt1*TM,p.M);
            const int nBegin=nt0*TN,nEnd=bmms83::MinI(nt1*TN,p.N);
            // This AM/BN/mo/no order is a protocol, not just a loop preference:
            // it must match bmms83::SmallKConsumer for every task and tail.
            for(int mBase=mBegin;mBase<mEnd;mBase+=AM){
                const int ar=bmms83::MinI(AM,mEnd-mBase);
                for(int nBase=nBegin;nBase<nEnd;nBase+=BN){
                    const int br=bmms83::MinI(BN,nEnd-nBase);
                    for(int mo=0;mo<ar;mo+=TM){
                        for(int no=0;no<br;no+=TN){
                            Emit(group,batch,mBase+mo,nBase+no,
                                bmms83::MinI(TM,ar-mo),bmms83::MinI(TN,br-no));
                        }
                    }
                }
            }
        }
        for(int s=0;s<bmms83::MinI(2,seq);++s)AscendC::CrossCoreWaitFlag<0x2>(FREE+s);
        for(int s=0;s<bmms83::MinI(2,seq);++s)AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[s]);
        for(int s=0;s<2;++s){
            pipe_->ReleaseEventID<AscendC::HardEvent::MTE2_MTE1>(l1Ready[s]);
            pipe_->ReleaseEventID<AscendC::HardEvent::MTE1_MTE2>(l1Free[s]);
            pipe_->ReleaseEventID<AscendC::HardEvent::MTE1_M>(l0Ready[s]);
            pipe_->ReleaseEventID<AscendC::HardEvent::M_MTE1>(l0Free[s]);
        }
        pipe_->ReleaseEventID<AscendC::HardEvent::M_FIX>(cReady);
        for(int s=0;s<2;++s)pipe_->ReleaseEventID<AscendC::HardEvent::FIX_M>(cFree[s]);
    }
};

#ifndef BMMS9_CPU_TEST
template<class T,bool TA,bool TB>
__aicore__ inline void Entry(GM_ADDR a,GM_ADDR b,GM_ADDR y,GM_ADDR ring,GM_ADDR partial,Plan p){
    AscendC::TPipe pipe;
    if ASCEND_IS_AIC {StagedProducer<T,TA,TB> op;op.Init(a,b,ring,p,&pipe);op.Process();}
    if ASCEND_IS_AIV {bmms83::SmallKConsumer op;op.Init(ring,partial,y,p,&pipe);op.Process();}
}
#endif
} // namespace bmms9d
// BMMS9_CPU_EXTRACT_END

#define BMMS9D_KERNEL(NAME,T,TA,TB) \
__schedmode__(1) __global__ __mix__(1,2) void NAME(GM_ADDR a,GM_ADDR b,GM_ADDR y,GM_ADDR ring,GM_ADDR part,bmms9d::Plan p){bmms9d::Entry<T,TA,TB>(a,b,y,ring,part,p);}
BMMS9D_KERNEL(bmms9d_f16_nn,half,false,false)
BMMS9D_KERNEL(bmms9d_f16_nt,half,false,true)
BMMS9D_KERNEL(bmms9d_f16_tn,half,true,false)
BMMS9D_KERNEL(bmms9d_f16_tt,half,true,true)
BMMS9D_KERNEL(bmms9d_b16_nn,bfloat16_t,false,false)
BMMS9D_KERNEL(bmms9d_b16_nt,bfloat16_t,false,true)
BMMS9D_KERNEL(bmms9d_b16_tn,bfloat16_t,true,false)
BMMS9D_KERNEL(bmms9d_b16_tt,bfloat16_t,true,true)
#undef BMMS9D_KERNEL

namespace bmms9d {
static inline bool TryLaunch(GM_ADDR a,GM_ADDR b,GM_ADDR y,
    int32_t B,int32_t M,int32_t N,int32_t K,int32_t dtype,bool ta,bool tb,
    int32_t cores,aclrtStream stream){
    if(B<1||B>64||cores<1||cores>64||(dtype!=1&&dtype!=2)||!Eligible(M,N,K)||
       int64_t(B)*M*K>(1LL<<26)||int64_t(B)*N*K>(1LL<<26))return false;
    const auto family=bmms8::Classify(B,M,N,K,ta,tb);
    if(family==bmms8::Family::Resident||family==bmms8::Family::Tiny)return false;
    const auto p=MakePlan(B,M,N,K,cores);
    uint8_t* ws=nullptr;
    if(aclrtMalloc(reinterpret_cast<void**>(&ws),WorkspaceBytes(p),ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)std::abort();
    uint8_t* partial=ws+RingBytes(p);
#define BMMS9D_LAUNCH(NAME) NAME<<<p.blocks,nullptr,stream>>>(a,b,y,ws,partial,p)
    if(dtype==1){
        if(!ta&&!tb){BMMS9D_LAUNCH(bmms9d_f16_nn);}
        else if(!ta&&tb){BMMS9D_LAUNCH(bmms9d_f16_nt);}
        else if(ta&&!tb){BMMS9D_LAUNCH(bmms9d_f16_tn);}
        else{BMMS9D_LAUNCH(bmms9d_f16_tt);}
    }else{
        if(!ta&&!tb){BMMS9D_LAUNCH(bmms9d_b16_nn);}
        else if(!ta&&tb){BMMS9D_LAUNCH(bmms9d_b16_nt);}
        else if(ta&&!tb){BMMS9D_LAUNCH(bmms9d_b16_tn);}
        else{BMMS9D_LAUNCH(bmms9d_b16_tt);}
    }
#undef BMMS9D_LAUNCH
    if(aclrtSynchronizeStream(stream)!=ACL_SUCCESS)std::abort();
    if(aclrtFree(ws)!=ACL_SUCCESS)std::abort();
    return true;
}
} // namespace bmms9d
#endif // BMMS9D_DENSE_FRAGMENT_INCLUDED
