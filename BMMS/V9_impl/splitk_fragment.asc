// V9 S: small-output / long-K NT Vector microkernel with deterministic K shards.
// Append after the inherited P01 definitions, before its public run_kernel.
// No independent CANN certification is implied by the CPU arithmetic checks.
#ifndef BMMS9S_MAX_MN
#define BMMS9S_MAX_MN 256
#endif

namespace bmms9s {
constexpr int32_t KB = 256;
constexpr int32_t RECORD_FLOATS = 8;
struct Plan {
    int32_t B, M, N, K, mn, splits, tasks, workers;
};
static inline int32_t UpH(int32_t x, int32_t y) { return (x+y-1)/y; }
static inline int32_t MinH(int32_t x, int32_t y) { return x<y?x:y; }
static inline bool Eligible(int32_t B,int32_t M,int32_t N,int32_t K,
                            int32_t cores,bool ta,bool tb) {
    // NT is the physical [M,K] x [N,K] layout: both dot operands are contiguous.
    // NN/TN/TT and all other input families continue through the P01 dispatcher.
    return !ta && tb && B>=1 && B<=64 && M>=2 && M<=32 && N>=2 && N<=64 &&
        M*N<=BMMS9S_MAX_MN && M*N<=2048 && K>=1024 && K<=8192 && K%8==0 &&
        cores>=1 && cores<=64 && B*UpH(M,16)*UpH(N,16)<cores;
}
static inline Plan MakePlan(int32_t B,int32_t M,int32_t N,int32_t K,int32_t cores) {
    Plan p{B,M,N,K,M*N,1,0,0};
    // Split only when independent dots cannot occupy the available Vector cores.
    // A shard has at least approximately 1024 K terms; partitions use 8-term units.
    p.splits=MinH(UpH(2*cores,B*p.mn),K/1024);
    if(p.splits<1)p.splits=1;
    p.tasks=B*p.mn*p.splits;p.workers=MinH(2*cores,p.tasks);
    return p;
}
static inline uint64_t WorkspaceBytes(const Plan& p) {
    return uint64_t(p.tasks)*RECORD_FLOATS*sizeof(float);
}

// Normalized FP32 expansion. Every scalar addition is explicitly rounded to
// float in source; do not compile this candidate with reassociative fast-math.
// This retains a low component, but is not a proof of full FP64 equivalence.
__aicore__ inline void AddScalar(float& hi,float& lo,float x) {
    const float s=hi+x;
    const float v=s-hi;
    const float e=(hi-(s-v))+(x-v);
    const float t=lo+e;
    const float h=s+t;
    const float w=h-s;
    const float l=(s-(h-w))+(t-w);
    hi=h;lo=l;
}
__aicore__ inline void AddPair(float& hi,float& lo,float xh,float xl) {
    AddScalar(hi,lo,xh);AddScalar(hi,lo,xl);
}
__aicore__ inline bool PairGreater(float ah,float al,float bh,float bl) {
    // AddScalar normalizes each finite expansion before this comparison.
    return ah>bh || (ah==bh && al>bl);
}

template<class T>
__aicore__ inline void Device(GM_ADDR a,GM_ADDR b,GM_ADDR y,GM_ADDR workspace,
                              const Plan& p) {
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN,1> iq;
    AscendC::TQue<AscendC::TPosition::VECOUT,1> oq;
    AscendC::TBuf<AscendC::TPosition::VECCALC> fbuf,loBuf,sumBuf,bpBuf,errBuf;
    AscendC::TBuf<AscendC::TPosition::VECIN> finalBuf;
    const int32_t batchRecordFloats=p.mn*p.splits*RECORD_FLOATS;
    pipe.InitBuffer(iq,1,2*KB*sizeof(T));
    pipe.InitBuffer(oq,1,RECORD_FLOATS*sizeof(float));
    pipe.InitBuffer(fbuf,2*KB*sizeof(float));
    pipe.InitBuffer(loBuf,KB*sizeof(float));
    pipe.InitBuffer(sumBuf,(KB/2)*sizeof(float));
    pipe.InitBuffer(bpBuf,(KB/2)*sizeof(float));
    pipe.InitBuffer(errBuf,(KB/2)*sizeof(float));
    pipe.InitBuffer(finalBuf,batchRecordFloats*sizeof(float));
    auto hi=fbuf.Get<float>();auto rhs=hi[KB];auto lo=loBuf.Get<float>();
    auto sum=sumBuf.Get<float>(),bp=bpBuf.Get<float>(),err=errBuf.Get<float>();
    auto final=finalBuf.Get<float>();
    AscendC::GlobalTensor<T> ga,gb;
    AscendC::GlobalTensor<float> gp,gy;
    ga.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(a),int64_t(p.B)*p.M*p.K);
    gb.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(b),int64_t(p.B)*p.N*p.K);
    gp.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(workspace),
                       int64_t(p.tasks)*RECORD_FLOATS);
    gy.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y),p.B);
    const int32_t worker=AscendC::GetBlockIdx();
    const int32_t kUnits=p.K/8;
    for(int32_t task=worker;task<p.tasks;task+=p.workers) {
        const int32_t ks=task%p.splits,dot=task/p.splits;
        const int32_t batch=dot/p.mn,cell=dot%p.mn,m=cell/p.N,n=cell%p.N;
        const int32_t kBegin=(ks*kUnits/p.splits)*8;
        const int32_t kEnd=((ks+1)*kUnits/p.splits)*8;
        float taskHi=0.0f,taskLo=0.0f;
        for(int32_t k0=kBegin;k0<kEnd;k0+=KB) {
            const int32_t live=(kEnd-k0)<KB?(kEnd-k0):KB;
            auto in=iq.AllocTensor<T>();
            // The complete reduction tree always has KB entries. Inactive tail
            // entries are initialized before DMA, and only live GM terms are read.
            AscendC::Duplicate(in,T(0),2*KB);
            bmms71::Fence<AscendC::HardEvent::V_MTE2>(pipe);
            AscendC::DataCopyExtParams cp{1,uint32_t(live*sizeof(T)),0,0,0};
            const int32_t aligned=(live+15)/16*16;
            AscendC::DataCopyPadExtParams<T> pad{
                true,0,static_cast<uint8_t>(aligned-live),T(0)};
            AscendC::DataCopyPad(in,ga[(int64_t(batch)*p.M+m)*p.K+k0],cp,pad);
            AscendC::DataCopyPad(in[KB],gb[(int64_t(batch)*p.N+n)*p.K+k0],cp,pad);
            iq.EnQue(in);in=iq.DeQue<T>();
            AscendC::Cast(hi,in,AscendC::RoundMode::CAST_NONE,KB);
            AscendC::Cast(rhs,in[KB],AscendC::RoundMode::CAST_NONE,KB);
            AscendC::Duplicate(lo,0.0f,KB);AscendC::PipeBarrier<PIPE_V>();
            AscendC::Mul(hi,hi,rhs,KB);AscendC::PipeBarrier<PIPE_V>();
            // Disjoint, 32B-aligned halves; PairAccumulate is the existing P01
            // vector TwoSum primitive. Keep every pair's low term through K.
            for(int32_t count=KB;count>8;count/=2) {
                const int32_t half=count/2;
                bmms8::PairAccumulate(hi,lo,hi[half],sum,bp,err,half);
                AscendC::Add(lo,lo,lo[half],half);AscendC::PipeBarrier<PIPE_V>();
            }
            bmms71::Fence<AscendC::HardEvent::V_S>(pipe);
            for(int32_t lane=0;lane<8;++lane)
                AddPair(taskHi,taskLo,hi.GetValue(lane),lo.GetValue(lane));
            // Scalar has finished consuming the pair tree before Vector reuses it.
            bmms71::Fence<AscendC::HardEvent::S_V>(pipe);
            iq.FreeTensor(in);
        }
        auto rec=oq.AllocTensor<float>();
        // AllocTensor recycles through MTE3->V; connect that dependency to
        // Scalar before SetValue overwrites a record used by the previous DMA.
        bmms71::Fence<AscendC::HardEvent::V_S>(pipe);
        for(int32_t j=0;j<RECORD_FLOATS;++j)rec.SetValue(j,0.0f);
        rec.SetValue(0,taskHi);rec.SetValue(1,taskLo);
        bmms71::Fence<AscendC::HardEvent::S_V>(pipe);
        oq.EnQue(rec);rec=oq.DeQue<float>();
        // Each task owns a complete 32B record; distinct writers never share it.
        AscendC::DataCopyExtParams wc{1,uint32_t(RECORD_FLOATS*sizeof(float)),0,0,0};
        AscendC::DataCopyPad(gp[int64_t(task)*RECORD_FLOATS],rec,wc);
        oq.FreeTensor(rec);
    }
    // All workers are resident: __schedmode__(1), Vector workers <= 2*core budget.
    // Only this all-AIV launch participates; no Cube server/application deadlock.
    bmms71::Fence<AscendC::HardEvent::MTE3_MTE2>(pipe);
    AscendC::SyncAll<true>();
    for(int32_t batch=worker;batch<p.B;batch+=p.workers) {
        AscendC::DataCopyExtParams rc{1,uint32_t(batchRecordFloats*sizeof(float)),0,0,0};
        AscendC::DataCopyPadExtParams<float> np{false,0,0,0.0f};
        AscendC::DataCopyPad(final,gp[int64_t(batch)*batchRecordFloats],rc,np);
        bmms71::Fence<AscendC::HardEvent::MTE2_S>(pipe);
        float totalHi=0.0f,totalLo=0.0f;
        for(int32_t m=0;m<p.M;++m) {
            float rowHi=0.0f,rowLo=0.0f;
            for(int32_t n=0;n<p.N;++n) {
                float dotHi=0.0f,dotLo=0.0f;
                const int32_t first=(m*p.N+n)*p.splits*RECORD_FLOATS;
                // Merge ALL K shards in an invariant order BEFORE any N-Max.
                for(int32_t ks=0;ks<p.splits;++ks) {
                    const int32_t off=first+ks*RECORD_FLOATS;
                    AddPair(dotHi,dotLo,final.GetValue(off),final.GetValue(off+1));
                }
                if(n==0 || PairGreater(dotHi,dotLo,rowHi,rowLo)) {
                    rowHi=dotHi;rowLo=dotLo;
                }
            }
            // Keep the winning low component through the Sum(M), avoiding an
            // intermediate FP32 C rounding before strongly cancelling rows.
            AddPair(totalHi,totalLo,rowHi,rowLo);
        }
        auto out=oq.AllocTensor<float>();
        bmms71::Fence<AscendC::HardEvent::V_S>(pipe);
        out.SetValue(0,totalHi+totalLo);
        bmms71::Fence<AscendC::HardEvent::S_V>(pipe);
        oq.EnQue(out);out=oq.DeQue<float>();
        AscendC::DataCopyExtParams yc{1,sizeof(float),0,0,0};
        AscendC::DataCopyPad(gy[batch],out,yc);oq.FreeTensor(out);
        // The next batch can reuse the non-queue final buffer after Scalar reads.
        bmms71::Fence<AscendC::HardEvent::V_MTE2>(pipe);
    }
}
} // namespace bmms9s

// BMMS9_CPU_EXTRACT_END

__schedmode__(1) __global__ __mix__(0,1) void bmms9s_nt_f16(
    GM_ADDR a,GM_ADDR b,GM_ADDR y,GM_ADDR partial,bmms9s::Plan p) {
    bmms9s::Device<half>(a,b,y,partial,p);
}
__schedmode__(1) __global__ __mix__(0,1) void bmms9s_nt_b16(
    GM_ADDR a,GM_ADDR b,GM_ADDR y,GM_ADDR partial,bmms9s::Plan p) {
    bmms9s::Device<bfloat16_t>(a,b,y,partial,p);
}

namespace bmms9s {
static inline bool TryLaunch(GM_ADDR a,const TensorGroupInfo& ia,
    GM_ADDR b,const TensorGroupInfo& ib,GM_ADDR y,const TensorGroupInfo& iy,
    int64_t availableCoreNum,aclrtStream stream,bool ta,bool tb) {
    // Caller performs the inherited public contract checks before this hook.
    (void)iy;
    const auto& x=ia.tensors[0];
    const auto& z=ib.tensors[0];
    const int32_t B=int32_t(x.shape[0]),M=int32_t(x.shape[ta?2:1]);
    const int32_t K=int32_t(x.shape[ta?1:2]),N=int32_t(z.shape[tb?1:2]);
    const int32_t cores=availableCoreNum>0&&availableCoreNum<=64?int32_t(availableCoreNum):1;
    if(!Eligible(B,M,N,K,cores,ta,tb))return false;
    const Plan p=MakePlan(B,M,N,K,cores);
    uint8_t* partial=nullptr;
    if(aclrtMalloc(reinterpret_cast<void**>(&partial),WorkspaceBytes(p),
                    ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)std::abort();
    if(x.dtype==1)bmms9s_nt_f16<<<p.workers,nullptr,stream>>>(a,b,y,partial,p);
    else bmms9s_nt_b16<<<p.workers,nullptr,stream>>>(a,b,y,partial,p);
    if(aclrtSynchronizeStream(stream)!=ACL_SUCCESS)std::abort();
    if(aclrtFree(partial)!=ACL_SUCCESS)std::abort();
    return true;
}
} // namespace bmms9s
