// BatchMatmulMaxSum V8.0d full-route repair, CANN 9.0 / dav-2201.
// All V8.0 route families and Lane-GEMV entries remain enabled in their original domains.
// Repairs: device execution qualifiers, padded UB row pitch, scratch bounds,
// Vector/Scalar/DMA dependencies, compensated Sum-lane arithmetic, and documented tiling.
// Not certified by a Bisheng/A2 run. See PATCH.md and reproducible checks.
// Base: V7.1 hybrid (V4.3 generic Matmul + V7 Resident/continuous-Skinny).
// Added: explicit input-family classifier and K-specific family plans for K=32/64/128.
// Default MIX Matmul mode only. DO NOT add ASCENDC_CUBE_ONLY to this file.
// One successful runtime call -> one selected real device kernel launch.
// Every new K-specific route can reject before launch and fall back to V7.1 generic.
// This is a source candidate: Bisheng/CANN 9.0 + A2/Judge validation is still required.

#include <cstdint>
#include <cstdlib>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "lib/matmul/bmm_tiling.h"

// BatchMatmulMaxSum V4.3: N-aligned Cube->VECIN fast path + safe GM-stripe fallback.
// CANN 9.0 / Atlas A2. Include this file from the unmodified official main.asc.
// TensorInfo and TensorGroupInfo are supplied by that main.asc.
// One runtime branch, one real device launch. No host-side tensor computation.
namespace bmmmaxsum_v43 {

constexpr uint64_t SYSTEM_WORKSPACE_BYTES = 16ULL * 1024ULL * 1024ULL;
constexpr uint64_t MAX_USER_WORKSPACE_BYTES = 128ULL * 1024ULL * 1024ULL;
constexpr int32_t MAX_M = 8192;
constexpr int32_t UB_FLOATS = 8192;          // safe GM-stripe path
constexpr int32_t FAST_C_FLOATS = 16384;      // allow up to 64 KiB C when UB headroom permits
constexpr uint32_t FAST_APP_UB_BYTES = 97U * 1024U; // matches proven app-side UB envelope
constexpr float NEG_INF = -__builtin_inff();

// tileM is a COMPUTE tile, not an entire M shard. One persistent task owns
// (batch,mShard,nShard) and processes all its M tiles before moving on.
struct Plan {
    int32_t B, M, N, K;
    int32_t tileM, vecN;
    int32_t mTiles, nTiles, pM, pN;
    int32_t mPitch, nPitch, paddedM;
    int32_t tasks, blocks, workers, direct;
};

__aicore__ inline int32_t MinI(int32_t a, int32_t b) { return a < b ? a : b; }

template <AscendC::HardEvent E>
__aicore__ inline void Fence(AscendC::TPipe& pipe)
{
    const auto id = static_cast<event_t>(pipe.FetchEventID(E));
    AscendC::SetFlag<E>(id);
    AscendC::WaitFlag<E>(id);
}

// Degenerate logical M=N=1: real vector dot product, not a dummy launch.
// Both input storage layouts become contiguous [B,K] in this case.
template <typename T>
__aicore__ inline void DotDevice(GM_ADDR a, GM_ADDR b, GM_ADDR y,
                               int32_t B, int32_t K, int32_t workers)
{
    AscendC::TPipe pipe;
    const int32_t kPad = (K + 15) / 16 * 16;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inputQ;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outputQ;
    AscendC::TBuf<AscendC::TPosition::VECCALC> floatBuf, scratchBuf;
    pipe.InitBuffer(inputQ, 1, 2 * kPad * sizeof(T));
    pipe.InitBuffer(outputQ, 1, 32);
    pipe.InitBuffer(floatBuf, 2 * kPad * sizeof(float));
    pipe.InitBuffer(scratchBuf, kPad * sizeof(float));
    AscendC::GlobalTensor<T> ga, gb;
    AscendC::GlobalTensor<float> gy;
    ga.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(a), int64_t(B) * K);
    gb.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(b), int64_t(B) * K);
    gy.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), B);
    const int32_t id = static_cast<int32_t>(AscendC::GetBlockIdx());
    for (int32_t batch = id; batch < B; batch += workers) {
        auto in = inputQ.AllocTensor<T>();
        AscendC::DataCopyExtParams cp{1, uint32_t(K * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> pad{false, 0, 0, 0};
        AscendC::DataCopyPad(in, ga[int64_t(batch) * K], cp, pad);
        AscendC::DataCopyPad(in[kPad], gb[int64_t(batch) * K], cp, pad);
        inputQ.EnQue(in);
        in = inputQ.DeQue<T>();
        auto fa = floatBuf.Get<float>();
        auto fb = fa[kPad];
        AscendC::Cast(fa, in, AscendC::RoundMode::CAST_NONE, K);
        AscendC::Cast(fb, in[kPad], AscendC::RoundMode::CAST_NONE, K);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(fa, fa, fb, K);
        AscendC::PipeBarrier<PIPE_V>();
        auto out = outputQ.AllocTensor<float>();
        AscendC::ReduceSum(out, fa, scratchBuf.Get<float>(), K);
        outputQ.EnQue(out);
        out = outputQ.DeQue<float>();
        // Exact four-byte store: multiple batches may share a GM cache line.
        AscendC::DataCopyExtParams op{1, sizeof(float), 0, 0, 0};
        AscendC::DataCopyPad(gy[batch], out, op);
        outputQ.FreeTensor(out);
        inputQ.FreeTensor(in);
    }
}

// BMMS_V31_BEGIN_TINY_DEVICE
// Tiny *general* matrices: gather by physical layout in UB, then FP32 dot /
// Max(N) / Sum(M). No mathematical transpose, no low-precision accumulation.
template <typename T, bool TA, bool TB>
__aicore__ inline void TinyDevice(GM_ADDR a, GM_ADDR b, GM_ADDR y,
    int32_t B, int32_t M, int32_t N, int32_t K, int32_t workers)
{
    AscendC::TPipe pipe;
    const int32_t ar = (M * K + 15) / 16 * 16;
    const int32_t br = (N * K + 15) / 16 * 16;
    const int32_t af = (M * K + 7) / 8 * 8;
    const int32_t bf = (N * K + 7) / 8 * 8;
    const int32_t kp = (K + 7) / 8 * 8;
    const int32_t dotPad = (N + 7) / 8 * 64;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> iq;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> oq;
    AscendC::TBuf<AscendC::TPosition::VECCALC> fbuf, idxbuf, packbuf, scratch, vals;
    pipe.InitBuffer(iq, 1, (ar + br) * sizeof(T));
    pipe.InitBuffer(oq, 1, 32);
    pipe.InitBuffer(fbuf, (af + bf) * sizeof(float));
    pipe.InitBuffer(idxbuf, 2 * kp * sizeof(int32_t));
    pipe.InitBuffer(packbuf, (N + 2) * kp * sizeof(float));
    pipe.InitBuffer(scratch, (kp > 8 * M ? kp : 8 * M) * sizeof(float));
    pipe.InitBuffer(vals, (dotPad + 8 * M) * sizeof(float));
    auto ia = idxbuf.Get<int32_t>();
    auto ib = ia[kp];
    AscendC::CreateVecIndex(ia, int32_t(0), K);
    AscendC::CreateVecIndex(ib, int32_t(0), K);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::Muls(ia, ia, int32_t((TA ? M : 1) * sizeof(float)), K);
    AscendC::Muls(ib, ib, int32_t((TB ? 1 : N) * sizeof(float)), K);
    AscendC::PipeBarrier<PIPE_V>();
    auto iau = ia.template ReinterpretCast<uint32_t>();
    auto ibu = ib.template ReinterpretCast<uint32_t>();
    auto fa = fbuf.Get<float>();
    auto fb = fa[af];
    auto bp = packbuf.Get<float>();
    auto av = bp[N * kp];
    auto prod = av[kp];
    auto tmp = scratch.Get<float>();
    auto dots = vals.Get<float>();
    auto rows = dots[dotPad];
    AscendC::GlobalTensor<T> ga, gb;
    AscendC::GlobalTensor<float> gy;
    ga.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(a), int64_t(B) * M * K);
    gb.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(b), int64_t(B) * N * K);
    gy.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), B);
    const int32_t id = static_cast<int32_t>(AscendC::GetBlockIdx());
    for (int32_t batch = id; batch < B; batch += workers) {
        auto in = iq.AllocTensor<T>();
        AscendC::DataCopyPadExtParams<T> pad{false, 0, 0, 0};
        AscendC::DataCopyExtParams acp{1, uint32_t(M * K * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyExtParams bcp{1, uint32_t(N * K * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPad(in, ga[int64_t(batch) * M * K], acp, pad);
        AscendC::DataCopyPad(in[ar], gb[int64_t(batch) * N * K], bcp, pad);
        iq.EnQue(in);
        in = iq.DeQue<T>();
        AscendC::Cast(fa, in, AscendC::RoundMode::CAST_NONE, M * K);
        AscendC::Cast(fb, in[ar], AscendC::RoundMode::CAST_NONE, N * K);
        AscendC::Duplicate(rows, 0.0f, 8 * M);
        AscendC::PipeBarrier<PIPE_V>();
        for (int32_t n = 0; n < N; ++n) {
            AscendC::Gather(bp[n * kp], fb, ibu,
                uint32_t((TB ? n * K : n) * sizeof(float)), K);
        }
        AscendC::PipeBarrier<PIPE_V>();
        for (int32_t m = 0; m < M; ++m) {
            AscendC::Gather(av, fa, iau,
                uint32_t((TA ? m : m * K) * sizeof(float)), K);
            AscendC::Duplicate(dots, NEG_INF, dotPad);
            AscendC::PipeBarrier<PIPE_V>();
            for (int32_t n = 0; n < N; ++n) {
                AscendC::Mul(prod, av, bp[n * kp], K);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::ReduceSum(dots[n * 8], prod, tmp, K);
                AscendC::PipeBarrier<PIPE_V>();
            }
            if (N > 8) {
                AscendC::Max(dots, dots, dots[64], 64);
                AscendC::PipeBarrier<PIPE_V>();
            }
            AscendC::WholeReduceMax(rows[m * 8], dots, MinI(64, N * 8),
                1, 1, 1, 8, AscendC::ReduceOrder::ORDER_ONLY_VALUE);
            AscendC::PipeBarrier<PIPE_V>();
        }
        auto out = oq.AllocTensor<float>();
        AscendC::ReduceSum(out, rows, tmp, M * 8);
        oq.EnQue(out);
        out = oq.DeQue<float>();
        AscendC::DataCopyExtParams cp{1, sizeof(float), 0, 0, 0};
        AscendC::DataCopyPad(gy[batch], out, cp);
        oq.FreeTensor(out);
        iq.FreeTensor(in);
    }
}
// BMMS_V31_END_TINY_DEVICE


template <typename T, bool TA, bool TB>
class SafeFusedDevice {
public:
    using AType = matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, TA>;
    using BType = matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, TB>;
    using CType = matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>;
    matmul::Matmul<AType, BType, CType> mm;
    TCubeTiling tiling;

    __aicore__ inline void Init(GM_ADDR a, GM_ADDR b, GM_ADDR y,
        GM_ADDR partials, GM_ADDR tiles, const Plan& plan, AscendC::TPipe* pipe)
    {
        p = plan;
        pipe_ = pipe;
        ga.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(a), int64_t(p.B)*p.M*p.K);
        gb.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(b), int64_t(p.B)*p.K*p.N);
        gy.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), p.B);
        gp.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partials),
            p.direct ? 0 : int64_t(p.B)*p.pN*p.paddedM);
        gt.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(tiles),
            int64_t(p.workers)*p.tileM*p.nPitch);

        // 96 KiB plus <=544 B application UB. The same buffers are reused by
        // the epilogue. The tiler is separately given a 64 KiB UB budget.
        pipe->InitBuffer(cQueue, 1, UB_FLOATS*sizeof(float));
        pipe->InitBuffer(accBuf, UB_FLOATS*sizeof(float));
        pipe->InitBuffer(scratchBuf, MAX_M*sizeof(float));
        pipe->InitBuffer(rowQueue, 1, p.tileM*sizeof(float));
        pipe->InitBuffer(resultQueue, 1, 32);
    }

    __aicore__ inline void Process()
    {
        // MIX(1,1): GetBlockIdx is in [0,blocks), one issuing AIV per AIC.
        const int32_t worker = static_cast<int32_t>(AscendC::GetBlockIdx());
        const int32_t perBatch = p.pM*p.pN;
        for (int32_t task = worker; task < p.tasks; task += p.workers) {
            const int32_t batch = task/perBatch;
            const int32_t slot = task - batch*perBatch;
            const int32_t ms = slot/p.pN;
            // A bijection within each grid row; not a second task partition.
            const int32_t ns = (slot % p.pN + ms) % p.pN;
            const int32_t mBegin = (ms*p.mTiles)/p.pM;
            const int32_t mEnd = ((ms+1)*p.mTiles)/p.pM;
            const int32_t ntBegin = (ns*p.nTiles)/p.pN;
            const int32_t ntEnd = ((ns+1)*p.nTiles)/p.pN;
            const int32_t n0 = ntBegin*p.vecN;
            const int32_t cols = MinI(ntEnd*p.vecN, p.N) - n0;

            for (int32_t mt = mBegin; mt < mEnd; ++mt) {
                const int32_t m0 = mt*p.tileM;
                const int32_t rows = MinI(p.tileM, p.M-m0);
                ComputeTile(batch, m0, n0, rows, cols, worker);
                auto acc = accBuf.Get<float>();
                // Fold 128/256-wide rows to 64 lanes. Repeat stride stays at
                // the ORIGINAL row pitch. All active vector repeats <=128.
                for (int32_t off = 64; off < p.vecN; off += 64) {
                    AscendC::BinaryRepeatParams rp{
                        1, 1, 1, static_cast<uint8_t>(p.vecN/8),
                        static_cast<uint8_t>(p.vecN/8),
                        static_cast<uint8_t>(p.vecN/8)};
                    AscendC::Max(acc, acc, acc[off], 64, rows, rp);
                    AscendC::PipeBarrier<PIPE_V>();
                }

                if (p.direct) {
                    // A whole batch belongs to this persistent worker, even
                    // when M spans MANY compute tiles. Keep all row maxima in
                    // UB, eliminating partial GM traffic and the global barrier.
                    auto allRows = scratchBuf.Get<float>();
                    AscendC::WholeReduceMax(allRows[m0], acc, MinI(p.vecN,64),
                        rows, 1, 1, p.vecN/8,
                        AscendC::ReduceOrder::ORDER_ONLY_VALUE);
                    AscendC::PipeBarrier<PIPE_V>();
                } else {
                    auto row = rowQueue.AllocTensor<float>();
                    // Every padded M row is explicitly written, but never
                    // summed. M-shard boundaries and writes are >=64B aligned.
                    AscendC::Duplicate(row, 0.0f, p.tileM);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::WholeReduceMax(row, acc, MinI(p.vecN,64), rows,
                        1, 1, p.vecN/8, AscendC::ReduceOrder::ORDER_ONLY_VALUE);
                    rowQueue.EnQue(row);
                    row = rowQueue.DeQue<float>();
                    const int64_t dst =
                        (int64_t(batch)*p.pN+ns)*p.paddedM+m0;
                    AscendC::DataCopy(gp[dst], row, p.tileM);
                    rowQueue.FreeTensor(row);
                }
            }
            if (p.direct) FinishDirect(batch);
        }
        if (p.direct) return;  // Uniform for the entire launch, not per worker.

        // Complete this AIV's partial writes, then wait for ALL issuing AIVs.
        // All blocks are resident (__schedmode__(1), blocks<=availableCoreNum).
        // Do NOT use SyncAll<false> inside this AIV-only KFC client body: the
        // AIC side is running the Matmul server, not the application epilogue.
        Fence<AscendC::HardEvent::MTE3_MTE2>(*pipe_);
        AscendC::SyncAll<true>();
        for (int32_t batch = worker; batch < p.B; batch += p.workers) {
            FinishMerged(batch);
        }
    }

private:
    __aicore__ inline void ComputeTile(int32_t batch, int32_t m0, int32_t n0,
        int32_t rows, int32_t cols, int32_t worker)
    {
        const int64_t ao = int64_t(batch)*p.M*p.K +
            (TA ? int64_t(m0) : int64_t(m0)*p.K);
        const int64_t bo = int64_t(batch)*p.K*p.N +
            (TB ? int64_t(n0)*p.K : int64_t(n0));
        const int64_t tileOffset = int64_t(worker)*p.tileM*p.nPitch;
        auto stripe = gt[tileOffset];
        auto acc = accBuf.Get<float>();
        AscendC::Duplicate(acc, NEG_INF, rows*p.vecN);
        AscendC::PipeBarrier<PIPE_V>();

        // Global original strides are NOT replaced by shard dimensions.
        // orgKc=nPitch gives C an explicit, worker-private row pitch.
        mm.SetOrgShape(p.M, p.N, p.K, p.K, p.nPitch);
        mm.SetTensorA(ga[ao], TA);
        mm.SetTensorB(gb[bo], TB);
        mm.SetSingleShape(rows, cols, p.K);
        mm.template IterateAll<true>(stripe, 0, false);
        mm.End();

        for (int32_t n = 0; n < cols; n += p.vecN) {
            const int32_t liveN = MinI(p.vecN, cols-n);
            const int32_t alignedN = (liveN+7)/8*8;
            auto c = cQueue.AllocTensor<float>();
            if (liveN == p.vecN && p.nPitch == p.vecN) {
                AscendC::DataCopy(c, stripe[n], rows*p.vecN);
            } else {
                // Common full tiles need no UB fill. Only true N tails leave
                // holes; fill holes with -INF, never zero or stale UB values.
                if (alignedN < p.vecN) {
                    AscendC::Duplicate(c, NEG_INF, rows*p.vecN);
                    Fence<AscendC::HardEvent::V_MTE2>(*pipe_);
                }
                AscendC::DataCopyExtParams cp{
                    static_cast<uint16_t>(rows), uint32_t(liveN*sizeof(float)),
                    uint32_t((p.nPitch-liveN)*sizeof(float)),
                    uint32_t((p.vecN-alignedN)/8), 0};
                AscendC::DataCopyPadExtParams<float> pad{
                    true, 0, static_cast<uint8_t>(alignedN-liveN), NEG_INF};
                AscendC::DataCopyPad(c, stripe[n], cp, pad);
            }
            cQueue.EnQue(c);
            c = cQueue.DeQue<float>();
            AscendC::Max(acc, acc, c, rows*p.vecN);
            AscendC::PipeBarrier<PIPE_V>();
            cQueue.FreeTensor(c);
        }
        // Cube may overwrite this GM slot only after every MTE2 read finishes.
        Fence<AscendC::HardEvent::MTE2_S>(*pipe_);
    }

    __aicore__ inline void FinishDirect(int32_t batch)
    {
        auto out = resultQueue.AllocTensor<float>();
        // acc is now dead as a tile accumulator and may be reduction scratch.
        AscendC::ReduceSum(out, scratchBuf.Get<float>(), accBuf.Get<float>(), p.M);
        resultQueue.EnQue(out);
        out = resultQueue.DeQue<float>();
        AscendC::DataCopyExtParams cp{1, sizeof(float), 0, 0, 0};
        AscendC::DataCopyPad(gy[batch], out, cp);
        resultQueue.FreeTensor(out);
        // Next batch overwrites scratchBuf with Vector instructions, not MTE2.
        AscendC::PipeBarrier<PIPE_V>();
    }

    __aicore__ inline void FinishMerged(int32_t batch)
    {
        auto merged = accBuf.Get<float>();
        auto tmp = cQueue.AllocTensor<float>();
        const int64_t first = int64_t(batch)*p.pN*p.paddedM;
        AscendC::DataCopy(merged, gp[first], p.paddedM);
        Fence<AscendC::HardEvent::MTE2_V>(*pipe_);
        for (int32_t ns = 1; ns < p.pN; ++ns) {
            AscendC::DataCopy(tmp, gp[first+int64_t(ns)*p.paddedM], p.paddedM);
            Fence<AscendC::HardEvent::MTE2_V>(*pipe_);
            AscendC::Max(merged, merged, tmp, p.paddedM);
            AscendC::PipeBarrier<PIPE_V>();
            Fence<AscendC::HardEvent::V_MTE2>(*pipe_);
        }
        auto out = resultQueue.AllocTensor<float>();
        AscendC::ReduceSum(out, merged, scratchBuf.Get<float>(), p.M);
        resultQueue.EnQue(out);
        out = resultQueue.DeQue<float>();
        AscendC::DataCopyExtParams cp{1, sizeof(float), 0, 0, 0};
        AscendC::DataCopyPad(gy[batch], out, cp);
        resultQueue.FreeTensor(out);
        // Essential even when pN==1: next batch's DMA will overwrite merged.
        Fence<AscendC::HardEvent::V_MTE2>(*pipe_);
        cQueue.FreeTensor(tmp);
    }

    Plan p;
    AscendC::TPipe* pipe_;
    AscendC::GlobalTensor<T> ga, gb;
    AscendC::GlobalTensor<float> gy, gp, gt;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> cQueue;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> rowQueue, resultQueue;
    AscendC::TBuf<AscendC::TPosition::VECCALC> accBuf, scratchBuf;
};

template <typename T, bool TA, bool TB>
__aicore__ inline void SafeFusedEntry(GM_ADDR a, GM_ADDR b, GM_ADDR y,
    GM_ADDR partials, GM_ADDR tiles, TCubeTiling td, Plan p)
{
    AscendC::TPipe pipe;
    SafeFusedDevice<T,TA,TB> op;
    op.tiling = td;
    // Register on BOTH AIC and AIV, before any application InitBuffer.
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), op.mm, &op.tiling);
    if ASCEND_IS_AIV {
        op.Init(a,b,y,partials,tiles,p,&pipe);
        op.Process();
    }
}


// -----------------------------------------------------------------------------
// V4.3 LocalTensor-output interface path. Physical GM staging is SDK-specific;
// returning VECIN does NOT imply a direct L0C-to-UB hardware path on Atlas A2.
//
// This path requires N to be tile-aligned; M tails are supported explicitly.
// Every full tile has shape [tileM, vecN], while a final M tile may have fewer
// rows but always keeps the full vecN row pitch. One persistent task owns a complete
// (batch, mShard, nShard), so Matmul setup/End occurs once per shard rather
// than once per compute tile.
// -----------------------------------------------------------------------------
template <typename T, bool TA, bool TB>
class FastFusedDevice {
public:
    using AType = matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, TA>;
    using BType = matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, TB>;
    using CType = matmul::MatmulType<AscendC::TPosition::VECIN, CubeFormat::ND, float>;
    matmul::Matmul<AType, BType, CType> mm;
    TCubeTiling tiling;

    __aicore__ inline void Init(GM_ADDR a, GM_ADDR b, GM_ADDR y,
        GM_ADDR partials, const Plan& plan, AscendC::TPipe* pipe)
    {
        p = plan;
        pipe_ = pipe;
        ga.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(a), int64_t(p.B)*p.M*p.K);
        gb.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(b), int64_t(p.B)*p.K*p.N);
        gy.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), p.B);
        gp.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partials),
            p.direct ? 0 : int64_t(p.B)*p.pN*p.paddedM);

        // Keep application UB within the same ~96 KiB envelope exercised by
        // the stable path, but spend that budget adaptively: a large C tile is
        // allowed when this shard needs only a small running/scratch vector.
        const int32_t cElems = p.tileM * p.vecN;
        const int32_t runningElems = ((p.M + 7) / 8) * 8;
        int32_t scratchElems = runningElems;
        const int32_t rowGroupElems = p.vecN > 64 ? p.tileM * 8 : 8;
        if (scratchElems < rowGroupElems) scratchElems = rowGroupElems;
        pipe->InitBuffer(cQueue, 1,
            static_cast<uint32_t>(cElems)*sizeof(float));
        // Keep a full-M row-max vector in the fast epilogue. This lets the
        // final Sum(M) execute once, avoiding accuracy drift from chunk sums.
        pipe->InitBuffer(runningBuf,
            static_cast<uint32_t>(runningElems)*sizeof(float));
        pipe->InitBuffer(scratchBuf,
            static_cast<uint32_t>(scratchElems)*sizeof(float));
        pipe->InitBuffer(tileRowBuf,
            static_cast<uint32_t>(p.tileM)*sizeof(float));
        pipe->InitBuffer(resultQueue, 1, 32);
    }

    __aicore__ inline void Process()
    {
        const int32_t worker = static_cast<int32_t>(AscendC::GetBlockIdx());
        const int32_t perBatch = p.pM*p.pN;

        for (int32_t task = worker; task < p.tasks; task += p.workers) {
            const int32_t batch = task/perBatch;
            const int32_t slot = task - batch*perBatch;
            const int32_t ms = slot/p.pN;
            const int32_t ns = (slot % p.pN + ms) % p.pN;

            const int32_t mTileBegin = (ms*p.mTiles)/p.pM;
            const int32_t mTileEnd = ((ms+1)*p.mTiles)/p.pM;
            const int32_t mTilesLocal = mTileEnd-mTileBegin;
            const int32_t m0 = mTileBegin*p.tileM;
            const int32_t m1 = MinI(mTileEnd*p.tileM, p.M);
            const int32_t rows = m1-m0;

            // Fast-plan invariant: p.nTiles is exactly divisible by p.pN.
            const int32_t nTilesLocal = p.nTiles/p.pN;
            const int32_t n0 = ns*p.nPitch;
            const int32_t cols = p.nPitch;

            ComputeShard(batch, m0, n0, rows, cols,
                         mTilesLocal, nTilesLocal);

            auto running = runningBuf.Get<float>();
            if (p.direct) {
                auto out = resultQueue.AllocTensor<float>();
                AscendC::ReduceSum(out, running, scratchBuf.Get<float>(), rows);
                resultQueue.EnQue(out);
                out = resultQueue.DeQue<float>();
                AscendC::DataCopyExtParams cp{1, sizeof(float), 0, 0, 0};
                AscendC::DataCopyPad(gy[batch], out, cp);
                resultQueue.FreeTensor(out);
                AscendC::PipeBarrier<PIPE_V>();
            } else {
                const int64_t dst =
                    (int64_t(batch)*p.pN+ns)*p.paddedM+m0;
                // running was produced by PIPE_V.  Order that write before
                // PIPE_MTE3 consumes the same UB buffer for the GM partial.
                Fence<AscendC::HardEvent::V_MTE3>(*pipe_);
                // M may have a true tail. Copy exactly the semantic rows; the
                // padded suffix is never read by the final Max/Sum epilogue.
                AscendC::DataCopyExtParams cp{
                    1, static_cast<uint32_t>(rows*sizeof(float)), 0, 0, 0};
                AscendC::DataCopyPad(gp[dst], running, cp);
                // V7.1: next task must not overwrite this non-queue TBuf
                // while MTE3 is still reading its partial maxima.
                Fence<AscendC::HardEvent::MTE3_V>(*pipe_);
            }
        }

        if (p.direct) return;

        // Publish all partial row maxima, then merge N-shards deterministically.
        Fence<AscendC::HardEvent::MTE3_MTE2>(*pipe_);
        AscendC::SyncAll<true>();
        for (int32_t batch = worker; batch < p.B; batch += p.workers) {
            FinishMerged(batch);
        }
    }

private:
    __aicore__ inline void RowMaxTile(
        const AscendC::LocalTensor<float>& dst,
        const AscendC::LocalTensor<float>& c,
        int32_t rows)
    {
        if (p.vecN <= 64) {
            AscendC::WholeReduceMax(
                dst, c, p.vecN, rows,
                1, 1, p.vecN/8,
                AscendC::ReduceOrder::ORDER_ONLY_VALUE);
            AscendC::PipeBarrier<PIPE_V>();
            return;
        }

        // First reduce each 64-float group.  For vecN=128/256, store the
        // 2/4 group maxima of every row into an 8-float pitch with -INF holes,
        // then reduce that short pitch once more.
        auto groups = scratchBuf.Get<float>();
        constexpr int32_t gPitch = 8;
        const int32_t groupsPerRow = p.vecN/64;  // 2 or 4
        const int32_t dstStride = gPitch/groupsPerRow;
        AscendC::Duplicate(groups, NEG_INF, rows*gPitch);
        AscendC::PipeBarrier<PIPE_V>();

        const int32_t repeats = rows*groupsPerRow;
        for (int32_t i = 0; i < repeats; i += 128) {
            const int32_t nr = MinI(128, repeats-i);
            AscendC::WholeReduceMax(
                groups[i*dstStride], c[i*64], 64, nr,
                dstStride, 1, 8,
                AscendC::ReduceOrder::ORDER_ONLY_VALUE);
        }
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::WholeReduceMax(
            dst, groups, gPitch, rows,
            1, 1, 1,
            AscendC::ReduceOrder::ORDER_ONLY_VALUE);
        AscendC::PipeBarrier<PIPE_V>();
    }

    __aicore__ inline void ComputeShard(
        int32_t batch, int32_t m0, int32_t n0,
        int32_t rows, int32_t cols,
        int32_t mTilesLocal, int32_t nTilesLocal)
    {
        const int64_t ao = int64_t(batch)*p.M*p.K +
            (TA ? int64_t(m0) : int64_t(m0)*p.K);
        const int64_t bo = int64_t(batch)*p.K*p.N +
            (TB ? int64_t(n0)*p.K : int64_t(n0));

        auto running = runningBuf.Get<float>();
        AscendC::Duplicate(running, NEG_INF, rows);
        AscendC::PipeBarrier<PIPE_V>();

        mm.SetOrgShape(p.M, p.N, p.K, p.K);
        mm.SetTensorA(ga[ao], TA);
        mm.SetTensorB(gb[bo], TB);
        mm.SetSingleShape(rows, cols, p.K);

        int32_t tileId = 0;
        while (mm.template Iterate<true>()) {
            auto c = cQueue.AllocTensor<float>();
            // N is tail-free. A final M tile may be short; sequential VECIN
            // still stores its valid rows contiguously with row pitch vecN.
            mm.template GetTensorC<true>(c, 0, true);
            cQueue.EnQue(c);
            c = cQueue.DeQue<float>();

            // CANN 9.0/dav-2201 observation for FIRSTN:
            // (m0,n0),(m1,n0),...,(m0,n1),...  => M tile varies fastest.
            const int32_t mLocalTile = tileId % mTilesLocal;
            const int32_t liveRows =
                MinI(p.tileM, rows-mLocalTile*p.tileM);
            auto tileRow = tileRowBuf.Get<float>();
            RowMaxTile(tileRow, c, liveRows);
            AscendC::Max(
                running[mLocalTile*p.tileM],
                running[mLocalTile*p.tileM],
                tileRow, liveRows);
            AscendC::PipeBarrier<PIPE_V>();

            cQueue.FreeTensor(c);
            ++tileId;
        }
        mm.End();

        // nTilesLocal is passed explicitly to make the intended tile count
        // visible to the compiler/static audit; all legal fast plans are full.
        (void)nTilesLocal;
    }

    __aicore__ inline void FinishMerged(int32_t batch)
    {
        // Preserve the stable reduction structure: materialize only the final
        // row-max vector [M] in UB, merge N-shards in bounded DMA chunks, then
        // execute ONE FP32 ReduceSum over all M rows. No full C reaches GM.
        auto merged = runningBuf.Get<float>();
        auto tmp = cQueue.AllocTensor<float>();
        const int32_t cCapacity = p.tileM * p.vecN;
        const int64_t first = int64_t(batch)*p.pN*p.paddedM;

        AscendC::DataCopyExtParams firstCp{
            1, static_cast<uint32_t>(p.M*sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<float> noPad{false, 0, 0, 0.0f};
        AscendC::DataCopyPad(merged, gp[first], firstCp, noPad);
        Fence<AscendC::HardEvent::MTE2_V>(*pipe_);

        for (int32_t ns = 1; ns < p.pN; ++ns) {
            const int64_t src = first + int64_t(ns)*p.paddedM;
            for (int32_t m0 = 0; m0 < p.M; m0 += cCapacity) {
                const int32_t live = MinI(cCapacity, p.M-m0);
                AscendC::DataCopyExtParams cp{
                    1, static_cast<uint32_t>(live*sizeof(float)), 0, 0, 0};
                AscendC::DataCopyPad(tmp, gp[src+m0], cp, noPad);
                Fence<AscendC::HardEvent::MTE2_V>(*pipe_);
                AscendC::Max(merged[m0], merged[m0], tmp, live);
                AscendC::PipeBarrier<PIPE_V>();
                Fence<AscendC::HardEvent::V_MTE2>(*pipe_);
            }
        }

        auto out = resultQueue.AllocTensor<float>();
        AscendC::ReduceSum(out, merged, scratchBuf.Get<float>(), p.M);
        resultQueue.EnQue(out);
        out = resultQueue.DeQue<float>();
        AscendC::DataCopyExtParams cp{1, sizeof(float), 0, 0, 0};
        AscendC::DataCopyPad(gy[batch], out, cp);
        resultQueue.FreeTensor(out);
        Fence<AscendC::HardEvent::V_MTE2>(*pipe_);
        cQueue.FreeTensor(tmp);
    }

    Plan p;
    AscendC::TPipe* pipe_;
    AscendC::GlobalTensor<T> ga, gb;
    AscendC::GlobalTensor<float> gy, gp;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> cQueue;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> resultQueue;
    AscendC::TBuf<AscendC::TPosition::VECCALC> runningBuf, scratchBuf, tileRowBuf;
};

template <typename T, bool TA, bool TB>
__aicore__ inline void FastFusedEntry(
    GM_ADDR a, GM_ADDR b, GM_ADDR y, GM_ADDR partials,
    TCubeTiling td, Plan p)
{
    AscendC::TPipe pipe;
    FastFusedDevice<T,TA,TB> op;
    op.tiling = td;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), op.mm, &op.tiling);
    if ASCEND_IS_AIV {
        op.Init(a,b,y,partials,p,&pipe);
        op.Process();
    }
}

// BMMS_HOST_PLAN_BEGIN
static inline int32_t CeilDiv(int32_t x, int32_t y) { return (x+y-1)/y; }
static inline int32_t MinH(int32_t x, int32_t y) { return x<y ? x:y; }

static inline uint64_t PartialBytes(const Plan& p)
{
    return p.direct ? 0ULL : uint64_t(p.B)*p.pN*p.paddedM*sizeof(float);
}
static inline uint64_t TileBytes(const Plan& p)
{
    return uint64_t(p.workers)*p.tileM*p.nPitch*sizeof(float);
}

static inline int32_t FastScratchElems(const Plan& p)
{
    int32_t scratch = CeilDiv(p.M,8)*8;
    const int32_t rowGroups = p.vecN>64 ? p.tileM*8 : 8;
    if (scratch<rowGroups) scratch=rowGroups;
    return scratch;
}

static inline uint64_t FastAppUbBytes(const Plan& p)
{
    const int32_t mAligned = CeilDiv(p.M,8)*8;
    return uint64_t(p.tileM*p.vecN + mAligned + FastScratchElems(p) +
                    p.tileM)*sizeof(float) + 32ULL;
}
static inline Plan BuildPlan(int32_t B, int32_t M, int32_t N, int32_t K,
    int32_t cores, int32_t tileM, int32_t vecN, int32_t pm, int32_t pn)
{
    Plan p{};
    p.B=B; p.M=M; p.N=N; p.K=K;
    p.tileM=tileM; p.vecN=vecN;
    p.mTiles=CeilDiv(M,tileM); p.nTiles=CeilDiv(N,vecN);
    p.pM=pm; p.pN=pn;
    p.mPitch=CeilDiv(p.mTiles,pm)*tileM;
    p.nPitch=CeilDiv(p.nTiles,pn)*vecN;
    p.paddedM=p.mTiles*tileM;
    p.tasks=B*pm*pn;
    p.blocks=MinH(cores,p.tasks);
    p.workers=p.blocks; // MIX(1,1), NOT twice the block count.
    p.direct=(pm==1 && pn==1);
    return p;
}

static inline bool ValidPlan(const Plan& p, int32_t cores)
{
    return p.tileM>=16 && p.tileM<=128 && (p.tileM&(p.tileM-1))==0 &&
        p.vecN>=16 && p.vecN<=256 && (p.vecN&(p.vecN-1))==0 &&
        p.tileM*p.vecN<=UB_FLOATS && p.paddedM<=MAX_M &&
        p.pM>=1 && p.pM<=p.mTiles && p.pN>=1 && p.pN<=p.nTiles &&
        p.pM*p.pN<=cores && p.tasks==p.B*p.pM*p.pN &&
        p.blocks>=1 && p.blocks<=cores && p.workers==p.blocks &&
        p.nPitch>=16 && p.nPitch%16==0 &&
        PartialBytes(p)+TileBytes(p)<=MAX_USER_WORKSPACE_BYTES;
}

static inline double SafePlanCost(const Plan& p)
{
    // An unfitted, shape-only model. These constants are not device timings.
    // Score the critical worker, not the sum of all workers' operation counts.
    const int32_t waves=CeilDiv(p.tasks,p.workers);
    const int32_t mSteps=CeilDiv(p.mTiles,p.pM);
    const int32_t rm=MinH(p.M,p.tileM);
    const int32_t rn=MinH(p.N,p.nPitch);
    const int32_t cm=CeilDiv(rm,16)*16, cn=CeilDiv(rn,16)*16;
    const int32_t nSteps=CeilDiv(rn,p.vecN);
    const double cube=2.0*cm*cn*p.K/4000000.0;
    const double cTraffic=8.0*rm*rn/20000.0;
    const double input=2.0*(rm+rn)*p.K/60000.0;
    const double setup=0.65 + nSteps*0.06;
    double score=waves*mSteps*(cube+cTraffic+input+setup);
    if (!p.direct) {
        score += 1.10 + double(p.pN)*p.paddedM/20000.0;
    }
    // Account for rereading the same operand across orthogonal shards.  This
    // modest global-bandwidth term favours a 2-D grid when both axes are large.
    const double repeated=2.0*p.B*p.K*(double(p.M)*p.pN+double(p.N)*p.pM);
    score += repeated/1000000.0;
    return score;
}

static inline Plan MakeSafePlan(int32_t B, int32_t M, int32_t N, int32_t K,
    int32_t cores, bool fallback)
{
    if (fallback) {
        // Still multi-core: M partitions first; split N if M is too skinny.
        const int32_t tm=16, vn=N<=16 ? 16 : (N<=32 ? 32 : 64);
        const int32_t pm=MinH(CeilDiv(M,tm),cores);
        const int32_t pn=MinH(CeilDiv(N,vn),cores/pm);
        return BuildPlan(B,M,N,K,cores,tm,vn,pm,pn);
    }
    const int32_t ms[4]={16,32,64,128};
    const int32_t ns[5]={16,32,64,128,256};
    Plan best{};
    double bestCost=1.0e100;
    for (int32_t im=0;im<4;++im) {
        if (ms[im]>16 && M<=ms[im]/2) continue;
        for (int32_t in=0;in<5;++in) {
            if (ms[im]*ns[in]>UB_FLOATS) continue;
            if (ns[in]>16 && N<=ns[in]/2) continue;
            const int32_t maxPm=MinH(cores,CeilDiv(M,ms[im]));
            for (int32_t pm=1;pm<=maxPm;++pm) {
                const int32_t maxPn=MinH(cores/pm,CeilDiv(N,ns[in]));
                for (int32_t pn=1;pn<=maxPn;++pn) {
                    Plan p=BuildPlan(B,M,N,K,cores,ms[im],ns[in],pm,pn);
                    if (!ValidPlan(p,cores)) continue;
                    const double c=SafePlanCost(p);
                    if (c<bestCost) { bestCost=c; best=p; }
                }
            }
        }
    }
    if (!best.blocks) return MakeSafePlan(B,M,N,K,cores,true);
    return best;
}

static inline bool ValidFastPlan(const Plan& p, int32_t cores)
{
    if (p.tileM < 16 || p.tileM > 128 || (p.tileM&(p.tileM-1)) != 0) return false;
    if (p.vecN < 16 || p.vecN > 256 || (p.vecN&(p.vecN-1)) != 0) return false;
    if (p.tileM*p.vecN > FAST_C_FLOATS) return false;
    if (FastAppUbBytes(p) > FAST_APP_UB_BYTES) return false;
    if (p.N % p.vecN != 0) return false;
    if (p.nTiles % p.pN != 0) return false;
    if (p.paddedM > MAX_M || p.mPitch > MAX_M) return false;
    const int32_t maxRealShardM = MinH(p.mPitch, p.M);
    if (p.tileM > CeilDiv(maxRealShardM,16)*16) return false;
    if (p.pM < 1 || p.pM > p.mTiles || p.pN < 1 || p.pN > p.nTiles) return false;
    if (p.pM*p.pN > cores || p.tasks != p.B*p.pM*p.pN) return false;
    if (p.blocks < 1 || p.blocks > cores || p.workers != p.blocks) return false;
    if (p.nPitch != (p.nTiles/p.pN)*p.vecN) return false;
    return PartialBytes(p) <= MAX_USER_WORKSPACE_BYTES;
}

static inline double FastPlanCost(const Plan& p, int32_t cores)
{
    // VECIN path has no B*M*N GM C write/read term.  The cost model therefore
    // balances Cube work, duplicated A/B traffic, Iterate count and one Matmul
    // setup per persistent (batch,mShard,nShard) task.
    const int32_t used = p.workers;
    const int32_t waves = CeilDiv(p.tasks, used);
    const double flops = 2.0*double(p.B)*p.M*p.N*p.K;
    const double cube = flops/(double(used)*4000000.0);
    const double inputBytes =
        2.0*double(p.B)*p.K*(double(p.M)*p.pN + double(p.N)*p.pM);
    const double input = inputBytes/(double(used)*120000.0);
    const double cElems = double(p.B)*p.M*p.N;
    const double vec = cElems/(double(used)*700000.0);
    const double iterCount = double(p.B)*p.mTiles*p.nTiles;
    const double iterate = iterCount/double(used)*0.025;
    const double setup = double(waves)*0.45;
    double score = cube + input + vec + iterate + setup;

    if (!p.direct) {
        score += 0.65 + 0.015*used;
        score += double(PartialBytes(p))/(double(used)*150000.0);
    }

    // Large jobs should normally keep all AIC groups busy.  Small jobs may
    // legitimately prefer fewer workers to avoid an expensive global handoff.
    if (flops > 5.0e6 && used < cores) {
        score *= 1.0 + 0.70*double(cores-used)/double(cores);
    }
    return score;
}

static inline Plan MakeFastPlan(
    int32_t B, int32_t M, int32_t N, int32_t K, int32_t cores)
{
    Plan best{};
    if ((N & 15) != 0) return best;

    const int32_t ms[4] = {16, 32, 64, 128};
    const int32_t ns[5] = {16, 32, 64, 128, 256};
    double bestCost = 1.0e100;

    for (int32_t im = 0; im < 4; ++im) {
        const int32_t tm = ms[im];
        for (int32_t in = 0; in < 5; ++in) {
            const int32_t vn = ns[in];
            if (N % vn != 0 || tm*vn > FAST_C_FLOATS) continue;

            const int32_t mt = CeilDiv(M,tm);
            const int32_t nt = N/vn;
            const int32_t maxPm = MinH(mt, cores);

            for (int32_t pm = 1; pm <= maxPm; ++pm) {
                const int32_t maxPn = MinH(nt, cores/pm);
                for (int32_t pn = 1; pn <= maxPn; ++pn) {
                    // Uniform full-N shards keep GetTensorC completely tail-free.
                    if (nt % pn != 0) continue;
                    Plan cand = BuildPlan(B,M,N,K,cores,tm,vn,pm,pn);
                    if (!ValidFastPlan(cand, cores)) continue;
                    const double c = FastPlanCost(cand, cores);
                    if (c < bestCost) {
                        bestCost = c;
                        best = cand;
                    }
                }
            }
        }
    }
    return best;
}

static inline bool UseTiny(int32_t M, int32_t N, int32_t K)
{
    return int64_t(M)*N<=16 && K<=1024 && int64_t(M)*N*K<=8192;
}
// BMMS_HOST_PLAN_END

static inline bool GetSafeTiling(const Plan& p, int32_t dtype, bool ta, bool tb,
    TCubeTiling& td)
{
    matmul_tiling::MultiCoreMatmulTiling t;
    // SetDim is the available AIV budget, NOT a substitute for our scheduler.
    // Pin one call's complete SingleShape so the tiler cannot split this tile
    // again. A returned usedCoreNum of one describes that single call, not the
    // number of independent tiles/batches scheduled by this kernel.
    if (t.SetDim(p.workers)==-1) return false;
    const auto dt=dtype==2 ? matmul_tiling::DataType::DT_BFLOAT16
                          : matmul_tiling::DataType::DT_FLOAT16;
    t.SetAType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,dt,ta);
    t.SetBType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,dt,tb);
    t.SetCType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,
        matmul_tiling::DataType::DT_FLOAT);
    const int32_t sm=MinH(p.M,p.tileM), sn=MinH(p.N,p.nPitch);
    t.SetOrgShape(p.M,p.N,p.K);
    t.SetShape(sm,sn,p.K);
    if (t.SetSingleShape(sm,sn,p.K)==-1) return false;
    t.EnableBias(false);
    t.SetBufferSpace(-1,-1,64*1024);
    if (t.GetTiling(td)==-1) return false;
    // No hidden tiler K split and no unexpectedly smaller per-call coverage.
    // Padded-up M/N are fine: the runtime always resets the exact real shape.
    return td.baseM>0 && td.baseN>0 && td.baseK>0 &&
        td.singleCoreM>=sm && td.singleCoreN>=sn && td.singleCoreK>=p.K;
}


// V7.1: V4.3's fast consumer assumes N-outer / M-inner over the whole shard.
// Accept only returned Norm tilings where that is actually true. Otherwise use
// the existing explicit-GM-stride fallback, which does not decode Iterate order.
// These tests depend on tiling metadata, NEVER on test IDs or input values.
static inline bool FlatFastStream(const Plan& p, const TCubeTiling& td)
{
    if (td.stepM <= 0 || td.stepN <= 0 ||
        (td.iterateOrder != 0 && td.iterateOrder != 1)) return false;
    const int32_t maxMTiles = CeilDiv(p.mTiles, p.pM);
    const int32_t nTiles = p.nTiles / p.pN;
    return maxMTiles <= 1 || nTiles <= 1 ||
           (td.iterateOrder == 1 && td.stepM >= maxMTiles);
}

static inline bool GetFastTiling(
    const Plan& p, int32_t dtype, bool ta, bool tb, TCubeTiling& td)
{
    if (p.blocks <= 0 || p.workers <= 0) return false;

    matmul_tiling::MultiCoreMatmulTiling t;
    if (t.SetDim(p.workers) == -1) return false;

    const auto dt = dtype == 2 ? matmul_tiling::DataType::DT_BFLOAT16
                               : matmul_tiling::DataType::DT_FLOAT16;
    t.SetAType(matmul_tiling::TPosition::GM,
               matmul_tiling::CubeFormat::ND, dt, ta);
    t.SetBType(matmul_tiling::TPosition::GM,
               matmul_tiling::CubeFormat::ND, dt, tb);
    t.SetCType(matmul_tiling::TPosition::VECIN,
               matmul_tiling::CubeFormat::ND,
               matmul_tiling::DataType::DT_FLOAT);

    // Host tiling describes the largest shard one worker can see. Runtime
    // SetSingleShape only shrinks M on the final uneven M-shard.
    const int32_t sm = MinH(p.mPitch, p.M);
    const int32_t sn = p.nPitch;
    t.SetOrgShape(p.M, p.N, p.K);
    t.SetShape(sm, sn, p.K);
    if (t.SetSingleShape(sm, sn, p.K) == -1) return false;
    if (t.SetFixSplit(p.tileM, p.vecN, -1) == -1) return false;
    if (t.SetTraverse(matmul_tiling::MatrixTraverse::FIRSTN) == -1) return false;
    t.EnableBias(false);
    t.SetBufferSpace(-1, -1, 64*1024);

    if (t.GetTiling(td) == -1) return false;

    // Every physical block manually owns a shard; an individual Matmul object
    // must therefore remain single-core internally.
    return FlatFastStream(p, td) && td.usedCoreNum == 1 &&
           td.baseM == p.tileM && td.baseN == p.vecN &&
           td.baseK > 0 &&
           td.singleCoreM >= sm && td.singleCoreN >= sn &&
           td.singleCoreK >= p.K;
}

} // namespace bmmmaxsum_v43

__global__ __vector__ void bmms43_dot_fp16(GM_ADDR a,GM_ADDR b,GM_ADDR y,
    int32_t B,int32_t K,int32_t workers)
{ bmmmaxsum_v43::DotDevice<half>(a,b,y,B,K,workers); }
__global__ __vector__ void bmms43_dot_bf16(GM_ADDR a,GM_ADDR b,GM_ADDR y,
    int32_t B,int32_t K,int32_t workers)
{ bmmmaxsum_v43::DotDevice<bfloat16_t>(a,b,y,B,K,workers); }

#define BMMS43_TINY_ENTRY(NAME,TYPE,TA,TB)                                 \
__global__ __vector__ void NAME(GM_ADDR a,GM_ADDR b,GM_ADDR y,              \
    int32_t B,int32_t M,int32_t N,int32_t K,int32_t workers)                \
{ bmmmaxsum_v43::TinyDevice<TYPE,TA,TB>(a,b,y,B,M,N,K,workers); }
BMMS43_TINY_ENTRY(bmms43_tiny_f16_nn,half,false,false)
BMMS43_TINY_ENTRY(bmms43_tiny_f16_tn,half,true,false)
BMMS43_TINY_ENTRY(bmms43_tiny_f16_nt,half,false,true)
BMMS43_TINY_ENTRY(bmms43_tiny_f16_tt,half,true,true)
BMMS43_TINY_ENTRY(bmms43_tiny_b16_nn,bfloat16_t,false,false)
BMMS43_TINY_ENTRY(bmms43_tiny_b16_tn,bfloat16_t,true,false)
BMMS43_TINY_ENTRY(bmms43_tiny_b16_nt,bfloat16_t,false,true)
BMMS43_TINY_ENTRY(bmms43_tiny_b16_tt,bfloat16_t,true,true)
#undef BMMS43_TINY_ENTRY


// Inherited V4.3 aligned path: no user-owned C workspace; API may stage through GM.
#define BMMS43_FAST_ENTRY(NAME,TYPE,TA,TB)                                  \
__schedmode__(1) __global__ __mix__(1,1) void NAME(                        \
    GM_ADDR a,GM_ADDR b,GM_ADDR y,GM_ADDR partials,                        \
    __kfc_workspace__ GM_ADDR workspace,TCubeTiling td,                    \
    bmmmaxsum_v43::Plan p)                                                 \
{ bmmmaxsum_v43::FastFusedEntry<TYPE,TA,TB>(a,b,y,partials,td,p); }
BMMS43_FAST_ENTRY(bmms43_fast_f16_nn,half,false,false)
BMMS43_FAST_ENTRY(bmms43_fast_f16_tn,half,true,false)
BMMS43_FAST_ENTRY(bmms43_fast_f16_nt,half,false,true)
BMMS43_FAST_ENTRY(bmms43_fast_f16_tt,half,true,true)
BMMS43_FAST_ENTRY(bmms43_fast_b16_nn,bfloat16_t,false,false)
BMMS43_FAST_ENTRY(bmms43_fast_b16_tn,bfloat16_t,true,false)
BMMS43_FAST_ENTRY(bmms43_fast_b16_nt,bfloat16_t,false,true)
BMMS43_FAST_ENTRY(bmms43_fast_b16_tt,bfloat16_t,true,true)
#undef BMMS43_FAST_ENTRY

// Batch scheduling mode makes an all-AIV barrier safe under multi-stream
// concurrency. MIX(1,1) still launches MULTIPLE AIC+AIV pairs, not one core.
#define BMMS43_SAFE_ENTRY(NAME,TYPE,TA,TB)                                  \
__schedmode__(1) __global__ __mix__(1,1) void NAME(                        \
    GM_ADDR a,GM_ADDR b,GM_ADDR y,GM_ADDR partials,GM_ADDR tiles,           \
    __kfc_workspace__ GM_ADDR workspace,TCubeTiling td,                    \
    bmmmaxsum_v43::Plan p)                                               \
{ bmmmaxsum_v43::SafeFusedEntry<TYPE,TA,TB>(a,b,y,partials,tiles,td,p); }
BMMS43_SAFE_ENTRY(bmms43_safe_f16_nn,half,false,false)
BMMS43_SAFE_ENTRY(bmms43_safe_f16_tn,half,true,false)
BMMS43_SAFE_ENTRY(bmms43_safe_f16_nt,half,false,true)
BMMS43_SAFE_ENTRY(bmms43_safe_f16_tt,half,true,true)
BMMS43_SAFE_ENTRY(bmms43_safe_b16_nn,bfloat16_t,false,false)
BMMS43_SAFE_ENTRY(bmms43_safe_b16_tn,bfloat16_t,true,false)
BMMS43_SAFE_ENTRY(bmms43_safe_b16_nt,bfloat16_t,false,true)
BMMS43_SAFE_ENTRY(bmms43_safe_b16_tt,bfloat16_t,true,true)
#undef BMMS43_SAFE_ENTRY

static inline void bmms71_v43_dispatch(
    GM_ADDR x1,const TensorGroupInfo& info_x1,
    GM_ADDR x2,const TensorGroupInfo& info_x2,
    GM_ADDR y,const TensorGroupInfo& info_y,
    int64_t availableCoreNum,aclrtStream stream,bool transposeX1,bool transposeX2)
{
    using namespace bmmmaxsum_v43;
    if (info_x1.numTensors!=1 || info_x2.numTensors!=1 || info_y.numTensors!=1)
        std::abort();
    const auto& a=info_x1.tensors[0];
    const auto& b=info_x2.tensors[0];
    const auto& out=info_y.tensors[0];
    if (a.numDims!=3 || b.numDims!=3 || out.numDims!=1 ||
        (a.dtype!=1 && a.dtype!=2) || b.dtype!=a.dtype || out.dtype!=0)
        std::abort();
    const int64_t B=a.shape[0];
    const int64_t M=a.shape[transposeX1 ? 2:1];
    const int64_t K=a.shape[transposeX1 ? 1:2];
    const int64_t N=b.shape[transposeX2 ? 1:2];
    if (B<1 || B>64 || M<1 || M>8192 || N<1 || N>8192 ||
        K<32 || K>8192 || K%8 || b.shape[0]!=B ||
        b.shape[transposeX2 ? 2:1]!=K || out.shape[0]!=B ||
        B*M*K>(1LL<<26) || B*N*K>(1LL<<26)) std::abort();
    const int32_t cores=availableCoreNum>0 && availableCoreNum<=64
        ? static_cast<int32_t>(availableCoreNum) : 1;
    if (M==1 && N==1) {
        const int32_t workers=MinH(int32_t(B),cores*2);
        if (a.dtype==1) {
            bmms43_dot_fp16<<<workers,nullptr,stream>>>(x1,x2,y,B,K,workers);
        } else {
            bmms43_dot_bf16<<<workers,nullptr,stream>>>(x1,x2,y,B,K,workers);
        }
        return;
    }
    if (UseTiny(M,N,K)) {
        const int32_t workers=MinH(int32_t(B),cores*2);
#define BMMS43_TINY_LAUNCH(NAME) \
    NAME<<<workers,nullptr,stream>>>(x1,x2,y,B,M,N,K,workers)
        if (a.dtype==1) {
            if (!transposeX1 && !transposeX2) { BMMS43_TINY_LAUNCH(bmms43_tiny_f16_nn); }
            else if (transposeX1 && !transposeX2) { BMMS43_TINY_LAUNCH(bmms43_tiny_f16_tn); }
            else if (!transposeX1 && transposeX2) { BMMS43_TINY_LAUNCH(bmms43_tiny_f16_nt); }
            else { BMMS43_TINY_LAUNCH(bmms43_tiny_f16_tt); }
        } else {
            if (!transposeX1 && !transposeX2) { BMMS43_TINY_LAUNCH(bmms43_tiny_b16_nn); }
            else if (transposeX1 && !transposeX2) { BMMS43_TINY_LAUNCH(bmms43_tiny_b16_tn); }
            else if (!transposeX1 && transposeX2) { BMMS43_TINY_LAUNCH(bmms43_tiny_b16_nt); }
            else { BMMS43_TINY_LAUNCH(bmms43_tiny_b16_tt); }
        }
#undef BMMS43_TINY_LAUNCH
        return;
    }

    // Primary leaderboard path: for 16-aligned M/N, compute C tiles directly
    // into VECIN and reduce rows online.  If host tiling rejects the selected
    // fast configuration, fall through to the proven GM-stripe path below.
    Plan fastPlan = MakeFastPlan(B,M,N,K,cores);
    TCubeTiling fastTd{};
    if (fastPlan.blocks > 0 &&
        ValidFastPlan(fastPlan, cores) &&
        GetFastTiling(fastPlan, a.dtype, transposeX1, transposeX2, fastTd)) {

        const uint64_t partialBytes = PartialBytes(fastPlan);
        uint8_t* workspace = nullptr;
        const aclError alloc = aclrtMalloc(
            reinterpret_cast<void**>(&workspace),
            SYSTEM_WORKSPACE_BYTES + partialBytes,
            ACL_MEM_MALLOC_HUGE_FIRST);
        if (alloc != ACL_SUCCESS) std::abort();
        uint8_t* partials = workspace + SYSTEM_WORKSPACE_BYTES;

#define BMMS43_FAST_LAUNCH(NAME) \
        NAME<<<fastPlan.blocks,nullptr,stream>>>( \
            x1,x2,y,partials,workspace,fastTd,fastPlan)
        if (a.dtype==1) {
            if (!transposeX1 && !transposeX2) { BMMS43_FAST_LAUNCH(bmms43_fast_f16_nn); }
            else if (transposeX1 && !transposeX2) { BMMS43_FAST_LAUNCH(bmms43_fast_f16_tn); }
            else if (!transposeX1 && transposeX2) { BMMS43_FAST_LAUNCH(bmms43_fast_f16_nt); }
            else { BMMS43_FAST_LAUNCH(bmms43_fast_f16_tt); }
        } else {
            if (!transposeX1 && !transposeX2) { BMMS43_FAST_LAUNCH(bmms43_fast_b16_nn); }
            else if (transposeX1 && !transposeX2) { BMMS43_FAST_LAUNCH(bmms43_fast_b16_tn); }
            else if (!transposeX1 && transposeX2) { BMMS43_FAST_LAUNCH(bmms43_fast_b16_nt); }
            else { BMMS43_FAST_LAUNCH(bmms43_fast_b16_tt); }
        }
#undef BMMS43_FAST_LAUNCH

        if (aclrtSynchronizeStream(stream)!=ACL_SUCCESS) std::abort();
        if (aclrtFree(workspace)!=ACL_SUCCESS) std::abort();
        return;
    }

    Plan p=MakeSafePlan(B,M,N,K,cores,false);
    TCubeTiling td{};
    if (!GetSafeTiling(p,a.dtype,transposeX1,transposeX2,td)) {
        p=MakeSafePlan(B,M,N,K,cores,true);
        td=TCubeTiling{};
        if (!GetSafeTiling(p,a.dtype,transposeX1,transposeX2,td)) std::abort();
    }
    if (!ValidPlan(p,cores)) std::abort();
    const uint64_t partialBytes=PartialBytes(p);
    uint8_t* workspace=nullptr;
    const aclError alloc=aclrtMalloc(reinterpret_cast<void**>(&workspace),
        SYSTEM_WORKSPACE_BYTES+partialBytes+TileBytes(p),ACL_MEM_MALLOC_HUGE_FIRST);
    if (alloc!=ACL_SUCCESS) std::abort();
    uint8_t* partials=workspace+SYSTEM_WORKSPACE_BYTES;
    uint8_t* tiles=partials+partialBytes;
#define BMMS43_SAFE_LAUNCH(NAME) \
    NAME<<<p.blocks,nullptr,stream>>>(x1,x2,y,partials,tiles,workspace,td,p)
    if (a.dtype==1) {
        if (!transposeX1 && !transposeX2) { BMMS43_SAFE_LAUNCH(bmms43_safe_f16_nn); }
        else if (transposeX1 && !transposeX2) { BMMS43_SAFE_LAUNCH(bmms43_safe_f16_tn); }
        else if (!transposeX1 && transposeX2) { BMMS43_SAFE_LAUNCH(bmms43_safe_f16_nt); }
        else { BMMS43_SAFE_LAUNCH(bmms43_safe_f16_tt); }
    } else {
        if (!transposeX1 && !transposeX2) { BMMS43_SAFE_LAUNCH(bmms43_safe_b16_nn); }
        else if (transposeX1 && !transposeX2) { BMMS43_SAFE_LAUNCH(bmms43_safe_b16_tn); }
        else if (!transposeX1 && transposeX2) { BMMS43_SAFE_LAUNCH(bmms43_safe_b16_nt); }
        else { BMMS43_SAFE_LAUNCH(bmms43_safe_b16_tt); }
    }
#undef BMMS43_SAFE_LAUNCH
    // Fail loudly instead of silently returning an unwritten y on host/runtime
    // failure. Never release workspace while device use may still be pending.
    if (aclrtSynchronizeStream(stream)!=ACL_SUCCESS) std::abort();
    if (aclrtFree(workspace)!=ACL_SUCCESS) std::abort();
}


// BMMS71_VECTOR_MODULE_BEGIN
namespace bmms71 {
constexpr float NEG_INF = -__builtin_inff();
__aicore__ inline int32_t MinI(int32_t a,int32_t b){return a<b?a:b;}
template<AscendC::HardEvent E>
__aicore__ inline void Fence(AscendC::TPipe& pipe){
    const auto id=static_cast<event_t>(pipe.FetchEventID(E));
    AscendC::SetFlag<E>(id); AscendC::WaitFlag<E>(id);
}
// Small resident GEMM: complete inputs in UB, no Cube, system workspace or
// cross-core synchronization. This is a separate shape family, not a fallback
// for arbitrary GEMM. K is padded to a power of two <=128 for vector row sums.
template<class T,bool TA,bool TB>
__aicore__ inline void ResidentDevice(GM_ADDR a,GM_ADDR b,GM_ADDR y,
    int32_t B,int32_t M,int32_t N,int32_t K,int32_t kp,int32_t workers) {
    AscendC::TPipe pipe;
    const int32_t ar=(M*K+15)/16*16,br=(N*K+15)/16*16;
    const int32_t af=(M*K+7)/8*8,bf=(N*K+7)/8*8;
    const int32_t nr=(N+7)/8*8;
    AscendC::TQue<AscendC::TPosition::VECIN,1> iq;
    AscendC::TQue<AscendC::TPosition::VECOUT,1> oq;
    AscendC::TBuf<AscendC::TPosition::VECCALC> floats,indices,packed,prodBuf,values;
    pipe.InitBuffer(iq,1,(ar+br)*sizeof(T)); pipe.InitBuffer(oq,1,32);
    pipe.InitBuffer(floats,(af+bf)*sizeof(float));
    pipe.InitBuffer(indices,2*kp*sizeof(int32_t));
    pipe.InitBuffer(packed,(N+1)*kp*sizeof(float));
    pipe.InitBuffer(prodBuf,(N*kp>M*8?N*kp:M*8)*sizeof(float));
    pipe.InitBuffer(values,(nr+8*M)*sizeof(float));
    auto fa=floats.Get<float>();auto fb=fa[af];
    auto bp=packed.Get<float>();auto av=bp[N*kp];auto prod=prodBuf.Get<float>();
    auto dots=values.Get<float>();auto rows=dots[nr];
    auto ia=indices.Get<int32_t>();auto ib=ia[kp];
    AscendC::CreateVecIndex(ia,int32_t(0),K);
    AscendC::CreateVecIndex(ib,int32_t(0),K);AscendC::PipeBarrier<PIPE_V>();
    AscendC::Muls(ia,ia,int32_t((TA?M:1)*sizeof(float)),K);
    AscendC::Muls(ib,ib,int32_t((TB?1:N)*sizeof(float)),K);
    AscendC::PipeBarrier<PIPE_V>();
    auto iau=ia.template ReinterpretCast<uint32_t>();auto ibu=ib.template ReinterpretCast<uint32_t>();
    AscendC::GlobalTensor<T> ga,gb;AscendC::GlobalTensor<float> gy;
    ga.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(a),int64_t(B)*M*K);
    gb.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(b),int64_t(B)*N*K);
    gy.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y),B);
    for(int32_t batch=AscendC::GetBlockIdx();batch<B;batch+=workers){
        auto in=iq.AllocTensor<T>();
        AscendC::DataCopyPadExtParams<T> pad{false,0,0,T(0)};
        AscendC::DataCopyExtParams acp{1,uint32_t(M*K*sizeof(T)),0,0,0};
        AscendC::DataCopyExtParams bcp{1,uint32_t(N*K*sizeof(T)),0,0,0};
        AscendC::DataCopyPad(in,ga[int64_t(batch)*M*K],acp,pad);
        AscendC::DataCopyPad(in[ar],gb[int64_t(batch)*N*K],bcp,pad);
        iq.EnQue(in);in=iq.DeQue<T>();
        AscendC::Cast(fa,in,AscendC::RoundMode::CAST_NONE,M*K);
        AscendC::Cast(fb,in[ar],AscendC::RoundMode::CAST_NONE,N*K);
        AscendC::Duplicate(bp,0.0f,(N+1)*kp);
        AscendC::Duplicate(rows,0.0f,M*8);AscendC::PipeBarrier<PIPE_V>();
        for(int32_t n=0;n<N;++n)
            AscendC::Gather(bp[n*kp],fb,ibu,uint32_t((TB?n*K:n)*sizeof(float)),K);
        AscendC::PipeBarrier<PIPE_V>();
        const uint8_t stride=static_cast<uint8_t>(kp/8);
        const AscendC::BinaryRepeatParams mulp{1,1,1,stride,0,stride};
        for(int32_t m=0;m<M;++m){
            AscendC::Gather(av,fa,iau,uint32_t((TA?m:m*K)*sizeof(float)),K);
            AscendC::PipeBarrier<PIPE_V>();
            for(int32_t k=0;k<kp;k+=64)
                AscendC::Mul(prod[k],av[k],bp[k],MinI(kp,64),N,mulp);
            AscendC::PipeBarrier<PIPE_V>();
            if(kp==128){
                const AscendC::BinaryRepeatParams addp{1,1,1,16,16,16};
                AscendC::Add(prod,prod,prod[64],64,N,addp);
                AscendC::PipeBarrier<PIPE_V>();
            }
            AscendC::WholeReduceSum(dots,prod,MinI(kp,64),N,1,1,kp/8);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::WholeReduceMax(rows[m*8],dots,N,1,1,1,8,
                AscendC::ReduceOrder::ORDER_ONLY_VALUE);
            AscendC::PipeBarrier<PIPE_V>();
        }
        auto out=oq.AllocTensor<float>();
        AscendC::ReduceSum(out,rows,prod,M*8);
        oq.EnQue(out);out=oq.DeQue<float>();
        AscendC::DataCopyExtParams cp{1,sizeof(float),0,0,0};
        AscendC::DataCopyPad(gy[batch],out,cp);
        oq.FreeTensor(out);iq.FreeTensor(in);
    }
}

struct SkinnyPlan {int32_t B,L,K,kp,chunk,chunks,padded,workers,direct;};
// Finite-length max used only in the M=1 epilogue. No padding participates.
__aicore__ inline void FinishMax(const AscendC::LocalTensor<float>& out,
    const AscendC::LocalTensor<float>& src,const AscendC::LocalTensor<float>& tmp,int32_t n){
    AscendC::Duplicate(tmp,NEG_INF,136);AscendC::PipeBarrier<PIPE_V>();
    const int32_t full=n/64,tail=n%64;
    if(full) AscendC::WholeReduceMax(tmp,src,64,full,1,1,8,AscendC::ReduceOrder::ORDER_ONLY_VALUE);
    if(tail) AscendC::WholeReduceMax(tmp[128],src[full*64],tail,1,1,1,8,AscendC::ReduceOrder::ORDER_ONLY_VALUE);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::Max(tmp,tmp,tmp[64],64);AscendC::PipeBarrier<PIPE_V>();
    AscendC::WholeReduceMax(out,tmp,64,1,1,1,8,AscendC::ReduceOrder::ORDER_ONLY_VALUE);
    AscendC::PipeBarrier<PIPE_V>();AscendC::Max(out,out,tmp[128],1);
}
// Full-K contiguous dot bank. Unlike V5, supports every legal K up to 8192.
// Only selected when the BANK is stored [L,K]. Other layouts use the Cube path.
template<class T,bool SUM_ROWS>
__aicore__ inline void SkinnyDevice(GM_ADDR a,GM_ADDR b,GM_ADDR y,
    GM_ADDR partial,const SkinnyPlan& p){
    AscendC::TPipe pipe;
    const int32_t bankCap=p.chunk*p.kp>p.padded?p.chunk*p.kp:p.padded;
    int32_t scratchCap=p.kp>p.padded?p.kp:p.padded;
    if(scratchCap<136)scratchCap=136;
    AscendC::TQue<AscendC::TPosition::VECIN,1> iq;
    AscendC::TQue<AscendC::TPosition::VECOUT,1> dq,oq;
    AscendC::TBuf<AscendC::TPosition::VECCALC> vb,fb,sb,slots,indices;
    pipe.InitBuffer(iq,1,(p.kp+p.chunk*p.kp)*sizeof(T));
    pipe.InitBuffer(dq,1,((p.chunk+7)/8*8)*sizeof(float));pipe.InitBuffer(oq,1,32);
    pipe.InitBuffer(vb,p.kp*sizeof(float));pipe.InitBuffer(fb,bankCap*sizeof(float));
    pipe.InitBuffer(sb,scratchCap*sizeof(float));pipe.InitBuffer(slots,p.chunk*8*sizeof(float));
    pipe.InitBuffer(indices,((p.chunk+7)/8*8)*sizeof(int32_t));
    auto vec=vb.Get<float>();auto bank=fb.Get<float>();auto scratch=sb.Get<float>();
    auto sparse=slots.Get<float>();auto ix=indices.Get<int32_t>();
    AscendC::CreateVecIndex(ix,int32_t(0),p.chunk);AscendC::PipeBarrier<PIPE_V>();
    AscendC::Muls(ix,ix,int32_t(8*sizeof(float)),p.chunk);AscendC::PipeBarrier<PIPE_V>();
    auto uix=ix.template ReinterpretCast<uint32_t>();
    AscendC::GlobalTensor<T> gv,gb;AscendC::GlobalTensor<float> gp,gy;
    gv.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(SUM_ROWS?b:a),int64_t(p.B)*p.K);
    gb.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(SUM_ROWS?a:b),int64_t(p.B)*p.L*p.K);
    gp.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial),p.direct?0:int64_t(p.B)*p.padded);
    gy.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y),p.B);
    const int32_t worker=AscendC::GetBlockIdx();int32_t lastBatch=-1;
    for(int32_t task=worker;task<p.B*p.chunks;task+=p.workers){
        const int32_t batch=task/p.chunks,l0=(task%p.chunks)*p.chunk;
        const int32_t live=MinI(p.chunk,p.L-l0);
        auto in=iq.AllocTensor<T>();
        AscendC::DataCopyPadExtParams<T> pad{true,0,static_cast<uint8_t>(p.kp-p.K),T(0)};
        AscendC::DataCopyExtParams cp{1,uint32_t(p.K*sizeof(T)),0,0,0};
        if(batch!=lastBatch)AscendC::DataCopyPad(in,gv[int64_t(batch)*p.K],cp,pad);
        cp.blockCount=static_cast<uint16_t>(live);
        AscendC::DataCopyPad(in[p.kp],gb[(int64_t(batch)*p.L+l0)*p.K],cp,pad);
        iq.EnQue(in);in=iq.DeQue<T>();
        if(batch!=lastBatch){AscendC::Cast(vec,in,AscendC::RoundMode::CAST_NONE,p.kp);lastBatch=batch;}
        AscendC::Cast(bank,in[p.kp],AscendC::RoundMode::CAST_NONE,live*p.kp);
        AscendC::PipeBarrier<PIPE_V>();
        for(int32_t r=0;r<live;++r){
            AscendC::Mul(bank[r*p.kp],bank[r*p.kp],vec,p.K);AscendC::PipeBarrier<PIPE_V>();
            AscendC::ReduceSum(sparse[r*8],bank[r*p.kp],scratch,p.K);
            AscendC::PipeBarrier<PIPE_V>();
        }
        auto dots=dq.AllocTensor<float>();AscendC::Gather(dots,sparse,uix,0,live);
        AscendC::PipeBarrier<PIPE_V>();
        if(p.direct){
            auto out=oq.AllocTensor<float>();
            if constexpr(SUM_ROWS)AscendC::ReduceSum(out,dots,scratch,live);
            else AscendC::WholeReduceMax(out,dots,live,1,1,1,8,AscendC::ReduceOrder::ORDER_ONLY_VALUE);
            oq.EnQue(out);out=oq.DeQue<float>();
            AscendC::DataCopyExtParams ocp{1,sizeof(float),0,0,0};
            AscendC::DataCopyPad(gy[batch],out,ocp);oq.FreeTensor(out);
            AscendC::PipeBarrier<PIPE_V>();
        }else{
            dq.EnQue(dots);dots=dq.DeQue<float>();
            AscendC::DataCopyExtParams ocp{1,uint32_t(live*sizeof(float)),0,0,0};
            AscendC::DataCopyPad(gp[int64_t(batch)*p.padded+l0],dots,ocp);
        }
        dq.FreeTensor(dots);iq.FreeTensor(in);
    }
    if(p.direct)return;
    Fence<AscendC::HardEvent::MTE3_MTE2>(pipe);AscendC::SyncAll<true>();
    for(int32_t batch=worker;batch<p.B;batch+=p.workers){
        AscendC::DataCopyExtParams cp{1,uint32_t(p.L*sizeof(float)),0,0,0};
        AscendC::DataCopyPadExtParams<float> np{false,0,0,0.0f};
        AscendC::DataCopyPad(bank,gp[int64_t(batch)*p.padded],cp,np);
        Fence<AscendC::HardEvent::MTE2_V>(pipe);
        auto out=oq.AllocTensor<float>();
        if constexpr(SUM_ROWS)AscendC::ReduceSum(out,bank,scratch,p.L);
        else FinishMax(out,bank,scratch,p.L);
        oq.EnQue(out);out=oq.DeQue<float>();
        AscendC::DataCopyExtParams ocp{1,sizeof(float),0,0,0};
        AscendC::DataCopyPad(gy[batch],out,ocp);oq.FreeTensor(out);
        Fence<AscendC::HardEvent::V_MTE2>(pipe);
    }
}


// BMMS71_ROUTE_BEGIN
static inline int32_t Up(int32_t x,int32_t y){return (x+y-1)/y;}
static inline int32_t MinH(int32_t a,int32_t b){return a<b?a:b;}
static inline int32_t Pow2Up(int32_t x,int32_t limit){int32_t r=16;while(r<x&&r<limit)r*=2;return r;}
static inline bool UseTiny(int32_t M,int32_t N,int32_t K){return int64_t(M)*N<=16&&K<=1024&&int64_t(M)*N*K<=8192;}
static inline bool UseResident(int32_t M,int32_t N,int32_t K){
    return M<=32&&N<=64&&K<=128&&int64_t(M)*N<=256&&int64_t(M)*N*K<=16384&&int64_t(M+N)*K<=8192;
}
static inline bool UseSkinny(int32_t M,int32_t N,bool ta,bool tb){
    return (N==1&&!ta)||(M==1&&tb);
}
static inline SkinnyPlan MakeSkinny(int32_t B,int32_t L,int32_t K,int32_t cores){
    SkinnyPlan p{};p.B=B;p.L=L;p.K=K;p.kp=Up(K,16)*16;
    p.chunk=MinH(16,8192/p.kp);p.chunks=Up(L,p.chunk);
    p.padded=Up(L,16)*16;p.workers=MinH(cores*2,B*p.chunks);p.direct=p.chunks==1;return p;
}

enum class Family : int32_t { Dot=0, Tiny=1, Resident=2, Skinny=3, Generic43=4 };
static inline Family SelectFamily(int32_t M,int32_t N,int32_t K,bool ta,bool tb)
{
    if (M==1 && N==1) return Family::Dot;
    if (UseTiny(M,N,K)) return Family::Tiny;
    if (UseResident(M,N,K)) return Family::Resident;
    if (UseSkinny(M,N,ta,tb)) return Family::Skinny;
    return Family::Generic43;
}
// BMMS71_ROUTE_END
} // namespace bmms71
// BMMS71_VECTOR_MODULE_END

#define BMMS71_RES_ENTRY(NAME,T,TA,TB) \
__global__ __vector__ void NAME(GM_ADDR a,GM_ADDR b,GM_ADDR y, \
    int32_t B,int32_t M,int32_t N,int32_t K,int32_t kp,int32_t w) \
{bmms71::ResidentDevice<T,TA,TB>(a,b,y,B,M,N,K,kp,w);}
BMMS71_RES_ENTRY(bmms71_res_f16_nn,half,false,false)
BMMS71_RES_ENTRY(bmms71_res_f16_tn,half,true,false)
BMMS71_RES_ENTRY(bmms71_res_f16_nt,half,false,true)
BMMS71_RES_ENTRY(bmms71_res_f16_tt,half,true,true)
BMMS71_RES_ENTRY(bmms71_res_b16_nn,bfloat16_t,false,false)
BMMS71_RES_ENTRY(bmms71_res_b16_tn,bfloat16_t,true,false)
BMMS71_RES_ENTRY(bmms71_res_b16_nt,bfloat16_t,false,true)
BMMS71_RES_ENTRY(bmms71_res_b16_tt,bfloat16_t,true,true)
#undef BMMS71_RES_ENTRY

// MIX(0,1), not a pure VECTOR entry: Skinny may use an all-AIV barrier.
#define BMMS71_SK_ENTRY(NAME,T,SUM) \
__schedmode__(1) __global__ __mix__(0,1) void NAME( \
    GM_ADDR a,GM_ADDR b,GM_ADDR y,GM_ADDR partial,bmms71::SkinnyPlan p) \
{bmms71::SkinnyDevice<T,SUM>(a,b,y,partial,p);}
BMMS71_SK_ENTRY(bmms71_sum_f16,half,true)
BMMS71_SK_ENTRY(bmms71_max_f16,half,false)
BMMS71_SK_ENTRY(bmms71_sum_b16,bfloat16_t,true)
BMMS71_SK_ENTRY(bmms71_max_b16,bfloat16_t,false)
#undef BMMS71_SK_ENTRY


// ============================================================================
// BatchMatmulMaxSum V8.0 PHASE-1
// Shape/layout-aware portfolio on top of V7.1.
//
// Implemented in this phase:
//   * Explicit input-family classifier (math shape + physical layout + K bucket).
//   * Preserve V4.3 Dot/Tiny + V7 Resident/continuous-Skinny arithmetic.
//   * Small-K (K=32/64/128) family-specific Matmul plans for Short-M,
//     Short-N and dense shapes, with K-specific logical shapes and supported M/N tiling requests.
//   * [K,L] degenerate matrices use an L-lane FP32 GEMV for K<=256;
//     [L,K] degenerate matrices keep the measured V7 continuous-bank kernel.
//   * Every static family path has an in-call fallback to the V7.1/V4.3 generic
//     dispatcher if the target CANN 9.0 tiler rejects the requested split.
//
// Not yet enabled here:
//   * low-level LoadData/Mmad/Fixpipe dense kernel;
//   * Split-K; NZ-native epilogue.
// Those require a separate target-device compile/profile gate before replacing
// a known-correct arithmetic path.
// ============================================================================
namespace bmms8 {

enum class Layout : int32_t { NN=0, NT=1, TN=2, TT=3 };
enum class KClass : int32_t { K32=0, K64=1, K128=2, OtherSmall=3, Mid=4, Large=5 };
enum class Family : int32_t {
    Dot=0,
    Tiny=1,
    Resident=2,
    M1_KContig=3,
    M1_NContig=4,
    N1_KContig=5,
    N1_MContig=6,
    ShortM_SmallK=7,
    ShortN_SmallK=8,
    Dense_SmallK=9,
    SmallOutput_LargeK=10,
    Dense_MidK=11,
    Dense_LargeK=12,
    Generic=13
};

static inline int32_t MinH(int32_t a,int32_t b){return a<b?a:b;}
static inline int32_t Up(int32_t x,int32_t y){return (x+y-1)/y;}
static inline int32_t Pow2Up16(int32_t x,int32_t cap){int32_t r=16;while(r<x&&r<cap)r<<=1;return r;}

// Device code must not call the host-only Up/MinH helpers above.
__aicore__ inline int32_t MinI(int32_t a,int32_t b){return a<b?a:b;}
__aicore__ inline int32_t CeilDivI(int32_t x,int32_t y){return (x+y-1)/y;}


static inline Layout GetLayout(bool ta,bool tb){
    if(!ta&&!tb) return Layout::NN;
    if(!ta&&tb) return Layout::NT;
    if(ta&&!tb) return Layout::TN;
    return Layout::TT;
}
static inline KClass GetKClass(int32_t K){
    if(K==32)return KClass::K32;
    if(K==64)return KClass::K64;
    if(K==128)return KClass::K128;
    if(K<=256)return KClass::OtherSmall;
    if(K<=1024)return KClass::Mid;
    return KClass::Large;
}
static inline bool IsFixedSmallK(int32_t K){return K==32||K==64||K==128;}

static inline Family Classify(int32_t B,int32_t M,int32_t N,int32_t K,bool ta,bool tb){
    (void)B;
    if(M==1&&N==1)return Family::Dot;
    if(bmmmaxsum_v43::UseTiny(M,N,K))return Family::Tiny;
    if(bmms71::UseResident(M,N,K))return Family::Resident;

    // Degenerate matrices are split by *physical* contiguous direction.
    if(M==1){
        return tb ? Family::M1_KContig : Family::M1_NContig;
    }
    if(N==1){
        return !ta ? Family::N1_KContig : Family::N1_MContig;
    }

    if(IsFixedSmallK(K)){
        if(M<=32&&N>32)return Family::ShortM_SmallK;
        if(N<=32&&M>32)return Family::ShortN_SmallK;
        return Family::Dense_SmallK;
    }
    if(int64_t(M)*N<=4096&&K>=2048)return Family::SmallOutput_LargeK;
    if(K<=1024)return Family::Dense_MidK;
    if(K>1024)return Family::Dense_LargeK;
    return Family::Generic;
}

// ---------------- Small-K family planners -----------------------------------
// These are deliberately structural, not fitted microsecond models.
// Short-M spends the core budget mainly on N; Short-N mainly on M. Dense uses
// the fullest per-batch pM*pN grid and breaks ties by estimated duplicated input
// elements M*pN + N*pM.
static inline int32_t BudgetPerBatch(int32_t B,int32_t cores){
    if(B>=cores)return 1;
    const int32_t q=cores/B;
    return q>0?q:1;
}

static inline bmmmaxsum_v43::Plan MakeShortMPlan(
    int32_t B,int32_t M,int32_t N,int32_t K,int32_t cores)
{
    const int32_t tm=M<=16?16:32;
    int32_t vn=K<=64?256:128;
    while(vn>16 && (N<=vn/2 || vn>Up(N,16)*16))vn>>=1;
    const int32_t nt=Up(N,vn);
    const int32_t budget=BudgetPerBatch(B,cores);
    int32_t pn=MinH(nt,budget);
    while(pn>1){
        auto q=bmmmaxsum_v43::BuildPlan(B,M,N,K,cores,tm,vn,1,pn);
        if(bmmmaxsum_v43::ValidPlan(q,cores))return q;
        --pn;
    }
    return bmmmaxsum_v43::BuildPlan(B,M,N,K,cores,tm,vn,1,1);
}

static inline bmmmaxsum_v43::Plan MakeShortNPlan(
    int32_t B,int32_t M,int32_t N,int32_t K,int32_t cores)
{
    int32_t vn=Pow2Up16(N,64); if(vn>64)vn=64;
    int32_t tm=K<=64?128:64;
    while(tm>16 && (M<=tm/2 || tm>Up(M,16)*16))tm>>=1;
    const int32_t mt=Up(M,tm);
    const int32_t budget=BudgetPerBatch(B,cores);
    int32_t pm=MinH(mt,budget);
    while(pm>1){
        auto q=bmmmaxsum_v43::BuildPlan(B,M,N,K,cores,tm,vn,pm,1);
        if(bmmmaxsum_v43::ValidPlan(q,cores))return q;
        --pm;
    }
    return bmmmaxsum_v43::BuildPlan(B,M,N,K,cores,tm,vn,1,1);
}

static inline bmmmaxsum_v43::Plan MakeDenseSmallKPlan(
    int32_t B,int32_t M,int32_t N,int32_t K,int32_t cores)
{
    int32_t tm=64;
    int32_t vn=128;
    while(tm>16 && (M<=tm/2 || tm>Up(M,16)*16))tm>>=1;
    while(vn>16 && (N<=vn/2 || vn>Up(N,16)*16))vn>>=1;
    const int32_t mt=Up(M,tm), nt=Up(N,vn);
    const int32_t budget=BudgetPerBatch(B,cores);
    int32_t bestPM=1,bestPN=1,bestUsed=0;
    int64_t bestRead=(1LL<<62),bestWave=(1LL<<62);
    for(int32_t pm=1;pm<=MinH(mt,budget);++pm){
        for(int32_t pn=1;pn<=MinH(nt,budget/pm);++pn){
            auto q=bmmmaxsum_v43::BuildPlan(B,M,N,K,cores,tm,vn,pm,pn);
            if(!bmmmaxsum_v43::ValidPlan(q,cores))continue;
            const int32_t used=pm*pn;
            const int64_t read=int64_t(M)*pn+int64_t(N)*pm;
            const int64_t wave=int64_t(Up(mt,pm))*Up(nt,pn);
            if(used>bestUsed || (used==bestUsed && (read<bestRead ||
                (read==bestRead && wave<bestWave)))){
                bestUsed=used;bestRead=read;bestWave=wave;bestPM=pm;bestPN=pn;
            }
        }
    }
    if(bestUsed==0)return bmmmaxsum_v43::BuildPlan(B,M,N,K,cores,tm,vn,1,1);
    return bmmmaxsum_v43::BuildPlan(B,M,N,K,cores,tm,vn,bestPM,bestPN);
}

static inline bmmmaxsum_v43::Plan MakeFamilyPlan(
    Family f,int32_t B,int32_t M,int32_t N,int32_t K,int32_t cores)
{
    if(f==Family::ShortM_SmallK)return MakeShortMPlan(B,M,N,K,cores);
    if(f==Family::ShortN_SmallK)return MakeShortNPlan(B,M,N,K,cores);
    return MakeDenseSmallKPlan(B,M,N,K,cores);
}

static inline bool GetSmallKFastTiling(
    const bmmmaxsum_v43::Plan& p,int32_t dtype,bool ta,bool tb,TCubeTiling& td)
{
    if(!IsFixedSmallK(p.K)||p.blocks<=0||p.workers<=0)return false;
    matmul_tiling::MultiCoreMatmulTiling t;
    if(t.SetDim(p.workers)==-1)return false;
    const auto dt=dtype==2?matmul_tiling::DataType::DT_BFLOAT16:
                           matmul_tiling::DataType::DT_FLOAT16;
    t.SetAType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,dt,ta);
    t.SetBType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,dt,tb);
    t.SetCType(matmul_tiling::TPosition::VECIN,matmul_tiling::CubeFormat::ND,
        matmul_tiling::DataType::DT_FLOAT);
    const int32_t sm=MinH(p.mPitch,p.M),sn=p.nPitch;
    t.SetOrgShape(p.M,p.N,p.K);t.SetShape(sm,sn,p.K);
    if(t.SetSingleShape(sm,sn,p.K)==-1)return false;
    // Logical K is selected by the K32/K64/K128 family; it is NOT a request
    // to write the reserved baseK argument of SetFixSplit. Internal baseK is
    // chosen by the CANN tiler and full K remains the single-core dot extent.
    if(t.SetFixSplit(p.tileM,p.vecN,-1)==-1)return false;
    if(t.SetTraverse(matmul_tiling::MatrixTraverse::FIRSTN)==-1)return false;
    t.EnableBias(false);t.SetBufferSpace(-1,-1,64*1024);
    if(t.GetTiling(td)==-1)return false;
    return bmmmaxsum_v43::FlatFastStream(p,td) && td.usedCoreNum==1 &&
        td.baseM==p.tileM && td.baseN==p.vecN && td.baseK>0 &&
        td.singleCoreM>=sm && td.singleCoreN>=sn && td.singleCoreK>=p.K;
}

static inline bool GetSmallKSafeTiling(
    const bmmmaxsum_v43::Plan& p,int32_t dtype,bool ta,bool tb,TCubeTiling& td)
{
    if(!IsFixedSmallK(p.K))return false;
    matmul_tiling::MultiCoreMatmulTiling t;
    if(t.SetDim(p.workers)==-1)return false;
    const auto dt=dtype==2?matmul_tiling::DataType::DT_BFLOAT16:
                           matmul_tiling::DataType::DT_FLOAT16;
    t.SetAType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,dt,ta);
    t.SetBType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,dt,tb);
    t.SetCType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,
        matmul_tiling::DataType::DT_FLOAT);
    const int32_t sm=MinH(p.M,p.tileM),sn=MinH(p.N,p.nPitch);
    t.SetOrgShape(p.M,p.N,p.K);t.SetShape(sm,sn,p.K);
    if(t.SetSingleShape(sm,sn,p.K)==-1)return false;
    if(t.SetFixSplit(p.tileM,p.vecN,-1)==-1)return false;
    t.EnableBias(false);t.SetBufferSpace(-1,-1,64*1024);
    if(t.GetTiling(td)==-1)return false;
    return td.usedCoreNum==1 && td.baseM==p.tileM && td.baseN==p.vecN && td.baseK>0 &&
        td.singleCoreM>=sm && td.singleCoreN>=sn && td.singleCoreK>=p.K;
}

// Launch one family-specific small-K plan.  If either target tiling request is
// rejected, return false *before any device launch* so the proven V7.1/V4.3
// dispatcher can take over.
static inline bool TrySmallKFamily(
    Family family,GM_ADDR x1,const TensorGroupInfo& info_x1,
    GM_ADDR x2,const TensorGroupInfo& info_x2,GM_ADDR y,
    int32_t B,int32_t M,int32_t N,int32_t K,int32_t cores,
    aclrtStream stream,bool ta,bool tb)
{
    using namespace bmmmaxsum_v43;
    if(!(family==Family::ShortM_SmallK||family==Family::ShortN_SmallK||
         family==Family::Dense_SmallK))return false;
    const auto& a=info_x1.tensors[0];(void)info_x2;
    Plan p=MakeFamilyPlan(family,B,M,N,K,cores);
    if(!ValidPlan(p,cores))return false;

    TCubeTiling td{};
    bool fast=ValidFastPlan(p,cores)&&GetSmallKFastTiling(p,a.dtype,ta,tb,td);
    if(!fast){
        td=TCubeTiling{};
        if(!GetSmallKSafeTiling(p,a.dtype,ta,tb,td))return false;
    }

    const uint64_t partialBytes=PartialBytes(p);
    uint8_t* workspace=nullptr;
    uint64_t bytes=SYSTEM_WORKSPACE_BYTES+partialBytes+(fast?0ULL:TileBytes(p));
    if(aclrtMalloc(reinterpret_cast<void**>(&workspace),bytes,
        ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)return false;
    uint8_t* partials=workspace+SYSTEM_WORKSPACE_BYTES;

    if(fast){
#define BMMS8_FAST_LAUNCH(NAME) NAME<<<p.blocks,nullptr,stream>>>(x1,x2,y,partials,workspace,td,p)
        if(a.dtype==1){
            if(!ta&&!tb){BMMS8_FAST_LAUNCH(bmms43_fast_f16_nn);}else if(ta&&!tb){BMMS8_FAST_LAUNCH(bmms43_fast_f16_tn);}
            else if(!ta&&tb){BMMS8_FAST_LAUNCH(bmms43_fast_f16_nt);}else{BMMS8_FAST_LAUNCH(bmms43_fast_f16_tt);}
        }else{
            if(!ta&&!tb){BMMS8_FAST_LAUNCH(bmms43_fast_b16_nn);}else if(ta&&!tb){BMMS8_FAST_LAUNCH(bmms43_fast_b16_tn);}
            else if(!ta&&tb){BMMS8_FAST_LAUNCH(bmms43_fast_b16_nt);}else{BMMS8_FAST_LAUNCH(bmms43_fast_b16_tt);}
        }
#undef BMMS8_FAST_LAUNCH
    }else{
        uint8_t* tiles=partials+partialBytes;
#define BMMS8_SAFE_LAUNCH(NAME) NAME<<<p.blocks,nullptr,stream>>>(x1,x2,y,partials,tiles,workspace,td,p)
        if(a.dtype==1){
            if(!ta&&!tb){BMMS8_SAFE_LAUNCH(bmms43_safe_f16_nn);}else if(ta&&!tb){BMMS8_SAFE_LAUNCH(bmms43_safe_f16_tn);}
            else if(!ta&&tb){BMMS8_SAFE_LAUNCH(bmms43_safe_f16_nt);}else{BMMS8_SAFE_LAUNCH(bmms43_safe_f16_tt);}
        }else{
            if(!ta&&!tb){BMMS8_SAFE_LAUNCH(bmms43_safe_b16_nn);}else if(ta&&!tb){BMMS8_SAFE_LAUNCH(bmms43_safe_b16_tn);}
            else if(!ta&&tb){BMMS8_SAFE_LAUNCH(bmms43_safe_b16_nt);}else{BMMS8_SAFE_LAUNCH(bmms43_safe_b16_tt);}
        }
#undef BMMS8_SAFE_LAUNCH
    }
    if(aclrtSynchronizeStream(stream)!=ACL_SUCCESS)std::abort();
    if(aclrtFree(workspace)!=ACL_SUCCESS)std::abort();
    return true;
}



// ---------------- [K,L] lane-GEMV -------------------------------------------
// Used only for the two degenerate shapes whose bank is physically [K,L]:
//   M=1, TB=false -> B is [K,N], SIMD lanes are N;
//   N=1, TA=true  -> A is [K,M], SIMD lanes are M.
// Complete K accumulation happens in FP32 before Max/Sum.  This path is kept
// to K<=256 in V8.0; longer K stays on the generic Cube fallback until profiled.
struct LanePlan {
    int32_t B,L,K,chunk,kBlock,chunks,padded,workers,direct;
};
static inline LanePlan MakeLanePlan(int32_t B,int32_t L,int32_t K,int32_t cores){
    LanePlan p{};p.B=B;p.L=L;p.K=K;p.chunk=64;p.kBlock=16;
    if(L<64)p.chunk=Pow2Up16(L,64);
    p.chunks=Up(L,p.chunk);p.padded=Up(L,16)*16;
    p.workers=MinH(cores*2,B*p.chunks);p.direct=(p.chunks==1);return p;
}
static inline bool UseLaneSkinny(Family f,int32_t K){
    return (f==Family::M1_NContig||f==Family::N1_MContig)&&K<=256;
}

// TwoSum-style FP32 pair accumulation for the N=1 / Sum(M) Lane path.
// hi+lo retains the rounding residue; Max-only Lane keeps its original arithmetic.
__aicore__ inline void PairAccumulate(
    const AscendC::LocalTensor<float>& hi,const AscendC::LocalTensor<float>& lo,
    const AscendC::LocalTensor<float>& x,const AscendC::LocalTensor<float>& sum,
    const AscendC::LocalTensor<float>& bp,const AscendC::LocalTensor<float>& err,int32_t n){
    AscendC::Add(sum,hi,x,n);AscendC::PipeBarrier<PIPE_V>();
    AscendC::Sub(bp,sum,hi,n);AscendC::PipeBarrier<PIPE_V>();
    AscendC::Sub(err,sum,bp,n);AscendC::PipeBarrier<PIPE_V>();
    AscendC::Sub(err,hi,err,n);
    AscendC::Sub(bp,x,bp,n);AscendC::PipeBarrier<PIPE_V>();
    AscendC::Add(err,err,bp,n);AscendC::PipeBarrier<PIPE_V>();
    AscendC::Add(lo,lo,err,n);
    AscendC::Add(hi,hi,x,n);AscendC::PipeBarrier<PIPE_V>();
}

// Fixed, alignment-aware reduction of FP32 high/low pairs. Full K has already
// been evaluated for every row. Only the final round converts the pair to y.
__aicore__ inline void FinishPairSum(
    const AscendC::LocalTensor<float>& out,const AscendC::LocalTensor<float>& hi,
    const AscendC::LocalTensor<float>& lo,const AscendC::LocalTensor<float>& sum,
    const AscendC::LocalTensor<float>& bp,const AscendC::LocalTensor<float>& err,
    int32_t n,AscendC::TPipe& pipe){
    while(n>8){
        const int32_t split=CeilDivI(CeilDivI(n,2),8)*8;
        const int32_t pairs=n-split;
        PairAccumulate(hi,lo,hi[split],sum,bp,err,pairs);
        AscendC::Add(lo,lo,lo[split],pairs);AscendC::PipeBarrier<PIPE_V>();
        n=split;
    }
    bmms71::Fence<AscendC::HardEvent::V_S>(pipe);
    float h=0.0f,l=0.0f;
    for(int32_t i=0;i<n;++i){
        const float x=hi.GetValue(i),t=h+x,b=t-h;
        const float e=(h-(t-b))+(x-b);
        l=l+e; l=l+lo.GetValue(i); h=t;
    }
    out.SetValue(0,h+l);
    // The result was written by Scalar; the queue's normal V->MTE3 dependency
    // must not be used without connecting Scalar to Vector first.
    bmms71::Fence<AscendC::HardEvent::S_V>(pipe);
}

template<class T,bool SUM_ROWS>
__aicore__ inline void LaneSkinnyDevice(GM_ADDR a,GM_ADDR b,GM_ADDR y,
    GM_ADDR partial,const LanePlan& p){
    AscendC::TPipe pipe;
    const int32_t kPad=CeilDivI(p.K,16)*16;
    int32_t scratchCap=p.padded>kPad?p.padded:kPad;
    // FinishMax writes [0,136), including tmp[128]; even L=65 needs 136 floats.
    if(scratchCap<136)scratchCap=136;
    AscendC::TQue<AscendC::TPosition::VECIN,1> vq,bq;
    AscendC::TQue<AscendC::TPosition::VECOUT,1> oq;
    AscendC::TBuf<AscendC::TPosition::VECCALC> vecBuf,tileBuf,scratchBuf;
    AscendC::TBuf<AscendC::TPosition::VECOUT> accBuf;
    AscendC::TBuf<AscendC::TPosition::VECIN> finalBuf,finalLoBuf;
    AscendC::TBuf<AscendC::TPosition::VECOUT> loBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> pairB,pairE;
    pipe.InitBuffer(vq,1,kPad*sizeof(T));
    pipe.InitBuffer(bq,1,p.kBlock*p.chunk*sizeof(T));
    pipe.InitBuffer(oq,1,32);
    pipe.InitBuffer(vecBuf,kPad*sizeof(float));
    pipe.InitBuffer(tileBuf,p.kBlock*p.chunk*sizeof(float));
    pipe.InitBuffer(accBuf,p.chunk*sizeof(float));
    pipe.InitBuffer(finalBuf,p.padded*sizeof(float));
    pipe.InitBuffer(scratchBuf,scratchCap*sizeof(float));
    if constexpr(SUM_ROWS){
        const int32_t pairCap=p.padded/2>p.chunk?p.padded/2:p.chunk;
        pipe.InitBuffer(loBuf,p.chunk*sizeof(float));
        pipe.InitBuffer(finalLoBuf,p.padded*sizeof(float));
        pipe.InitBuffer(pairB,pairCap*sizeof(float));
        pipe.InitBuffer(pairE,pairCap*sizeof(float));
    }

    auto vec=vecBuf.Get<float>();auto tile=tileBuf.Get<float>();
    auto acc=accBuf.Get<float>();auto final=finalBuf.Get<float>();
    auto scratch=scratchBuf.Get<float>();
    AscendC::LocalTensor<float> lo,finalLo,tmpB,tmpE;
    if constexpr(SUM_ROWS){lo=loBuf.Get<float>();finalLo=finalLoBuf.Get<float>();
        tmpB=pairB.Get<float>();tmpE=pairE.Get<float>();}
    constexpr int32_t planes=SUM_ROWS?2:1;
    AscendC::GlobalTensor<T> gv,gb;AscendC::GlobalTensor<float> gp,gy;
    gv.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(SUM_ROWS?b:a),int64_t(p.B)*p.K);
    gb.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(SUM_ROWS?a:b),int64_t(p.B)*p.K*p.L);
    gp.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partial),p.direct?0:int64_t(p.B)*planes*p.padded);
    gy.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y),p.B);

    const int32_t worker=AscendC::GetBlockIdx();int32_t lastBatch=-1;
    for(int32_t task=worker;task<p.B*p.chunks;task+=p.workers){
        const int32_t batch=task/p.chunks,l0=(task%p.chunks)*p.chunk;
        const int32_t live=MinI(p.chunk,p.L-l0);
        // GM rows have p.L elements. DataCopyPad's UB rows are 32-byte aligned.
        // T is FP16/BF16, so the UB pitch rounds live up to 16 elements.
        const int32_t bankPitch=CeilDivI(live,16)*16;
        if(batch!=lastBatch){
            auto vin=vq.AllocTensor<T>();
            AscendC::DataCopyExtParams cp{1,uint32_t(p.K*sizeof(T)),0,0,0};
            AscendC::DataCopyPadExtParams<T> pd{false,0,0,T(0)};
            AscendC::DataCopyPad(vin,gv[int64_t(batch)*p.K],cp,pd);
            vq.EnQue(vin);vin=vq.DeQue<T>();
            AscendC::Cast(vec,vin,AscendC::RoundMode::CAST_NONE,p.K);
            // GetValue below is a Scalar consumer of the Vector Cast.
            bmms71::Fence<AscendC::HardEvent::V_S>(pipe);
            vq.FreeTensor(vin);lastBatch=batch;
        }
        AscendC::Duplicate(acc,0.0f,live);
        if constexpr(SUM_ROWS)AscendC::Duplicate(lo,0.0f,live);
        AscendC::PipeBarrier<PIPE_V>();
        for(int32_t k0=0;k0<p.K;k0+=p.kBlock){
            const int32_t liveK=MinI(p.kBlock,p.K-k0);
            auto bin=bq.AllocTensor<T>();
            AscendC::DataCopyExtParams cp{static_cast<uint16_t>(liveK),
                uint32_t(live*sizeof(T)),uint32_t((p.L-live)*sizeof(T)),0,0};
            AscendC::DataCopyPadExtParams<T> pd{
                true,0,static_cast<uint8_t>(bankPitch-live),T(0)};
            const int64_t bo=(int64_t(batch)*p.K+k0)*p.L+l0;
            AscendC::DataCopyPad(bin,gb[bo],cp,pd);
            bq.EnQue(bin);bin=bq.DeQue<T>();
            AscendC::Cast(tile,bin,AscendC::RoundMode::CAST_NONE,liveK*bankPitch);
            AscendC::PipeBarrier<PIPE_V>();
            for(int32_t kk=0;kk<liveK;++kk){
                const float x=vec.GetValue(k0+kk);
                AscendC::Muls(tile[kk*bankPitch],tile[kk*bankPitch],x,live);
                AscendC::PipeBarrier<PIPE_V>();
                if constexpr(SUM_ROWS)PairAccumulate(acc,lo,tile[kk*bankPitch],scratch,tmpB,tmpE,live);
                else AscendC::Add(acc,acc,tile[kk*bankPitch],live);
                AscendC::PipeBarrier<PIPE_V>();
            }
            bq.FreeTensor(bin);
        }
        if(p.direct){
            auto out=oq.AllocTensor<float>();
            if constexpr(SUM_ROWS)FinishPairSum(out,acc,lo,scratch,tmpB,tmpE,live,pipe);
            else AscendC::WholeReduceMax(out,acc,live,1,1,1,8,
                AscendC::ReduceOrder::ORDER_ONLY_VALUE);
            oq.EnQue(out);out=oq.DeQue<float>();
            AscendC::DataCopyExtParams ocp{1,sizeof(float),0,0,0};
            AscendC::DataCopyPad(gy[batch],out,ocp);oq.FreeTensor(out);
        }else{
            AscendC::DataCopyExtParams ocp{1,uint32_t(live*sizeof(float)),0,0,0};
            // acc is not queue-owned: explicitly order its publish and next overwrite.
            bmms71::Fence<AscendC::HardEvent::V_MTE3>(pipe);
            const int64_t dst=int64_t(batch)*planes*p.padded+l0;
            AscendC::DataCopyPad(gp[dst],acc,ocp);
            if constexpr(SUM_ROWS)AscendC::DataCopyPad(gp[dst+p.padded],lo,ocp);
            bmms71::Fence<AscendC::HardEvent::MTE3_V>(pipe);
        }
    }
    if(p.direct)return;
    // Publish all dot products before the deterministic final Max/Sum.
    bmms71::Fence<AscendC::HardEvent::MTE3_MTE2>(pipe);AscendC::SyncAll<true>();
    for(int32_t batch=worker;batch<p.B;batch+=p.workers){
        AscendC::DataCopyExtParams cp{1,uint32_t(p.L*sizeof(float)),0,0,0};
        AscendC::DataCopyPadExtParams<float> pd{false,0,0,0.0f};
        const int64_t src=int64_t(batch)*planes*p.padded;
        AscendC::DataCopyPad(final,gp[src],cp,pd);
        if constexpr(SUM_ROWS)AscendC::DataCopyPad(finalLo,gp[src+p.padded],cp,pd);
        bmms71::Fence<AscendC::HardEvent::MTE2_V>(pipe);
        auto out=oq.AllocTensor<float>();
        if constexpr(SUM_ROWS)FinishPairSum(out,final,finalLo,scratch,tmpB,tmpE,p.L,pipe);
        else bmms71::FinishMax(out,final,scratch,p.L);
        oq.EnQue(out);out=oq.DeQue<float>();
        AscendC::DataCopyExtParams ocp{1,sizeof(float),0,0,0};
        AscendC::DataCopyPad(gy[batch],out,ocp);oq.FreeTensor(out);
        bmms71::Fence<AscendC::HardEvent::V_MTE2>(pipe);
    }
}

} // namespace bmms8

#define BMMS8_LANE_ENTRY(NAME,T,SUM) \
__schedmode__(1) __global__ __mix__(0,1) void NAME(GM_ADDR a,GM_ADDR b,GM_ADDR y, \
    GM_ADDR partial,bmms8::LanePlan p){bmms8::LaneSkinnyDevice<T,SUM>(a,b,y,partial,p);}
BMMS8_LANE_ENTRY(bmms8_lane_sum_f16,half,true)
BMMS8_LANE_ENTRY(bmms8_lane_max_f16,half,false)
BMMS8_LANE_ENTRY(bmms8_lane_sum_b16,bfloat16_t,true)
BMMS8_LANE_ENTRY(bmms8_lane_max_b16,bfloat16_t,false)
#undef BMMS8_LANE_ENTRY

extern "C" void run_kernel(GM_ADDR x1,const TensorGroupInfo& info_x1,
    GM_ADDR x2,const TensorGroupInfo& info_x2,GM_ADDR y,const TensorGroupInfo& info_y,
    int64_t availableCoreNum,aclrtStream stream,bool transposeX1,bool transposeX2)
{
    using namespace bmms8;
    if(info_x1.numTensors!=1||info_x2.numTensors!=1||info_y.numTensors!=1)std::abort();
    const auto& a=info_x1.tensors[0];const auto& b=info_x2.tensors[0];const auto& o=info_y.tensors[0];
    if(a.numDims!=3||b.numDims!=3||o.numDims!=1||(a.dtype!=1&&a.dtype!=2)||a.dtype!=b.dtype||o.dtype!=0)std::abort();
    const int64_t B=a.shape[0],M=a.shape[transposeX1?2:1],K=a.shape[transposeX1?1:2],N=b.shape[transposeX2?1:2];
    if(B<1||B>64||M<1||M>8192||N<1||N>8192||K<32||K>8192||K%8||b.shape[0]!=B||
       b.shape[transposeX2?2:1]!=K||o.shape[0]!=B||B*M*K>(1LL<<26)||B*N*K>(1LL<<26))std::abort();
    const int32_t cores=availableCoreNum>0&&availableCoreNum<=64?int32_t(availableCoreNum):1;
    const Family family=Classify(int32_t(B),int32_t(M),int32_t(N),int32_t(K),transposeX1,transposeX2);

    // Keep the two inherited V7 vector families unchanged (V7.1 as a whole is not device-certified).
    if(family==Family::Resident){
        const int32_t w=bmms71::MinH(int32_t(B),2*cores),kp=bmms71::Pow2Up(int32_t(K),128);
#define BMMS8_RES(NAME) NAME<<<w,nullptr,stream>>>(x1,x2,y,B,M,N,K,kp,w)
        if(a.dtype==1){
            if(!transposeX1&&!transposeX2){BMMS8_RES(bmms71_res_f16_nn);}else if(transposeX1&&!transposeX2){BMMS8_RES(bmms71_res_f16_tn);}
            else if(!transposeX1&&transposeX2){BMMS8_RES(bmms71_res_f16_nt);}else{BMMS8_RES(bmms71_res_f16_tt);}
        }else{
            if(!transposeX1&&!transposeX2){BMMS8_RES(bmms71_res_b16_nn);}else if(transposeX1&&!transposeX2){BMMS8_RES(bmms71_res_b16_tn);}
            else if(!transposeX1&&transposeX2){BMMS8_RES(bmms71_res_b16_nt);}else{BMMS8_RES(bmms71_res_b16_tt);}
        }
#undef BMMS8_RES
        return;
    }

    // Continuous [L,K] skinny banks keep the V7 implementation. The opposite
    // [K,L] layouts use Lane-GEMV in its unchanged K<=256 domain below.
    if(family==Family::M1_KContig||family==Family::N1_KContig){
        bmms71::SkinnyPlan p=bmms71::MakeSkinny(int32_t(B),int32_t(N==1?M:N),int32_t(K),cores);
        uint8_t* partial=nullptr;
        if(!p.direct&&aclrtMalloc(reinterpret_cast<void**>(&partial),uint64_t(B)*p.padded*4,
            ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)std::abort();
#define BMMS8_SK(NAME) NAME<<<p.workers,nullptr,stream>>>(x1,x2,y,partial,p)
        if(a.dtype==1){if(N==1){BMMS8_SK(bmms71_sum_f16);}else{BMMS8_SK(bmms71_max_f16);}}
        else{if(N==1){BMMS8_SK(bmms71_sum_b16);}else{BMMS8_SK(bmms71_max_b16);}}
#undef BMMS8_SK
        if(!p.direct){if(aclrtSynchronizeStream(stream)!=ACL_SUCCESS)std::abort();if(aclrtFree(partial)!=ACL_SUCCESS)std::abort();}
        return;
    }

    // The opposite skinny layouts are [K,L].  For K<=256 V8 uses an
    // L-lane FP32 accumulator so GM reads remain contiguous in L.  Longer K
    // keeps the generic Cube fallback until profiling justifies the scalar K loop.
    if(UseLaneSkinny(family,int32_t(K))){
        LanePlan p=MakeLanePlan(int32_t(B),int32_t(N==1?M:N),int32_t(K),cores);
        uint8_t* partial=nullptr;
        if(!p.direct&&aclrtMalloc(reinterpret_cast<void**>(&partial),uint64_t(B)*p.padded*4*(N==1?2ULL:1ULL),
            ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)std::abort();
#define BMMS8_LANE_LAUNCH(NAME) NAME<<<p.workers,nullptr,stream>>>(x1,x2,y,partial,p)
        if(a.dtype==1){if(N==1){BMMS8_LANE_LAUNCH(bmms8_lane_sum_f16);}else{BMMS8_LANE_LAUNCH(bmms8_lane_max_f16);}}
        else{if(N==1){BMMS8_LANE_LAUNCH(bmms8_lane_sum_b16);}else{BMMS8_LANE_LAUNCH(bmms8_lane_max_b16);}}
#undef BMMS8_LANE_LAUNCH
        if(!p.direct){if(aclrtSynchronizeStream(stream)!=ACL_SUCCESS)std::abort();if(aclrtFree(partial)!=ACL_SUCCESS)std::abort();}
        return;
    }

    // Dedicated small-K shape families.  Tiler rejection happens before launch;
    // only then do we fall back to the known V7.1 generic dispatcher.
    if(TrySmallKFamily(family,x1,info_x1,x2,info_x2,y,int32_t(B),int32_t(M),int32_t(N),int32_t(K),
        cores,stream,transposeX1,transposeX2))return;

    // Dot/Tiny, [K,L] skinny, mid/large-K dense and every unqualified shape use
    // the V7.1 generic portfolio.  This preserves a correctness escape hatch.
    bmms71_v43_dispatch(x1,info_x1,x2,info_x2,y,info_y,
        availableCoreNum,stream,transposeX1,transposeX2);
}
